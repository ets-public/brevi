{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brevi-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  // Files (from @cloudflare/sandbox) resolves Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "exports": {
    "Sandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  // What every program may do. The caller of the Worker cannot change these; edit them here.
  // ALLOW: read,write,net,native (comma-separated, empty = nothing). ALLOW_NET: hosts. LIMITS: brevi --limit.
  "vars": {
    "ALLOW": "",
    "ALLOW_NET": "",
    "LIMITS": "cpu=10,mem=512,time=20,output=256,file=16"
  }
  // And the token callers send: `wrangler secret put BREVI_TOKEN`.
}
