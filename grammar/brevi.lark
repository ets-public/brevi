// Brevi grammar for constrained decoding (Lark syntax; works with Lark, llguidance, Outlines, vLLM).
// It checks each line, not indentation: a line ending in `:` opens a block, and block depth is
// left to the compiler. Any program `brevi check` accepts should parse (tools/grammar_check.py tests this).
// Not covered: the bodies of `rust fn` and `py fn` (foreign code).
// grammar/brevi.gbnf (llama.cpp) is made from this file by tools/lark_to_gbnf.py.

start: _NL? (line _NL)* line?

?line: opener ":" simples?          // if/for/while/match/fn/type/enum/test headers, with an optional one-line body
     | opener block (_n "else" ("if" expr)? block)*   // brace blocks: fn f() { ... }, enum J { A, B(n: int) }
     | pattern "=>" block
     | pattern "=>" opener ":" simples?   // Str(s) => if s:
     | fn_sig "=" expr               // fn f(x: int) = x * 2
     | fn_sig "=" "match" expr ":"   // fn area(s: Shape) -> f64 = match s:
     | pattern ("=>" | ":") simple?  // match arm; with nothing after it the body is the block below
     | NAME ":" (type | STRING) ("=" expr)?     // field, or typed variable
     | postfix ":" type "=" expr     // self.names: list[str] = []
     | "use" STRING STRING*          // use "util.bv", use sha2 "0.10"
     | "use" NAME STRING*
     | "allow" NAME ("," NAME)*       // allow read, write, native
     | ("global" | "nonlocal") NAME ("," NAME)*   // Python scope: see BREVI.md
     | "import" module ("as" NAME)? ("," module ("as" NAME)?)*   // import sys, or a stock.bv next to the file
     | "from" module "import" NAME ("," NAME)*
     | "@" postfix                   // decorators such as @dataclass are skipped
     | simples

opener: fn_sig
      | "type" NAME
      | "enum" NAME
      | "test" STRING
      | "if" expr
      | "elif" expr
      | "else" ("if" expr)?
      | "for" for_target "in" expr
      | "while" expr
      | "match" expr
      | "class" NAME ("(" [expr ("," expr)*] ")")?   // Python error classes: class BadInput(Exception): pass
      | "try"
      | "except" (expr ("as" NAME)?)?
      | "finally"
      | targets ASSIGN (unary binop)* ("if" | "match") expr   // out = out + match n:
      | "return" (unary binop)* ("if" | "match") expr

fn_sig: ("rust" | "py")? ("fn" | "def") NAME "(" _n [param ("," _n param)* ","?] _n ")" ("->" (type | STRING))? "!"?
module: NAME ("." NAME)*         // lib.stock is lib/stock.bv
param: "mut"? NAME (":" type)? ("=" expr)?   // def scale(x, k=2)
     | "*" NAME (":" type)?                     // def total(*xs)

?type: "[" type "]"
     | "{" type ":" type "}"
     | "(" [type ("," type)*] ")"
     | NAME ("[" type ("," type)* "]")?   // list[str], dict[str, int], Optional[T]
     | type "|" type                     // int | None
     | "..."                             // tuple[int, ...]

simples: simple (";" simple)*      // Python's a = 1; b = 2

?simple: ("let" | "var") pattern (":" type)? "=" expr
       | "return" (expr ("," expr)*)?
       | "pass"
       | "yield" "from" expr           // generators collect what they yield in a list
       | "yield" (expr ("," expr)*)?
       | "del" postfix
       | "raise" (expr ("from" expr)?)?
       | "break"
       | "continue"
       | "assert" expr
       | targets ASSIGN expr ("," expr)* ("=" expr)*   // a = b = 0
       | inline_if
       | expr

targets: postfix ("," postfix)*
ASSIGN: "=" | "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "|=" | "&=" | "^=" | "<<=" | ">>="

inline_if: "if" expr ":" simples ("elif" expr ":" simples)* ("else" (inline_if | ":" simples))?
for_target: pattern ("," pattern)*

?expr: binary ("if" binary "else" expr)?
     | lambda
lambda: NAME "=>" expr
      | "(" [NAME ("," NAME)*] ")" "=>" expr
      | "lambda" [NAME ("," NAME)*] ":" expr

?binary: unary (binop _n unary)*
binop: "or" | "and" | "||" | "&&" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "~=" | "in" | "not" "in" | "is" | "is" "not"
     | ".." | "+" | "-" | "*" | "/" | "%" | "//" | "|" | "&" | "^" | "<<" | ">>" | "**"
?unary: ("-" | "!" | "not") unary
      | postfix

?postfix: primary trailer*
trailer: _NL? "." (NAME | INT | "or") call?
       | "[" _n slice _n "]"
       | "?"
       | call                        // ops[0](3, 4)
slice: expr | expr? ":" expr? (":" expr?)?   // xs[a:b], xs[::-1]

call: "(" _n [arg ("," _n arg)* ","?] _n ")"
arg: (NAME ("=" | ":"))? "*"? expr comp?
comp: ("for" comp_target "in" binary ("if" binary)?)+
comp_target: comp_name ("," comp_name)*
comp_name: NAME | "(" comp_name ("," comp_name)* ","? ")"

?primary: INT | FLOAT | STRING
        | "true" | "false"
        | NAME call?
        | "(" _n [expr ("," _n expr)* ","?] _n ")"
        | "(" _n expr comp _n ")"           // (x * x for x in xs)
        | "[" _n [item ("," _n item)* ","?] _n "]"
        | "[" _n "*"? expr comp _n "]"
        | "{" _sep* "}"
        | "{" _sep* pair (_sep+ pair)* _sep* "}"
        | "{" _n (pair | expr) comp _n "}"   // {k: v for k in ks}, {w for w in ws}
        | "{" _n expr ("," _n expr)* ","? _n "}"   // Python set {a, b}
        | "(" _n "match" expr ":" _n (pattern "=>" expr ","? _n)+ ")"
        | inline_if
        | brace_if
        | "match" expr block
item: "*"? expr
pair: expr ":" expr

?pattern: NAME
        | NAME "(" [pattern ("," pattern)*] ")"
        | "-"? INT
        | STRING
        | "true" | "false"
        | "(" [pattern ("," pattern)*] ")"

block: "{" _sep* "}"
     | "{" _sep* line (_sep+ line)* _sep* "}"
brace_if: "if" expr block (_n "else" (brace_if | block))?

_n: _NL*
_sep: "," | _NL

NAME: /[A-Za-z_][A-Za-z0-9_]*/
INT: /0[xX][0-9a-fA-F_]+/ | /0[oO][0-7_]+/ | /0[bB][01_]+/ | /[0-9][0-9_]*/
FLOAT: /[0-9][0-9_]*\.[0-9]+([eE][+-]?[0-9]+)?/ | /[0-9][0-9_]*[eE][+-]?[0-9]+/
STRING: /[rR]?"""([^"\\]|\\.|"(?!""))*"""/ | /[rR]?'''([^'\\]|\\.|'(?!''))*'''/ | /[rR]"[^"\n]*"/ | /[rR]'[^'\n]*'/ | /[fF]?"([^"\\\n{]|\\.|\{[^}"\n]*("[^"\n]*"[^}"\n]*)*\}|\{)*"/ | /[fF]?'([^'\\\n{]|\\.|\{[^}'\n]*('[^'\n]*'[^}'\n]*)*\}|\{)*'/

// A newline, with any blank or comment-only lines after it.
_NL: /(\r?\n[\t ]*((#|\/\/)[^\n]*)?)+/
COMMENT: /#[^\n]*/ | /\/\/[^\n]*/
%ignore COMMENT
%ignore /[\t \f]+/
