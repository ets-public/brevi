{
  "name": "brevi",
  "version": "0.27.0",
  "description": "Compiles the plain Python AI agents write into fast native binaries via Rust, with one-line JSON errors and an MCP server.",
  "keywords": [
    "python",
    "compiler",
    "rust",
    "mcp",
    "ai-agents",
    "llm",
    "native",
    "brevi"
  ],
  "homepage": "https://brevi-lang.org",
  "bugs": {
    "url": "https://github.com/ets-public/brevi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ets-public/brevi.git"
  },
  "license": "Apache-2.0",
  "main": "lib/sdk.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./lib/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "brevi": "bin/brevi.js"
  },
  "files": [
    "bin",
    "lib",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.ets-public/brevi"
}
