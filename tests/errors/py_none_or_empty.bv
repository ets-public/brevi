# A parameter that may be None is tested again after it was set to an empty list: Brevi keeps None in a
# list name as an empty list, so the test cannot be answered and the program is refused.
def collect(xs, acc=None):
    for x in xs:
        if acc is None:
            acc = []
        if x > 0:
            acc.append(x)
    return acc

print(collect([-1, 2]))
