# A helper returns a filtered copy of a global list, and an item of that copy is changed: refused, since
# Python would change the shared item and Brevi would change a copy.
tasks = [["a", False], ["b", True], ["c", False]]
hide = True


def visible_tasks():
    if hide:
        return [t for t in tasks if not t[1]]
    return list(tasks)


def toggle(index):
    vis = visible_tasks()
    vis[index][1] = not vis[index][1]


toggle(1)
print(tasks)
