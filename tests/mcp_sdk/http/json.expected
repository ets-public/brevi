status 200
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":"7","result":{}}
== no session
status 400
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Bad Request: Missing session ID"}}
== unknown session
status 404
content-type: application/json
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Session not found"}}
== accept json only
status 200
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":8,"result":{}}
== accept none
status 406
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Not Acceptable: Client must accept application/json"}}
== text/plain body
status 400
| Invalid Content-Type header
== jsonx
status 415
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Unsupported Media Type: Content-Type must be application/json"}}
== parse error
status 400
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"Parse error: key must be a string at line 1 column 2"}}
== not json-rpc
status 400
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32602,"message":"Validation error: ..."}}
== evil host
status 421
| Invalid Host header
== evil origin
status 403
| Invalid Origin header
== local origin
status 200
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":9,"result":{}}
== PUT
status 405
content-type: application/json
allow: GET, POST, DELETE
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Method Not Allowed"}}
== other path
status 404
content-type: text/plain; charset=utf-8
| Not Found
== trailing slash
status 307
location: http://127.0.0.1:<port>/mcp
== too large
status 413
| Request body too large
== GET no sse
status 406
content-type: application/json
mcp-session-id: <sid>
| {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Not Acceptable: Client must accept text/event-stream"}}
== GET no session
status 400
content-type: application/json
mcp-session-id: <sid>
