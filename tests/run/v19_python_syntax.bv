# Plain Python, unchanged: the forms Brevi accepts as Python writes them.
import sys
from collections import defaultdict


class BadInput(Exception):
    pass


def parse(s):
    if s == "":
        raise BadInput("empty")
    return int(s)


def safe(s):
    try:
        v = parse(s)
    except (BadInput, ValueError) as e:
        print("bad:", e)
        v = -1
    else:
        print("ok", v)
    finally:
        print("done")
    return v


def outer(xs):
    k = 3
    total = 0

    def scale(v):
        return v * k

    def add(a, b):
        return a + b

    for x in xs:
        total = add(total, scale(x))
    return total, len(xs)


def mins(s):
    h, m = s.split(':'); return int(h) * 60 + int(m)


def main():
    print(safe("5"), safe(""), safe("q"))
    t, n = outer([1, 2, 3])
    print(t, n)
    jobs = {"a": [1, 2], "b": [3]}
    indeg = {j: len(jobs[j]) for j in jobs}
    print(indeg["a"], indeg["b"], [j for j in jobs if j != "a"])
    c = {}
    k = "x"
    if k in c: c[k] = 1; print("in")
    else: c[k] = 2; print("new")
    x = 5
    x |= 8
    x <<= 2
    x >>= 1
    x ^= 1
    x //= 3
    x %= 5
    print(x, 1 << 4, 6 ^ 3, 5 & 3 | 8)
    a = b = 0
    a += 1
    print(a, b, mins("1:30"))
    o = [3, 1, 2]
    print(*o)
    print("n:", *[v * 2 for v in o], sep=",")
    print(r'\d+{x}', {1, 2} | {2, 3})
    if o is not None and o is o:
        pass
    m = []
    for s in [1, 2, 5]:
        if m and s <= m[-1][1] + 1: m[-1][1] = max(m[-1][1], s)
        else: m.append([s, s])
    print(m)


if __name__ == "__main__":
    main()
