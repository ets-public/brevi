s = "a **bold** and *em* and `code` [x](http://y)"
s = s.re_sub("\\*\\*(.+?)\\*\\*", "<strong>\\1</strong>")
s = s.re_sub("\\*(.+?)\\*", "<em>\\1</em>")
s = s.re_sub("\\[([^\\]]*)\\]\\(([^)]*)\\)", "<a href=\"\\2\">\\1</a>")
print(s)
m = "GET /accounts/12/deposit".re_full("(\\w+) /accounts/(\\d+)/(deposit|withdraw)")
print(m)
print("1.2.3 x".re_find("\\d+(\\.\\d+)*"))
print("a1b22c333".re_all("[a-z](\\d+)").map(g => g[1]))
print("a, b,c".re_split(",\\s*"))
print("Hello World".re_sub("o", g => g[0].upper()))
print("10.0.0.1 - - [x]".re_full("^(\\S+) - - \\[(.*)\\]$"))
print("abc".re_full("x").len())
print("a1".re_find("\d"))
print("x\.y \[ \(")
print("2024-01-05".re_full("(\d{4})-(\d{2})-(\d{2})"))
n = 3
print("{n} {{n}}")
