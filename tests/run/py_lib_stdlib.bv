# Python modules Brevi does not build itself run in CPython (pybridge).
import sqlite3
import textwrap
import statistics
import itertools
import math
import random
from functools import reduce

def totals(rows):
    con = sqlite3.connect(":memory:")
    con.execute("create table t(name text, n int)")
    con.executemany("insert into t values (?, ?)", rows)
    out = []
    for name, total in con.execute("select name, sum(n) from t group by name order by name"):
        out.append(f"{name}={total}")
    return out

def main():
    print(totals([("a", 1), ("b", 2), ("a", 5)]))
    print(textwrap.fill("the quick brown fox jumps over the lazy dog", 12))
    xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(statistics.mean(xs), statistics.median(xs), round(statistics.stdev(xs), 3))
    pairs = 0
    for a, b in itertools.combinations(xs, 2):
        if a + b == 10:
            pairs += 1
    print("pairs", pairs)
    print(math.gcd(84, 36), math.comb(10, 3))
    random.seed(7)
    ys = list(range(8))
    random.shuffle(ys)
    print(ys, random.randint(1, 100))
    print(reduce(lambda p, q: p * q, [1, 2, 3, 4, 5]))
    try:
        sqlite3.connect(":memory:").execute("select * from missing")
    except sqlite3.OperationalError as e:
        print("error:", e)

main()
