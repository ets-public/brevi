import calendar
from collections import Counter
from datetime import date, datetime, timedelta


def main():
    seen = set()
    seen.update([3, 1, 3])
    seen.update([2])
    print(sorted(seen))
    prices = {"a": 1}
    prices.update({"b": 2, "a": 5})
    print(prices)
    c = Counter("abca")
    c.update(["a", "z"])
    print(c["a"], c["z"])
    d = date(2026, 3, 1)
    print(d.isoformat(), d.toordinal() - date(2026, 2, 1).toordinal(), d.weekday(), d.isoweekday())
    e = datetime.strptime("2026-04-05", "%Y-%m-%d").date()
    later = e + timedelta(days=30)
    print(later, (later - e).days, e + timedelta(weeks=1, days=1))
    print(calendar.monthrange(2024, 2)[1], calendar.monthrange(2026, 12)[0], calendar.isleap(1900))
    print(format(3.14159, ".2f"), format(42, ">5"), format(7))
    print("abc".isascii(), "é".isascii())


main()
