import tkinter as tk
from tkinter import messagebox

root = tk.Tk()
root.title("Pad")
status = tk.StringVar(value="ready")
tk.Label(root, textvariable=status).pack()
entry = tk.Entry(root)
entry.pack()
frame = tk.Frame(root)
frame.pack()
log = None
count = 0
timer = None


def press(k):
    global count
    count += 1
    status.set("pressed %s (%d)" % (k, count))
    log.insert(tk.END, k)


for i, ch in enumerate("abc"):
    tk.Button(frame, text=ch.upper(), command=lambda ch=ch: press(ch)).grid(row=0, column=i)
log = tk.Listbox(root)
log.pack()
canvas = tk.Canvas(root, width=100, height=50)
canvas.pack()


def on_key(e):
    if e.char and e.char in "xyz":
        press(e.char)
    elif e.keysym == "Return":
        press(entry.get().strip())
        entry.delete(0, tk.END)


def tap(e):
    canvas.create_oval(e.x - 5, e.y - 5, e.x + 5, e.y + 5, fill="red")


def tick(n):
    global timer
    status.set("tick %d" % n)
    timer = root.after(100, tick, n + 1) if n < 3 else None


def clear():
    if messagebox.askyesno("Pad", "Clear %d lines?" % log.size()):
        log.delete(0, tk.END)
        canvas.delete("all")


root.bind("<Key>", on_key)
canvas.bind("<Button-1>", tap)
tk.Button(root, text="Clear", command=clear).pack()
tk.Button(root, text="Tick", command=lambda: tick(1)).pack()
root.mainloop()
