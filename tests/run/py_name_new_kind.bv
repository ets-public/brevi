# A name set to a list in one loop and to a tuple later is a new name each time (Python rebinding).
def trip(paths, k):
    best = None
    cur = None
    for step in range(1, k + 1):
        new = {}
        for s, p in paths:
            if cur is None:
                pre = []
            else:
                c = [l for a, l in cur.get(s, []) if a < step]
                if not c:
                    continue
                pre = min(c)
            new.setdefault(s, []).append((step, pre + [s]))
        cur = new
        if "b" in cur:
            a, l = cur["b"][0]
            c = (a, step, l)
            if best is None or c < best:
                best = c
    return best

b = trip([("a", 1), ("b", 2)], 2)
print(b[0], b[1], ",".join(b[2]))
