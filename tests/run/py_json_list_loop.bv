# A Python list of mixed literal kinds that is looped over is a list of JSON values (huge-set repro r2).
def show(v):
    if v is None:
        return 'none'
    if type(v) is bool:
        return 'true' if v else 'false'
    if type(v) is int:
        return str(v)
    if isinstance(v, list):
        return '[' + ', '.join(show(x) for x in v) + ']'
    return v

def main():
    vals = [1, 'a', True, None, [2, 'b']]
    for v in vals:
        print(show(v))

main()
