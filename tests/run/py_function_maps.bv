# A dict of functions set once and only called by key is picked in place; a parameter that
# defaults to print and is never passed prints.
import operator

CMP = {'<': operator.lt, '<=': operator.le, '>': operator.gt}
OPS = {'+': lambda a, b: a + b, '-': lambda x, y: x - y}


def compare(op, a, b):
    return CMP[op](a, b)


class Runner:
    def __init__(self, names, out=print):
        self.names = names
        self.out = out

    def show(self, xs):
        for x in xs:
            self.out(' '.join(self.names[v] for v in x))


def emit_all(xs, emit=print):
    for x in xs:
        emit(x * 2)


print(compare('<', 1, 2), compare('>', 1, 2), OPS['-'](7, 2), OPS['+'](OPS['+'](1, 2), 3))
try:
    print(OPS['*'](1, 2))
except KeyError as e:
    print("missing", e)
Runner({1: "one", 2: "two"}).show([[1, 2], [2]])
emit_all([1, 2])
