from fractions import Fraction
print(Fraction(1, 3) + Fraction(1, 6))
a = Fraction(2, 7)
print(a * 7 == 2, a < Fraction(1, 3), float(a), a // Fraction(1, 10), a % Fraction(1, 10))
print(sum([Fraction(1, 3)] * 3), f"{Fraction(1, 3):.4f}", round(Fraction(5, 2)), Fraction("1.55") - Fraction(1, 20))
v = Fraction(170, 3)
print((v * 100 + Fraction(1, 2)).__floor__(), {Fraction(1, 2): 1}, Fraction(1, 3) == 0)
print(Fraction(1, 2) + Fraction(1, 4))
x = Fraction(3, 4) * 2
print(x, [x, Fraction(5)], x // Fraction(1, 2), float(x))
print(Fraction(-7, 2) // 2)
print(Fraction(1, 3) + Fraction(1, 6))
