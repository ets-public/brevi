# Functions written in Rust, called like Brevi functions.
rust:
  use std::collections::HashSet;
  fn distinct(xs: &[i64]) -> usize { xs.iter().collect::<HashSet<_>>().len() }

rust fn shout(s: str) -> str = s.to_uppercase() + "!"
rust fn parse_hex(s: str) -> int !:
  let v = i64::from_str_radix(s.trim(), 16)?;
  if v > 1000 { return Err(format!("{v} is too big").into()); }
  Ok(v)
rust fn bump(mut xs: [int]):
  for x in xs.iter_mut() { *x += 1; }
rust fn count_distinct(xs: [int]) -> int = distinct(&xs) as i64
type Item:
  name: str
  qty: int
rust fn total(items: [Item]) -> int = items.iter().map(|i| i.qty).sum()

xs = [3, 1, 3]
bump(xs)
print(shout("hi"), parse_hex("ff"), xs, count_distinct(xs))
print(parse_hex("zz").or(-1), parse_hex("fff").or(-2))
match parse_hex("fff"):
  Ok(v) => print(v)
  Err(m) => print("error: {m}")
print(total([Item("a", 2), Item("b", 5)]))

test "rust fns":
  assert shout("a") == "A!"
  assert parse_hex("10") == 16
