class P:
    def __init__(self, toks):
        self.toks = toks
        self.i = 0
    def atom(self):
        t = self.toks[self.i]
        self.i += 1
        if t.isdigit():
            return ('lit', int(t))
        return ('name', t)
    def add(self):
        e = self.atom()
        while self.i < len(self.toks) and self.toks[self.i] == '+':
            self.i += 1
            e = ('bin', '+', e, self.atom())
        return e
print(P(['1', '+', 'x', '+', '2']).add())
