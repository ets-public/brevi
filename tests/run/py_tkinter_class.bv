import tkinter as tk
from tkinter import messagebox


class Clicker:
    def __init__(self, root):
        self.root = root
        self.count = 0
        self.timer = None
        self.label = tk.Label(root, text="0")
        self.label.pack()
        self.canvas = tk.Canvas(root, width=100, height=100)
        self.canvas.pack()
        tk.Button(root, text="+1", command=self.inc).pack()
        tk.Button(root, text="Reset", command=self.reset).pack()
        tk.Button(root, text="Auto", command=lambda: self.tick(3)).pack()
        self.canvas.bind("<Button-1>", self.tap)
        root.bind("<Key>", self.key)

    def show(self):
        self.label.config(text=str(self.count))

    def inc(self):
        self.count += 1
        self.show()

    def reset(self):
        if messagebox.askyesno("Counter", "Reset %d?" % self.count):
            self.count = 0
            self.show()

    def tap(self, event):
        self.canvas.create_rectangle(event.x, event.y, event.x + 4, event.y + 4, fill="blue")
        self.count += 10
        self.show()

    def key(self, event):
        if event.char == "+":
            self.inc()

    def tick(self, n):
        self.inc()
        if n > 1:
            self.timer = self.root.after(100, self.tick, n - 1)


root = tk.Tk()
root.title("Counter")
app = Clicker(root)
root.mainloop()
