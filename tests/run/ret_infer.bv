fn val(c: str) = match c:
  "I" => 1
  "V" => 5
  _ => 0
fn parse(s: str):
  t = 0
  for i, c in s.chars().enumerate():
    t += val(c)
  t
fn show(n: int):
  if n > 3: return "big"
  "small"
fn say(x: str):
  print(x)
fn fact(n: int) = if n < 2: 1 else: n * fact(n - 1)
fn pair(a: int):
  xs = [a, a + 1]
  (xs, "p")
say(show(parse("IVI")))
print(fact(5), pair(2))
