owners = []
bals = []

fn acct(i: int) = str({"id": i, "owner": owners[i - 1], "balance": bals[i - 1]})

fn amt(j: Json) -> int = match j["amount"]:
  Num(n) => if n > 0.0 and n == n.floor(): n.int() else: 0
  _ => 0

fn exists(i: int) = i >= 1 and i <= owners.len()

fn idof(s: str) = if s.is_digit(): s.int().or(-1) else: -1

fn handle(method: str, path: str, body: str):
  parts = path.split("/")
  n = parts.len()
  # parts[0] is "" for paths starting with /
  if parts[0] != "":
    print('404 {"error":"not found"}')
    return
  route = ""
  id = 0
  if method == "POST" and path == "/accounts":
    route = "create"
  elif method == "GET" and path == "/accounts":
    route = "list"
  elif method == "POST" and path == "/transfer":
    route = "transfer"
  elif n == 3 and parts[1] == "accounts" and idof(parts[2]) >= 0 and method == "GET":
    route = "get"
    id = idof(parts[2])
  elif n == 4 and parts[1] == "accounts" and idof(parts[2]) >= 0 and method == "POST" and (parts[3] == "deposit" or parts[3] == "withdraw"):
    route = parts[3]
    id = idof(parts[2])
  if route == "":
    print('404 {"error":"not found"}')
    return
  if route == "list":
    ids = (1..owners.len() + 1).sort_by(i => (-bals[i - 1], i))
    print("200 [" + ",".join([acct(i) for i in ids]) + "]")
    return
  if route == "get":
    if exists(id):
      print("200 {acct(id)}")
    else:
      print('404 {"error":"no such account"}')
    return
  j = json("null")
  match json(body):
    Ok(v) => j = v
    Err(e) =>
      print('400 {"error":"bad json"}')
      return
  if route == "create":
    owner = match j["owner"]:
      Str(s) => s
      _ => ""
    if owner.is_empty():
      print('400 {"error":"owner required"}')
      return
    owners.push(owner)
    bals.push(0)
    print("201 {acct(owners.len())}")
  elif route == "transfer":
    a = j["from"].int()
    b = j["to"].int()
    if not exists(a) or not exists(b):
      print('404 {"error":"no such account"}')
      return
    if a == b:
      print('400 {"error":"same account"}')
      return
    x = amt(j)
    if x <= 0:
      print('400 {"error":"bad amount"}')
      return
    if x > bals[a - 1]:
      print('409 {"error":"insufficient funds"}')
      return
    bals[a - 1] -= x
    bals[b - 1] += x
    print('200 {"from":{bals[a - 1]},"to":{bals[b - 1]}}')
  else:
    if not exists(id):
      print('404 {"error":"no such account"}')
      return
    x = amt(j)
    if x <= 0:
      print('400 {"error":"bad amount"}')
      return
    if route == "withdraw" and x > bals[id - 1]:
      print('409 {"error":"insufficient funds"}')
      return
    if route == "deposit":
      bals[id - 1] += x
    else:
      bals[id - 1] -= x
    print("200 {acct(id)}")

for line in lines():
  t = line.trim()
  if t.is_empty():
    continue
  sp = t.find(" ")
  method = t.slice(0, sp)
  rest = t.slice(sp + 1)
  sp2 = rest.find(" ")
  if sp2 < 0:
    handle(method, rest, "")
  else:
    handle(method, rest.slice(0, sp2), rest.slice(sp2 + 1))
