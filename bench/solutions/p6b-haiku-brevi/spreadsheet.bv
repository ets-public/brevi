defs = {}
state = {}
memo = {}
memoerr = {}

fn is_digit_char(c: str) -> bool:
  return c.len() == 1 and c.is_digit()

fn is_upper(c: str) -> bool:
  return c.len() == 1 and c >= "A" and c <= "Z"

fn ch(s: str, p: int) -> str = s.slice(p, p + 1)

fn comb(e1: str, e2: str) -> str:
  if e1 == "CYCLE" or e2 == "CYCLE":
    return "CYCLE"
  if e1 == "DIV0" or e2 == "DIV0":
    return "DIV0"
  return ""

fn read_ref(s: str, p: int) -> (str, int):
  r = p + 1
  while is_digit_char(ch(s, r)):
    r += 1
  return (s.slice(p, r), r)

fn cell_val(name: str) -> (int, str):
  if state.has(name):
    if state[name] == 1:
      return (0, "CYCLE")
    return (memo[name], memoerr[name])
  if not defs.has(name):
    return (0, "")
  state[name] = 1
  content = defs[name]
  v = 0
  e = ""
  if content.starts_with("="):
    v, e, q = parse_expr(content.slice(1).replace(" ", ""), 0)
  else:
    v = content.int().or(0)
  state[name] = 2
  memo[name] = v
  memoerr[name] = e
  return (v, e)

fn parse_expr(s: str, p: int) -> (int, str, int):
  v, e, q = parse_term(s, p)
  while ch(s, q) == "+" or ch(s, q) == "-":
    op = ch(s, q)
    w, f, q = parse_term(s, q + 1)
    if op == "+":
      v = v + w
    else:
      v = v - w
    e = comb(e, f)
  return (v, e, q)

fn parse_term(s: str, p: int) -> (int, str, int):
  v, e, q = parse_unary(s, p)
  while ch(s, q) == "*" or ch(s, q) == "/":
    op = ch(s, q)
    w, f, q = parse_unary(s, q + 1)
    e = comb(e, f)
    if op == "*":
      v = v * w
    elif w == 0:
      v = 0
      e = comb(e, "DIV0")
    else:
      v = v / w
  return (v, e, q)

fn parse_unary(s: str, p: int) -> (int, str, int):
  if ch(s, p) == "-":
    v, e, q = parse_unary(s, p + 1)
    return (0 - v, e, q)
  return parse_primary(s, p)

fn parse_primary(s: str, p: int) -> (int, str, int):
  c = ch(s, p)
  if c == "(":
    v, e, q = parse_expr(s, p + 1)
    return (v, e, q + 1)
  if is_digit_char(c):
    q = p
    while is_digit_char(ch(s, q)):
      q += 1
    return (s.slice(p, q).int().or(0), "", q)
  if not is_upper(c):
    return (0, "", p)
  q = p
  while is_upper(ch(s, q)):
    q += 1
  if ch(s, q) == "(":
    return parse_func(s, s.slice(p, q), q + 1)
  name, r = read_ref(s, p)
  v, e = cell_val(name)
  return (v, e, r)

fn parse_func(s: str, fname: str, p: int) -> (int, str, int):
  n1, q = read_ref(s, p)
  n2, q2 = read_ref(s, q + 1)
  c1 = n1.slice(0, 1).code() - 65
  c2 = n2.slice(0, 1).code() - 65
  r1 = n1.slice(1).int().or(0)
  r2 = n2.slice(1).int().or(0)
  clo = min(c1, c2)
  chi = max(c1, c2)
  rlo = min(r1, r2)
  rhi = max(r1, r2)
  total = 0
  mn = 0
  mx = 0
  first = true
  err = ""
  for c in clo..(chi + 1):
    for r in rlo..(rhi + 1):
      v, e = cell_val((65 + c).char() + str(r))
      err = comb(err, e)
      total += v
      if first:
        mn = v
        mx = v
        first = false
      else:
        mn = min(mn, v)
        mx = max(mx, v)
  if fname == "SUM":
    return (total, err, q2 + 1)
  if fname == "MIN":
    return (mn, err, q2 + 1)
  return (mx, err, q2 + 1)

maxc = 0
maxr = 0
for line in lines():
  if line.trim().is_empty():
    continue
  eq = line.find("=")
  name = line.slice(0, eq).trim()
  content = line.slice(eq + 1).trim()
  defs[name] = content
  maxc = max(maxc, name.slice(0, 1).code() - 65)
  maxr = max(maxr, name.slice(1).int().or(0))
  for m in content.re_all("[A-Z][0-9]+"):
    maxc = max(maxc, m[0].slice(0, 1).code() - 65)
    maxr = max(maxr, m[0].slice(1).int().or(0))

letters = [(65 + c).char() for c in 0..(maxc + 1)]
print("\t" + "\t".join(letters))
for r in 1..(maxr + 1):
  cells = []
  for c in 0..(maxc + 1):
    nm = (65 + c).char() + str(r)
    if defs.has(nm):
      v, e = cell_val(nm)
      if e == "":
        cells.push(str(v))
      else:
        cells.push("#" + e)
    else:
      cells.push("")
  print(str(r) + "\t" + "\t".join(cells))
