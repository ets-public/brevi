fn q(s: str) -> str:
  return str(s.json())

j = json(stdin())
prods = j["products"]
custs = j["customers"]
out = []
revenue = 0.dec()
for o in j["orders"]:
  oid = o["id"].text()
  cid = o["customer"].text()
  if not custs.has(cid):
    err = "unknown customer {cid}"
    out.push('{"id":{q(oid)},"error":{q(err)}}')
    continue
  bad = ""
  for ln in o["lines"]:
    sku = ln["sku"].text()
    if bad == "" and not prods.has(sku): bad = sku
  if bad != "":
    err = "unknown sku {bad}"
    out.push('{"id":{q(oid)},"error":{q(err)}}')
    continue
  cat_qty = {}
  for ln in o["lines"]:
    cat = prods[ln["sku"].text()]["category"].text()
    cat_qty[cat] += ln["qty"].int()
  subtotal = 0.dec()
  catdisc = 0.dec()
  for ln in o["lines"]:
    p = prods[ln["sku"].text()]
    amt = p["price"].text().dec() * ln["qty"].int()
    subtotal += amt
    cat = p["category"].text()
    if cat_qty[cat] >= 3:
      catdisc += (amt * "0.05".dec()).round(2)
  disc_after = subtotal - catdisc
  tier = custs[cid]["tier"].text()
  rate = "0".dec()
  if tier == "gold": rate = "0.10".dec()
  elif tier == "silver": rate = "0.05".dec()
  tierdisc = (disc_after * rate).round(2)
  disc = catdisc + tierdisc
  taxable = subtotal - disc
  country = custs[cid]["country"].text()
  trate = "0".dec()
  if country == "UK": trate = "0.20".dec()
  elif country == "US": trate = "0.0825".dec()
  tax = (taxable * trate).round(2)
  total = taxable + tax
  revenue += total
  cname = custs[cid]["name"].text()
  out.push('{"id":{q(oid)},"customer":{q(cname)},"subtotal":"{subtotal.fmt(2)}","discount":"{disc.fmt(2)}","tax":"{tax.fmt(2)}","total":"{total.fmt(2)}"}')
print("[" + ",".join(out) + "]")
print("revenue " + revenue.fmt(2))
