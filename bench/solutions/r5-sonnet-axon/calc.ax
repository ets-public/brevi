var toks: [str] = []
var pos = 0

fn tokenize(s: str) -> [str] {
  var out: [str] = []
  var cur = ""
  for c in s.chars() {
    if c.is_digit() {
      cur = cur + c
    } else {
      if !cur.is_empty() {
        out.push(cur)
        cur = ""
      }
      if !c.is_space() { out.push(c) }
    }
  }
  if !cur.is_empty() { out.push(cur) }
  out
}

fn peek() -> str {
  if pos < toks.len() { toks[pos] } else { "" }
}

fn atom() -> int {
  let t = peek()
  if t == "(" {
    pos += 1
    let v = expr()?
    pos += 1
    return v
  }
  if t == "-" {
    pos += 1
    let v = atom()?
    return -v
  }
  pos += 1
  t.int()?
}

fn term() -> int {
  var v = atom()?
  while peek() == "*" or peek() == "/" {
    let op = peek()
    pos += 1
    let r = atom()?
    if op == "*" {
      v = v * r
    } else {
      if r == 0 { fail("div0") }
      v = v / r
    }
  }
  v
}

fn expr() -> int {
  var v = term()?
  while peek() == "+" or peek() == "-" {
    let op = peek()
    pos += 1
    let r = term()?
    if op == "+" { v = v + r } else { v = v - r }
  }
  v
}

fn calc(line: str) -> int {
  toks = tokenize(line)
  pos = 0
  expr()?
}

for l in lines() {
  if !l.trim().is_empty() {
    match calc(l) {
      Ok(v) => print(v)
      Err(_) => print("error")
    }
  }
}
