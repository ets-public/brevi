iv: [(int, int)] = []
for line in lines():
  n = line.ints()
  if n.len() == 2: iv.push((n[0], n[1]))
iv = iv.sort()
total = 0
if !iv.is_empty():
  cs = iv[0].0
  ce = iv[0].1
  for (s, e) in iv.skip(1):
    if s <= ce:
      ce = max(ce, e)
    else:
      print("{cs} {ce}")
      total += ce - cs
      cs = s
      ce = e
  print("{cs} {ce}")
  total += ce - cs
print("total {total}")
