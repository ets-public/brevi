ls = lines()
h = ls[0].ints()
r = h[0]
c = h[1]
m = ls.skip(1).take(r).map(l => l.ints())
top = 0
bot = r - 1
left = 0
right = c - 1
out: [int] = []
while top <= bot and left <= right:
  for j in left..right + 1: out.push(m[top][j])
  top += 1
  for i in top..bot + 1: out.push(m[i][right])
  right -= 1
  if top <= bot:
    for j in (left..right + 1).rev(): out.push(m[bot][j])
    bot -= 1
  if left <= right:
    for i in (top..bot + 1).rev(): out.push(m[i][left])
    left += 1
print(out.join(" "))
cols = [0].repeat(c)
for row in m:
  for j in 0..c: cols[j] += row[j]
print(cols.join(" "))
