dur: {str: int} = {}
deps: {str: [str]} = {}
names: [str] = []
for line in lines():
  w = line.words()
  if w.len() < 2: continue
  names.push(w[0])
  dur[w[0]] = w[1].int()
  if w.len() > 3: deps[w[0]] = w.skip(3)
ok = true
for n in names:
  for d in deps[n]:
    if !dur.has(d): ok = false
start: {str: int} = {}
done: {str: bool} = {}
if ok:
  progress = true
  while progress:
    progress = false
    for n in names:
      if done.has(n): continue
      if deps[n].all(d => done.has(d)):
        s = 0
        for d in deps[n]: s = max(s, start[d] + dur[d])
        start[n] = s
        done[n] = true
        progress = true
  if done.len() < names.unique().len(): ok = false
if !ok:
  print("invalid")
else:
  rows = names.unique().map(n => (start[n], n))
  rows = rows.sort()
  t = 0
  for (s, n) in rows:
    print("{n} {s} {s + dur[n]}")
    t = max(t, s + dur[n])
  print("total {t}")
