content: {str: str} = {}
state: {str: int} = {}
vals: {str: int} = {}
cf: {str: int} = {}
df: {str: int} = {}

fn tokenize(s: str) -> [str]:
  cs = s.replace(" ", "").chars()
  toks = []
  i = 0
  while i < cs.len():
    c = cs[i]
    if c.is_digit():
      j = i
      while j < cs.len() and cs[j].is_digit(): j += 1
      toks.push("".join(cs[i:j]))
      i = j
    elif c.is_alpha():
      j = i
      while j < cs.len() and (cs[j].is_alpha() or cs[j].is_digit()): j += 1
      toks.push("".join(cs[i:j]))
      i = j
    else:
      toks.push(c)
      i += 1
  toks

fn peek(t: [str], p: int) -> str = if p < t.len(): t[p] else: ""

fn cellval(name: str, mut fl: [int]) -> int:
  if not content.has(name): return 0
  st = state[name]
  if st == 1:
    fl[0] = 1
    return 0
  if st == 0:
    state[name] = 1
    f2 = [0, 0]
    v = 0
    c = content[name]
    if c.starts_with("="):
      t = tokenize(c.slice(1))
      p = 0
      v = expr(t, p, f2)
    else:
      v = c.int()
    state[name] = 2
    vals[name] = v
    cf[name] = f2[0]
    df[name] = f2[1]
  if cf[name] == 1: fl[0] = 1
  if df[name] == 1: fl[1] = 1
  vals[name]

fn expr(t: [str], mut p: int, mut fl: [int]) -> int:
  v = term(t, p, fl)
  while peek(t, p) == "+" or peek(t, p) == "-":
    op = t[p]
    p += 1
    r = term(t, p, fl)
    v = if op == "+": v + r else: v - r
  v

fn term(t: [str], mut p: int, mut fl: [int]) -> int:
  v = unary(t, p, fl)
  while peek(t, p) == "*" or peek(t, p) == "/":
    op = t[p]
    p += 1
    r = unary(t, p, fl)
    if op == "*":
      v = v * r
    elif r == 0:
      fl[1] = 1
      v = 0
    else:
      v = v / r
  v

fn unary(t: [str], mut p: int, mut fl: [int]) -> int:
  if peek(t, p) == "-":
    p += 1
    return 0 - unary(t, p, fl)
  primary(t, p, fl)

fn primary(t: [str], mut p: int, mut fl: [int]) -> int:
  tk = peek(t, p)
  p += 1
  if tk == "(":
    v = expr(t, p, fl)
    p += 1
    return v
  if tk.slice(0, 1).is_digit(): return tk.int()
  if peek(t, p) == "(":
    a = t[p + 1]
    b = t[p + 3]
    p += 5
    c1 = a.slice(0, 1).code()
    c2 = b.slice(0, 1).code()
    r1 = a.slice(1).int()
    r2 = b.slice(1).int()
    xs = []
    for c in min(c1, c2)..max(c1, c2) + 1:
      for r in min(r1, r2)..max(r1, r2) + 1:
        xs.push(cellval(c.char() + str(r), fl))
    if tk == "SUM": return xs.sum()
    if tk == "MIN": return xs.min()
    return xs.max()
  cellval(tk, fl)

maxc = 0
maxr = 0
for line in lines():
  i = line.find("=")
  if i < 0: continue
  name = line.slice(0, i).trim()
  content[name] = line.slice(i + 1).trim()
  state[name] = 0
  refs = [name]
  if content[name].starts_with("="):
    for tk in tokenize(content[name].slice(1)):
      if tk.len() >= 2 and tk.slice(0, 1).is_alpha() and tk.slice(1).is_digit():
        refs.push(tk)
  for r in refs:
    maxc = max(maxc, r.slice(0, 1).code() - 64)
    maxr = max(maxr, r.slice(1).int())

hdr = [""]
for c in 1..maxc + 1:
  hdr.push((c + 64).char())
print("\t".join(hdr))
for r in 1..maxr + 1:
  row = [str(r)]
  for c in 1..maxc + 1:
    nm = (c + 64).char() + str(r)
    if not content.has(nm):
      row.push("")
    else:
      fl = [0, 0]
      v = cellval(nm, fl)
      if fl[0] == 1: row.push("#CYCLE")
      elif fl[1] == 1: row.push("#DIV0")
      else: row.push(str(v))
  print("\t".join(row))
