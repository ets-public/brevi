let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
let k = vals.len()
for line in lines() {
  if !line.trim().is_empty() {
    var n = line.trim().int()?
    var out = ""
    for i in 0..k {
      while n >= vals[i] {
        out += syms[i]
        n -= vals[i]
      }
    }
    print(out)
  }
}
