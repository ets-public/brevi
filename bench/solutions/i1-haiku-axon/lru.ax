cap = 0
vals: {str: str} = {}
order: [str] = []

fn touch(k: str):
  i = order.index_of(k)
  order.remove(i)
  order.push(k)

for line in lines():
  w = line.words()
  if w.len() == 0:
    continue
  if cap == 0:
    cap = w[0].int().or(1)
    continue
  k = w[1]
  if w[0] == "get":
    if vals.has(k):
      touch(k)
      print(vals[k])
    else:
      print(-1)
  else:
    if vals.has(k):
      touch(k)
    else:
      if vals.len() >= cap:
        old = order.remove(0)
        vals.remove(old)
      order.push(k)
    vals[k] = w[2]
