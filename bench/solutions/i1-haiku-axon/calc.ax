toks: [str] = []
pos = 0
bad = false

fn tokenize(s: str) -> [str]:
  out: [str] = []
  cur = ""
  for c in s.chars():
    if c.is_digit():
      cur += c
    else:
      if cur != "":
        out.push(cur)
        cur = ""
      if c != " ":
        out.push(c)
  if cur != "":
    out.push(cur)
  return out

fn peek() -> str:
  if pos < toks.len():
    return toks[pos]
  return ""

fn factor() -> int:
  t = peek()
  if t == "-":
    pos += 1
    return -factor()
  if t == "(":
    pos += 1
    v = expr()
    pos += 1
    return v
  pos += 1
  return t.int().or(0)

fn term() -> int:
  v = factor()
  while pos < toks.len() and (toks[pos] == "*" or toks[pos] == "/"):
    op = toks[pos]
    pos += 1
    r = factor()
    if op == "*":
      v = v * r
    else:
      if r == 0:
        bad = true
      else:
        v = v / r
  return v

fn expr() -> int:
  v = term()
  while pos < toks.len() and (toks[pos] == "+" or toks[pos] == "-"):
    op = toks[pos]
    pos += 1
    r = term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  return v

for line in lines():
  if line.trim() == "":
    continue
  toks = tokenize(line)
  pos = 0
  bad = false
  v = expr()
  if bad:
    print("error")
  else:
    print(v)
