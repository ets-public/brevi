opener_of: {str: str} = {")": "(", "]": "[", "}": "{"}

for line in lines():
  cs = line.chars()
  st: [str] = []
  err = 0
  for i in 0..cs.len():
    c = cs[i]
    if c == "(" or c == "[" or c == "{":
      st.push(c)
    elif c == ")" or c == "]" or c == "}":
      if st.is_empty() or st.last() != opener_of[c]:
        err = i + 1
        break
      st.pop()
  if err == 0 and !st.is_empty():
    err = cs.len() + 1
  if err == 0:
    print("ok")
  else:
    print("error at {err}")
