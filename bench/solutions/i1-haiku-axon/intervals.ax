iv: [(int, int)] = []
for line in lines():
  if line.trim() == "":
    continue
  n = line.ints()
  iv.push((n[0], n[1]))
iv = iv.sort()

merged: [(int, int)] = []
for (s, e) in iv:
  k = merged.len() - 1
  if k >= 0 and s <= merged[k].1:
    merged[k] = (merged[k].0, max(merged[k].1, e))
  else:
    merged.push((s, e))

total = 0
for (s, e) in merged:
  print("{s} {e}")
  total += e - s
print("total {total}")
