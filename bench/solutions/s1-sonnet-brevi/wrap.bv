ls = lines()
width = ls[0].int()
paras = []
cur = []
for l in ls.skip(1):
  if l.trim().is_empty():
    if cur:
      paras.push(cur)
      cur = []
  else:
    cur = cur + l.words()
if cur:
  paras.push(cur)
outp = []
for p in paras:
  line = ""
  for w in p:
    if line.is_empty():
      line = w
    elif line.len() + 1 + w.len() <= width:
      line = line + " " + w
    else:
      outp.push(line)
      line = w
  outp.push(line)
  outp.push("")
if outp:
  outp.pop()
for l in outp:
  print(l)
