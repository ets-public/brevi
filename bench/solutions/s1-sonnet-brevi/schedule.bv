dur = {}
deps = {}
names = []
for l in lines():
  w = l.words()
  if w.len() < 2:
    continue
  names.push(w[0])
  dur[w[0]] = w[1].int()
  if w.len() > 3:
    deps[w[0]] = w.slice(3)
  else:
    deps[w[0]] = []
bad = false
for n in names:
  for d in deps[n]:
    if not dur.has(d):
      bad = true
start = {}
end = {}
if not bad:
  progress = true
  while progress:
    progress = false
    for n in names:
      if end.has(n):
        continue
      if all(end.has(d) for d in deps[n]):
        s = 0
        for d in deps[n]:
          if end[d] > s:
            s = end[d]
        start[n] = s
        end[n] = s + dur[n]
        progress = true
  if end.len() < dur.len():
    bad = true
if bad:
  print("invalid")
else:
  rows = [(start[n], n) for n in names].sort()
  total = 0
  for r in rows:
    print("{r.1} {r.0} {end[r.1]}")
    if end[r.1] > total:
      total = end[r.1]
  print("total {total}")
