pat = '^(\S+) - - \[([^\]]+)\] "(\S+) (\S+) (\S+)" (\d{3}) (\d+|-) "([^"]*)" "([^"]*)"$'
requests = 0
malformed = 0
total = 0
ips = {}
classes = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in stdin().lines():
  g = line.re_full(pat)
  if g.is_empty():
    malformed += 1
    continue
  requests += 1
  total += g[7].int().or(0)
  ips[g[1]] = 1
  classes[g[6].slice(0, 1)] += 1
  path = g[4].split("?")[0]
  paths[path] += 1
  hours[g[2].split(":")[1]] += 1
  if g[9].lower().contains("bot"):
    bots += 1
  st = g[6].int().or(0)
  if st >= 400:
    errs[g[1]] += 1
print("requests {requests}")
print("malformed {malformed}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for c in ["2", "3", "4", "5"]:
  if classes.has(c):
    print("  {c}xx {classes[c]}")
print("top_paths")
top = [(-v, k) for k, v in paths.pairs()]
top.sort()
for t in top.take(3):
  print("  {-t.0} {t.1}")
print("hours")
mx = hours.values().max().or(1)
for h in sorted(hours.keys()):
  n = hours[h]
  bar = "#".repeat(max(1, (n * 40 + mx) // (mx * 2)))
  print("  {h} {n} {bar}")
print("bots {bots}")
print("errors_by_ip")
ev = [(-v, k) for k, v in errs.pairs() if v >= 2]
ev.sort()
for t in ev:
  print("  {t.1} {-t.0}")
