store = {}
snaps = []
for line in lines():
  w = line.words()
  if w.is_empty():
    continue
  cmd = w[0]
  if cmd == "SET" and w.len() >= 3:
    store[w[1]] = w[2]
  elif cmd == "GET" and w.len() >= 2:
    if store.has(w[1]):
      print(store[w[1]])
    else:
      print("NULL")
  elif cmd == "DEL" and w.len() >= 2:
    if store.has(w[1]):
      store.remove(w[1])
    else:
      print("NOT FOUND")
  elif cmd == "INCR" and w.len() >= 3:
    cur = 0
    ok = true
    if store.has(w[1]):
      match store[w[1]].int():
        Ok(v) => cur = v
        Err(_) => ok = false
    if ok:
      cur += w[2].int().or(0)
      store[w[1]] = str(cur)
      print(cur)
    else:
      print("ERR not an integer")
  elif cmd == "COUNT" and w.len() >= 2:
    print(store.values().count(v => v == w[1]))
  elif cmd == "KEYS" and w.len() >= 2:
    ks = store.keys().filter(k => k.starts_with(w[1])).sort()
    if ks.is_empty():
      print("(empty)")
    else:
      print(ks.join(" "))
  elif cmd == "BEGIN":
    snaps.push(store)
  elif cmd == "ROLLBACK":
    if snaps.is_empty():
      print("NO TRANSACTION")
    else:
      store = snaps.pop()
  elif cmd == "COMMIT":
    if snaps.is_empty():
      print("NO TRANSACTION")
    else:
      snaps = []
  else:
    print("ERR unknown command")
