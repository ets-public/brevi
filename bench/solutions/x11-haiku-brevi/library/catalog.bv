type Loan:
  book: str
  due: Date

type Member:
  name: str
  tier: str
  owed: int
  loans: [Loan]

type Book:
  title: str
  copies: int
  shelf: int
  waits: [str]

type Hold:
  member: str
  book: str
  last: Date

type Lib:
  books: {str: Book}
  members: {str: Member}
  holds: [Hold]

fn new_lib() -> Lib:
  return Lib(books: {}, members: {}, holds: [])

# cents, shown with 2 decimals (negative allowed)
fn money(c: int) -> str:
  s = ""
  if c < 0: s = "-"
  a = abs(c)
  w = a // 100
  f = a % 100
  return "{s}{w}.{f:02d}"

# "12", "12.5" or "12.50" to cents, -1 when bad
fn cents_of(s: str) -> int:
  if s.re_full("\d+(\.\d{1,2})?").is_empty(): return -1
  (w, _, f) = s.partition(".")
  fr = f.int().or(0)
  if f.len() == 1: fr = fr * 10
  return w.int().or(0) * 100 + fr
