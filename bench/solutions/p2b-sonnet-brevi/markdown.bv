fn esc(s: str) -> str = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

fn fmtseg(s: str) -> str:
  t = s.re_sub("\*\*(.+?)\*\*", "<strong>\1</strong>")
  t = t.re_sub("\*(.+?)\*", "<em>\1</em>")
  t.re_sub("\[([^\]]*)\]\(([^)]*)\)", "<a href=\"\2\">\1</a>")

fn inline(raw: str) -> str:
  parts = esc(raw).split("`")
  out = ""
  for i, p in enumerate(parts):
    if i % 2 == 1 and i < parts.len() - 1:
      out += "<code>" + p + "</code>"
    elif i % 2 == 1:
      out += "`" + fmtseg(p)
    else:
      out += fmtseg(p)
  out

fn isblock(l: str) -> bool:
  l == "```" or l.starts_with("- ") or not l.re_full("\d+\. .*").is_empty() or not l.re_full("#{1,6} .*").is_empty()

ls = lines()
out = []
toc = []
used = {}
i = 0
n = ls.len()
while i < n:
  l = ls[i]
  t = l.trim()
  if t.is_empty():
    i += 1
  elif l == "```":
    i += 1
    body = []
    while i < n and ls[i] != "```":
      body.push(esc(ls[i]))
      i += 1
    i += 1
    out.push("<pre><code>" + "\n".join(body) + "</code></pre>")
  elif not l.re_full("(#{1,6}) (.*)").is_empty():
    g = l.re_full("(#{1,6}) (.*)")
    lv = g[1].len()
    raw = g[2].trim()
    base = raw.lower().re_sub("[^a-z0-9]+", "-").re_sub("^-+|-+$", "")
    id = base
    k = 2
    while used.has(id):
      id = base + "-" + k.str()
      k += 1
    used[id] = 1
    out.push("<h{lv} id=\"{id}\">{inline(raw)}</h{lv}>")
    toc.push("<a href=\"#{id}\">{esc(raw.replace("`", "").replace("*", ""))}</a>")
    i += 1
  elif l.starts_with("- "):
    out.push("<ul>")
    while i < n and ls[i].starts_with("- "):
      out.push("<li>" + inline(ls[i].slice(2)) + "</li>")
      i += 1
    out.push("</ul>")
  elif not l.re_full("\d+\. .*").is_empty():
    out.push("<ol>")
    while i < n and not ls[i].re_full("\d+\. .*").is_empty():
      g = ls[i].re_full("\d+\. (.*)")
      out.push("<li>" + inline(g[1]) + "</li>")
      i += 1
    out.push("</ol>")
  else:
    ps = []
    while i < n and not ls[i].trim().is_empty() and not isblock(ls[i]):
      ps.push(ls[i].trim())
      i += 1
    out.push("<p>" + inline(" ".join(ps)) + "</p>")
if toc.len() >= 2:
  print("<nav>")
  for x in toc: print(x)
  print("</nav>")
for x in out: print(x)
