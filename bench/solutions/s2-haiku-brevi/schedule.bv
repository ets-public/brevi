specs = []
for line in lines():
  p = line.words()
  if p.len() < 2: continue
  deps = []
  if p.len() > 2: deps = p.skip(3)
  specs.push((p[0], p[1].int(), deps))
starts = {}
ends = {}
pending = specs
bad = False
while pending.len() > 0:
  nxt = []
  for s in pending:
    ready = True
    st = 0
    for d in s.2:
      if not ends.has(d):
        ready = False
      elif ends[d] > st:
        st = ends[d]
    if ready:
      starts[s.0] = st
      ends[s.0] = st + s.1
    else:
      nxt.push(s)
  if nxt.len() == pending.len():
    bad = True
    break
  pending = nxt
if bad:
  print("invalid")
else:
  rows = []
  T = 0
  for s in specs:
    rows.push((starts[s.0], s.0, ends[s.0]))
    if ends[s.0] > T: T = ends[s.0]
  rows.sort()
  for r in rows:
    print("{r.1} {r.0} {r.2}")
  print("total {T}")
