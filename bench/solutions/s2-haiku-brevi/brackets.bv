opener_of = {")": "(", "]": "[", "}": "{"}
for line in lines():
  stack = []
  err = 0
  for i in 0..line.len():
    c = line.slice(i, i + 1)
    if c == "(" or c == "[" or c == "{":
      stack.push(c)
    elif c == ")" or c == "]" or c == "}":
      if stack.is_empty() or stack[stack.len() - 1] != opener_of[c]:
        err = i + 1
        break
      stack.pop()
  if err > 0:
    print("error at {err}")
  elif not stack.is_empty():
    print("error at {line.len() + 1}")
  else:
    print("ok")
