rv = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}

fn roman_to_int(s: str) -> int:
  total = 0
  for i in 0..s.len():
    v = rv[s.slice(i, i + 1)]
    if i + 1 < s.len() and v < rv[s.slice(i + 1, i + 2)]:
      total -= v
    else:
      total += v
  return total

fn to_roman(n: int) -> str:
  vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  out = ""
  m = n
  for i in 0..vals.len():
    while m >= vals[i]:
      out += syms[i]
      m -= vals[i]
  return out

for line in lines():
  p = line.words()
  if p.len() == 0: continue
  acc = roman_to_int(p[0])
  i = 1
  while i < p.len():
    v = roman_to_int(p[i + 1])
    if p[i] == "+":
      acc += v
    else:
      acc -= v
    i += 2
  if acc <= 0:
    print("nulla")
  else:
    print(to_roman(acc))
