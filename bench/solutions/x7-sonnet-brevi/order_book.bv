type Order:
  id: str
  buy: bool
  qty: int
  price: dec
  seq: int

book = []
seen = {}
vol = 0
val = 0.dec()
seqn = 0

fn best(buy: bool, limit: bool, lp: dec) -> int:
  bi = -1
  for i in 0..book.len():
    o = book[i]
    if o.buy != buy:
      ok = if not limit: true else: (if buy: o.price <= lp else: o.price >= lp)
      if ok:
        if bi < 0: bi = i
        else:
          b = book[bi]
          better = if buy: o.price < b.price else: o.price > b.price
          if better: bi = i
  bi

fn run_match(id: str, buy: bool, q: int, limit: bool, lp: dec) -> int:
  rem = q
  while rem > 0:
    bi = best(buy, limit, lp)
    if bi < 0: break
    o = book[bi]
    f = min(rem, o.qty)
    bid = if buy: id else: o.id
    sid = if buy: o.id else: id
    print("TRADE {bid} {sid} {f} {o.price.fmt(2)}")
    vol += f
    val += o.price * f
    rem -= f
    if f == o.qty: book.remove(bi)
    else: book[bi].qty = o.qty - f
  rem

fn pc(c: int) -> str = "{c // 100}.{c % 100:02d}"

fn side(buy: bool):
  m = {}
  for o in book:
    if o.buy == buy:
      c = (o.price * 100).int()
      m[c] += o.qty
  ps = m.pairs()
  if not buy:
    if ps.is_empty(): print("  -")
    for p in ps: print("  {pc(p.0)} {p.1}")
  else:
    if ps.is_empty(): print("  -")
    for p in ps.rev(): print("  {pc(p.0)} {p.1}")

fn goodq(s: str) -> bool = s.re_full("\d+").len() > 0 and s.int() >= 1
fn goodp(s: str) -> bool = s.re_full("\d+(\.\d{1,2})?").len() > 0 and s.dec() > 0

fn goodid(s: str) -> bool = s.re_full("\w+").len() > 0

fn handle(n: int, w: [str]):
  cmd = w[0]
  k = w.len()
  kind = 0
  if (cmd == "BUY" or cmd == "SELL") and k == 4 and goodid(w[1]) and goodq(w[2]) and goodp(w[3]): kind = 1
  elif (cmd == "MBUY" or cmd == "MSELL") and k == 3 and goodid(w[1]) and goodq(w[2]): kind = 2
  elif cmd == "CANCEL" and k == 2 and goodid(w[1]): kind = 3
  elif cmd == "BOOK" and k == 1: kind = 4
  if kind == 0:
    print("ERR line {n}: bad command")
    return
  if kind == 4:
    print("asks")
    side(false)
    print("bids")
    side(true)
    return
  id = w[1]
  if kind == 3:
    idx = -1
    for i in 0..book.len():
      if book[i].id == id: idx = i
    if idx < 0:
      print("ERR line {n}: unknown ID")
    else:
      print("CANCELLED {id} {book[idx].qty}")
      book.remove(idx)
    return
  if seen.has(id):
    print("ERR line {n}: duplicate ID")
    return
  seen[id] = 1
  buy = cmd == "BUY" or cmd == "MBUY"
  q = w[2].int()
  limit = kind == 1
  lp = if limit: w[3].dec() else: 0.dec()
  rem = run_match(id, buy, q, limit, lp)
  if rem > 0:
    if limit:
      seqn += 1
      book.push(Order(id, buy, rem, lp, seqn))
    else:
      print("DROPPED {id} {rem}")

n = 0
for line in lines():
  n += 1
  w = line.words()
  if w.is_empty(): continue
  handle(n, w)
print("volume {vol} value {val.fmt(2)}")
