use "graph.bv"

fn is_ready(tasks: [Task], idx: {str: int}, sch: [bool], en: [int], t: int, u: int) -> bool:
  for d in tasks[u].deps:
    p = idx[d]
    if not sch[p] or en[p] > t: return false
  return true

fn plan_workers(tasks: [Task], k: int) -> [str]:
  n = tasks.len()
  idx = index_of_tasks(tasks)
  succ = successors(tasks, idx)
  order = topo(tasks)
  tl = []
  for i in 0..n:
    tl.push(0)
  for u in order.rev():
    best = 0
    for s in succ[u]:
      best = max(best, tl[s])
    tl[u] = tasks[u].days + best
  sch = []
  st = []
  en = []
  for i in 0..n:
    sch.push(false)
    st.push(0)
    en.push(0)
  running = []
  free = k
  done = 0
  t = 0
  while done < n:
    keep = []
    for r in running:
      if en[r] == t:
        free += 1
      else:
        keep.push(r)
    running = keep
    while free > 0:
      best = -1
      for u in 0..n:
        if not sch[u] and is_ready(tasks, idx, sch, en, t, u):
          if best < 0 or tl[u] > tl[best]: best = u
      if best < 0: break
      sch[best] = true
      st[best] = t
      en[best] = t + tasks[best].days
      running.push(best)
      free -= 1
      done += 1
    if done >= n: break
    if running.len() == 0: break
    nxt = en[running[0]]
    for r in running:
      nxt = min(nxt, en[r])
    t = nxt
  L = 0
  for i in 0..n:
    L = max(L, en[i])
  lines = ["workers " + str(k)]
  for i in 0..n:
    lines.push("  {tasks[i].name} {st[i]}-{en[i]}")
  lines.push("length " + str(L))
  return lines
