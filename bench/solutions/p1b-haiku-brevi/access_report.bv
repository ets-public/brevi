pat = "^(\S+) - - \[([^\]]+)\] \"(\S+) (\S+) [^\"]*\" (\d{3}) (\d+|-) \"[^\"]*\" \"([^\"]*)\"$"
requests = 0
malformed = 0
total = 0
ips = {}
status = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full(pat)
  if m.is_empty():
    malformed += 1
    continue
  requests += 1
  total += m[6].int().or(0)
  ips[m[1]] = true
  status[m[5].slice(0, 1) + "xx"] += 1
  paths[m[4].split("?")[0]] += 1
  hours[m[2].split(":")[1]] += 1
  if m[7].lower().contains("bot"):
    bots += 1
  if m[5].int().or(0) >= 400:
    errs[m[1]] += 1
print("requests {requests}")
print("malformed {malformed}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for c in ["2xx", "3xx", "4xx", "5xx"]:
  if status.has(c):
    print("  {c} {status[c]}")
print("top_paths")
ranked = paths.pairs().sort_by(p => (-p.1, p.0))
for t in ranked.take(3):
  print("  {t.1} {t.0}")
print("hours")
hmax = hours.values().max().or(1)
for h in sorted(hours.keys()):
  n = hours[h]
  bar = "#".repeat(max(1, (n * 40 + hmax) // (2 * hmax)))
  print("  {h} {n} {bar}")
print("bots {bots}")
print("errors_by_ip")
eranked = [p for p in errs.pairs() if p.1 >= 2].sort_by(p => (-p.1, p.0))
for t in eranked:
  print("  {t.0} {t.1}")
