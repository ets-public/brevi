type Task:
  name: str
  days: int
  deps: [str]

fn valid_name(s: str) -> bool:
  if not s.re_full("\w+"): return False
  return True

fn parse_task(raw: str, n: int) -> Task:
  ws = raw.words()
  if len(ws) < 2 or not valid_name(ws[0]) or not ws[1].re_full("\d+"): fail("line {n}: bad line")
  days = ws[1].int()
  if days < 1: fail("line {n}: bad line")
  deps = []
  if len(ws) > 2:
    if len(ws) < 4 or ws[2] != "after": fail("line {n}: bad line")
    rest = ws.slice(3, len(ws)).join(" ")
    for part in rest.split(","):
      nm = part.trim()
      if not valid_name(nm): fail("line {n}: bad line")
      deps.push(nm)
  return Task(name: ws[0], days: days, deps: deps)

fn load(ls: [str]) -> (int, [Task]):
  ks = -1
  tasks = []
  seen = {}
  for i in 0..len(ls):
    ws = ls[i].words()
    if len(ws) == 0: continue
    n = i + 1
    if ks < 0:
      if len(ws) != 2 or ws[0] != "workers" or not ws[1].re_full("\d+"): fail("line {n}: bad line")
      if ws[1].int() < 1: fail("line {n}: bad line")
      ks = ws[1].int()
      continue
    t = parse_task(ls[i], n)
    if seen.has(t.name): fail("line {n}: duplicate {t.name}")
    seen[t.name] = True
    tasks.push(t)
  if ks < 0: fail("line 1: bad line")
  for t in tasks:
    for d in t.deps:
      if not seen.has(d): fail("unknown {d}")
  return (ks, tasks)

fn dep_index(tasks: [Task]) -> [[int]]:
  ix = {}
  for i in 0..len(tasks):
    ix[tasks[i].name] = i
  out = []
  for t in tasks:
    di = []
    for d in t.deps:
      di.push(ix[d])
    out.push(di)
  return out

fn starts(tasks: [Task], dep_ix: [[int]]) -> ([int], [int], int):
  n = len(tasks)
  st = []
  en = []
  done = []
  for i in 0..n:
    st.push(0)
    en.push(0)
    done.push(False)
  cnt = 0
  while cnt < n:
    progress = False
    for i in 0..n:
      if not done[i]:
        ready = True
        s = 0
        for j in dep_ix[i]:
          if not done[j]: ready = False
          elif en[j] > s: s = en[j]
        if ready:
          st[i] = s
          en[i] = s + tasks[i].days
          done[i] = True
          cnt += 1
          progress = True
    if not progress: fail("cycle")
  total = 0
  for e in en:
    if e > total: total = e
  return (st, en, total)

fn tails(tasks: [Task], dep_ix: [[int]]) -> [int]:
  n = len(tasks)
  af = []
  for i in 0..n:
    af.push(0)
  for rep in 0..n:
    for i in 0..n:
      for j in dep_ix[i]:
        v = tasks[i].days + af[i]
        if v > af[j]: af[j] = v
  tl = []
  for i in 0..n:
    tl.push(tasks[i].days + af[i])
  return tl

fn critical_chain(dep_ix: [[int]], st: [int], en: [int], tl: [int], total: int) -> [int]:
  n = len(st)
  chain = []
  cur = -1
  for i in 0..n:
    if cur < 0 and st[i] == 0 and st[i] + tl[i] == total: cur = i
  if cur < 0: return chain
  chain.push(cur)
  while en[cur] < total:
    nxt = -1
    for i in 0..n:
      if nxt < 0 and st[i] == en[cur] and st[i] + tl[i] == total and dep_ix[i].contains(cur): nxt = i
    if nxt < 0: break
    chain.push(nxt)
    cur = nxt
  return chain
