owners = []
bal = []

fn acct(i: int) -> str = str({"id": i, "owner": owners[i - 1], "balance": bal[i - 1]})

fn amt(j: Json) -> int = match j["amount"]:
  Num(n) => if n >= 1.0 and n == n.floor(): n.int() else: 0
  _ => 0

fn idnum(s: str) -> int:
  if s.is_empty(): return 0
  if not s.is_digit(): return 0
  s.int().or(0)

fn handle(line: str) -> str:
  parts = line.split(" ")
  method = parts[0]
  path = if parts.len() > 1: parts[1] else: ""
  hasbody = parts.len() > 2
  body = " ".join(parts.skip(2))
  seg = path.split("/")
  kind = ""
  id = 0
  if method == "GET" and path == "/accounts": kind = "list"
  elif method == "POST" and path == "/accounts": kind = "create"
  elif method == "POST" and path == "/transfer": kind = "transfer"
  elif seg.len() == 3 and seg[0] == "" and seg[1] == "accounts" and method == "GET" and idnum(seg[2]) > 0:
    kind = "get"
    id = idnum(seg[2])
  elif seg.len() == 4 and seg[0] == "" and seg[1] == "accounts" and method == "POST" and idnum(seg[2]) > 0 and (seg[3] == "deposit" or seg[3] == "withdraw"):
    kind = seg[3]
    id = idnum(seg[2])
  if kind == "":
    return '404 {"error":"not found"}'
  if kind == "list":
    ids = (1..owners.len() + 1).sort_by(i => (-bal[i - 1], i))
    return "200 [" + ",".join([acct(i) for i in ids]) + "]"
  if kind == "get":
    if id > owners.len(): return '404 {"error":"no such account"}'
    return "200 " + acct(id)
  ok = hasbody
  j = json("{}")
  if hasbody:
    match json(body):
      Ok(v) => j = v
      Err(m) => ok = false
  if not ok:
    return '400 {"error":"bad json"}'
  if kind == "create":
    o = match j["owner"]:
      Str(s) => s
      _ => ""
    if o.is_empty(): return '400 {"error":"owner required"}'
    owners.push(o)
    bal.push(0)
    return "201 " + acct(owners.len())
  if kind == "transfer":
    f = j["from"].int()
    t = j["to"].int()
    if f < 1 or f > owners.len() or t < 1 or t > owners.len(): return '404 {"error":"no such account"}'
    if f == t: return '400 {"error":"same account"}'
    a = amt(j)
    if a <= 0: return '400 {"error":"bad amount"}'
    if a > bal[f - 1]: return '409 {"error":"insufficient funds"}'
    bal[f - 1] -= a
    bal[t - 1] += a
    return '200 {"from":{bal[f - 1]},"to":{bal[t - 1]}}'
  if id > owners.len(): return '404 {"error":"no such account"}'
  a = amt(j)
  if a <= 0: return '400 {"error":"bad amount"}'
  if kind == "deposit":
    bal[id - 1] += a
  else:
    if a > bal[id - 1]: return '409 {"error":"insufficient funds"}'
    bal[id - 1] -= a
  "200 " + acct(id)

for line in lines():
  if line.trim().is_empty(): continue
  print(handle(line.trim()))
