reqs = 0
bad = 0
total_bytes = 0
ips: {str: int} = {}
classes: {int: int} = {}
paths: {str: int} = {}
hours: {str: int} = {}
bots = 0
errs: {str: int} = {}

for line in lines():
  if line.trim().is_empty(): continue
  parts = line.split("\"")
  ok = parts.len() == 7
  pre = []
  rq = []
  mid = []
  if ok:
    pre = parts[0].words()
    rq = parts[1].words()
    mid = parts[2].words()
    ok = pre.len() == 5 and pre[1] == "-" and pre[2] == "-" and pre[3].starts_with("[") and pre[4].ends_with("]") and rq.len() == 3 and mid.len() == 2
  if ok:
    ok = mid[0].is_digit() and (mid[1].is_digit() or mid[1] == "-") and pre[3].split(":").len() >= 2
  if !ok:
    bad += 1
    continue
  reqs += 1
  status = mid[0].int().or(0)
  size = if mid[1] == "-": 0 else: mid[1].int().or(0)
  total_bytes += size
  ips[pre[0]] += 1
  classes[status // 100] += 1
  p = rq[1]
  q = p.find("?")
  if q >= 0: p = p.slice(0, q)
  paths[p] += 1
  hours[pre[3].split(":")[1]] += 1
  if parts[5].lower().contains("bot"): bots += 1
  if status >= 400: errs[pre[0]] += 1

print("requests {reqs}")
print("malformed {bad}")
print("bytes {total_bytes}")
print("unique_ips {ips.len()}")
print("status")
for (c, n) in classes.pairs(): print("  {c}xx {n}")
print("top_paths")
for (p, n) in paths.pairs().sort_by(x => (-x.1, x.0)).take(3): print("  {n} {p}")
print("hours")
mx = hours.values().max().or(1)
for (h, n) in hours.pairs():
  b = max(1, (40 * n + mx) // (2 * mx))
  print("  {h} {n} " + "#".repeat(b))
print("bots {bots}")
print("errors_by_ip")
for (ip, n) in errs.pairs().filter(x => x.1 >= 2).sort_by(x => (-x.1, x.0)): print("  {ip} {n}")
