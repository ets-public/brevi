fn main() {
  rows = csv(stdin())
  var totals: {str: dec} = {}
  for r in rows.skip(1) {
    if r.len() < 3 {
      continue
    }
    item = r[0].trim()
    qty = r[1].trim().dec()
    price = r[2].trim().dec()
    v = qty * price
    totals[item] = totals.get_or(item, "0".dec()) + v
  }
  var pairs: [(str, dec)] = []
  for (k, v) in totals.pairs() {
    pairs.push((k, v))
  }
  pairs = pairs.sort_by(p => (-p.1, p.0))
  for p in pairs {
    print("{p.0}: {p.1.fmt(2)}")
  }
}
