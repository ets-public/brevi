var indeg: {str: int} = {}
var adj: {str: [str]} = {}

for line in lines() {
  if line.trim() != "" {
    parts = line.split("->")
    a = parts[0].trim()
    b = parts[1].trim()
    if !indeg.has(a) {
      indeg[a] = 0
    }
    if !indeg.has(b) {
      indeg[b] = 0
    }
    adj[a].push(b)
    indeg[b] += 1
  }
}

var out: [str] = []
var going = true
while going {
  pick = ""
  for n in indeg.keys() {
    if pick == "" and indeg[n] == 0 {
      pick = n
    }
  }
  if pick == "" {
    going = false
  } else {
    out.push(pick)
    indeg[pick] = -1
    for m in adj.get_or(pick, []) {
      indeg[m] -= 1
    }
  }
}

if out.len() < indeg.len() {
  print("cycle")
} else {
  for n in out {
    print(n)
  }
}
