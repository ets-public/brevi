let rows = csv(stdin())
var tot: {str: dec} = {}
var i = 0
for r in rows {
  i += 1
  if i == 1 or r.len() < 3 { continue }
  let q = r[1].trim().int()?
  let p = r[2].trim().dec()?
  let v = q.dec() * p
  if !tot.has(r[0]) { tot[r[0]] = "0".dec()? }
  tot[r[0]] = tot[r[0]] + v
}
var ps: [(str, dec)] = []
for (k, v) in tot.pairs() { ps.push((k, v)) }
ps = ps.sort_by(p => (0.dec() - p.1, p.0))
for (k, v) in ps { print("{k}: {v.fmt(2)}") }
