var indeg: {str: int} = {}
var adj: {str: [str]} = {}
for line in lines() {
  if line.trim().is_empty() { continue }
  let p = line.split(" -> ")
  let a = p[0].trim()
  let b = p[1].trim()
  if !indeg.has(a) { indeg[a] = 0 }
  if !indeg.has(b) { indeg[b] = 0 }
  indeg[b] += 1
  adj[a].push(b)
}
var avail: [str] = []
for (k, v) in indeg.pairs() {
  if v == 0 { avail.push(k) }
}
var out: [str] = []
while !avail.is_empty() {
  avail = avail.sort()
  let n = avail.remove(0)
  out.push(n)
  for m in adj.get_or(n, []) {
    indeg[m] -= 1
    if indeg[m] == 0 { avail.push(m) }
  }
}
if out.len() < indeg.len() { print("cycle") } else {
  for x in out { print(x) }
}
