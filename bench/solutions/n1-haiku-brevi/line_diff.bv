ls = lines()
sep = ls.index_of("=====")
old = ls[0:sep]
new = ls[sep + 1:]
n = old.len()
m = new.len()
if old == new:
  print("no changes")
else:
  n1 = n + 1
  m1 = m + 1
  L = []
  for i in 0..n1:
    L.push([0].repeat(m1))
  for ii in (0..n).rev():
    for jj in (0..m).rev():
      if old[ii] == new[jj]:
        L[ii][jj] = L[ii + 1][jj + 1] + 1
      else:
        L[ii][jj] = max(L[ii + 1][jj], L[ii][jj + 1])
  out = []
  i = 0
  j = 0
  rem = 0
  adds = 0
  while i < n and j < m:
    if old[i] == new[j]:
      out.push("  " + old[i])
      i += 1
      j += 1
    elif L[i + 1][j] >= L[i][j + 1]:
      out.push("- " + old[i])
      rem += 1
      i += 1
    else:
      out.push("+ " + new[j])
      adds += 1
      j += 1
  while i < n:
    out.push("- " + old[i])
    rem += 1
    i += 1
  while j < m:
    out.push("+ " + new[j])
    adds += 1
    j += 1
  for o in out:
    print(o)
  print("@@ -{rem} +{adds} @@")
