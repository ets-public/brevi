names = []
bals = []

fn acct(i: int) -> str:
  "\{\"id\":{i},\"owner\":\"{names[i - 1]}\",\"balance\":{bals[i - 1]}\}"

fn isnum(s: str) -> bool:
  s.len() > 0 and all(c.is_digit() for c in s.chars())

fn exists(i: int) -> bool:
  i >= 1 and i <= names.len()

fn jok(body: str) -> bool:
  if body.trim().is_empty(): return true
  match json(body):
    Ok(_) => true
    Err(_) => false

fn parse(body: str) -> Json:
  if body.trim().is_empty(): return json("{}")
  json(body)

fn owner_of(j: Json) -> str:
  v = j["owner"]
  match v:
    Str(s) => s
    _ => ""

fn amt_int(n: f64) -> int:
  if n > 0.0 and n == n.floor(): return n.int()
  return -1

fn amount_of(j: Json) -> int:
  v = j["amount"]
  match v:
    Num(n) => amt_int(n)
    _ => -1

fn id_int(n: f64) -> int:
  if n > 0.0 and n == n.floor(): return n.int()
  return 0

fn id_of(j: Json) -> int:
  v = j["from"]
  match v:
    Num(n) => id_int(n)
    _ => 0

fn id_of_to(j: Json) -> int:
  v = j["to"]
  match v:
    Num(n) => id_int(n)
    _ => 0

fn list_all() -> str:
  ord_keys = []
  for k in 0..names.len():
    ord_keys.push((0 - bals[k], k + 1))
  ord_keys.sort()
  items = []
  for p in ord_keys:
    items.push(acct(p.1))
  "200 [" + items.join(",") + "]"

fn show(idtxt: str) -> str:
  if not isnum(idtxt): return "404 \{\"error\":\"not found\"\}"
  i = idtxt.int().or(0)
  if not exists(i): return "404 \{\"error\":\"no such account\"\}"
  "200 " + acct(i)

fn create(body: str) -> str:
  if not jok(body): return "400 \{\"error\":\"bad json\"\}"
  j = parse(body)
  nm = owner_of(j)
  if nm.is_empty(): return "400 \{\"error\":\"owner required\"\}"
  names.push(nm)
  bals.push(0)
  "201 " + acct(names.len())

fn change(idtxt: str, op: str, body: str) -> str:
  if not isnum(idtxt): return "404 \{\"error\":\"not found\"\}"
  if not jok(body): return "400 \{\"error\":\"bad json\"\}"
  j = parse(body)
  i = idtxt.int().or(0)
  if not exists(i): return "404 \{\"error\":\"no such account\"\}"
  amt = amount_of(j)
  if amt <= 0: return "400 \{\"error\":\"bad amount\"\}"
  if op == "deposit":
    bals[i - 1] = bals[i - 1] + amt
    return "200 " + acct(i)
  if amt > bals[i - 1]: return "409 \{\"error\":\"insufficient funds\"\}"
  bals[i - 1] = bals[i - 1] - amt
  "200 " + acct(i)

fn transfer(body: str) -> str:
  if not jok(body): return "400 \{\"error\":\"bad json\"\}"
  j = parse(body)
  fi = id_of(j)
  ti = id_of_to(j)
  if not exists(fi) or not exists(ti): return "404 \{\"error\":\"no such account\"\}"
  if fi == ti: return "400 \{\"error\":\"same account\"\}"
  amt = amount_of(j)
  if amt <= 0: return "400 \{\"error\":\"bad amount\"\}"
  if amt > bals[fi - 1]: return "409 \{\"error\":\"insufficient funds\"\}"
  bals[fi - 1] = bals[fi - 1] - amt
  bals[ti - 1] = bals[ti - 1] + amt
  "200 \{\"from\":{bals[fi - 1]},\"to\":{bals[ti - 1]}\}"

fn respond(line: str) -> str:
  parts = line.split(" ")
  meth = parts[0]
  path = if parts.len() > 1: parts[1] else: ""
  body = parts[2:].join(" ")
  segs = path.split("/")
  if path == "/accounts" and meth == "GET":
    return list_all()
  if path == "/accounts" and meth == "POST":
    return create(body)
  if path == "/transfer" and meth == "POST":
    return transfer(body)
  if segs.len() == 3 and segs[0] == "" and segs[1] == "accounts" and meth == "GET":
    return show(segs[2])
  if segs.len() == 4 and segs[0] == "" and segs[1] == "accounts" and meth == "POST" and (segs[3] == "deposit" or segs[3] == "withdraw"):
    return change(segs[2], segs[3], body)
  "404 \{\"error\":\"not found\"\}"

for line in lines():
  if line.trim().is_empty(): continue
  print(respond(line))
