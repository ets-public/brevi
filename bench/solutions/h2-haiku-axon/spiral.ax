fn main() {
  ls = stdin().lines()
  dims = ls[0].ints()
  r = dims[0]
  c = dims[1]
  m = []
  for i in 0..r { m.push(ls[i + 1].ints()) }
  out = []
  top = 0
  bot = r - 1
  left = 0
  right = c - 1
  while top <= bot and left <= right {
    for j in left..(right + 1) { out.push(m[top][j]) }
    top += 1
    for i in top..(bot + 1) { out.push(m[i][right]) }
    right -= 1
    if top <= bot {
      j = right
      while j >= left {
        out.push(m[bot][j])
        j -= 1
      }
      bot -= 1
    }
    if left <= right {
      i = bot
      while i >= top {
        out.push(m[i][left])
        i -= 1
      }
      left += 1
    }
  }
  print(out.map(x => str(x)).join(" "))
  sums = []
  for j in 0..c {
    s = 0
    for i in 0..r { s += m[i][j] }
    sums.push(str(s))
  }
  print(sums.join(" "))
}
