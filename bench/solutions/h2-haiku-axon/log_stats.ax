fn main() {
  groups: {str: [int]} = {}
  errs: {str: int} = {}
  for line in stdin().lines() {
    parts = line.words()
    if parts.is_empty() { continue }
    path = parts[1]
    status = parts[2].int().or(0)
    ms = parts[3].int().or(0)
    groups[path].push(ms)
    if status >= 500 { errs[path] += 1 }
  }
  for p in groups.keys().sort() {
    xs = groups[p].sort()
    n = xs.len()
    avg = xs.sum().float() / n.float()
    k = (9 * n + 9) / 10
    p90 = xs[k - 1]
    e = errs.get_or(p, 0).float() * 100.0 / n.float()
    print("{p} {n} {avg.fmt(1)} {p90} {e.fmt(1)}%")
  }
}
