owners = []
bals = []

fn acct(i: int) = '{"id":{i},"owner":{str(owners[i - 1].json())},"balance":{bals[i - 1]}}'

fn exists(i: int) = i >= 1 and i <= owners.len()

fn amount_of(j: Json) -> int:
  match j["amount"]:
    Num(n) => if n > 0.0 and n.floor() == n: n.int() else: 0
    _ => 0

fn idnum(s: str) -> int:
  if s.is_empty() or not s.is_digit(): return -1
  s.int().or(-1)

fn handle(line: str) -> str:
  sp = line.find(" ")
  method = line
  rest = ""
  if sp >= 0:
    method = line[:sp]
    rest = line.slice(sp + 1)
  sp2 = rest.find(" ")
  path = rest
  body = ""
  if sp2 >= 0:
    path = rest[:sp2]
    body = rest.slice(sp2 + 1).trim()
  parts = path.split("/")
  # route kinds: 0 notfound, 1 create, 2 get, 3 deposit, 4 withdraw, 5 transfer, 6 list
  kind = 0
  id = -1
  if method == "POST" and path == "/accounts": kind = 1
  elif method == "GET" and path == "/accounts": kind = 6
  elif method == "POST" and path == "/transfer": kind = 5
  elif parts.len() == 3 and parts[0] == "" and parts[1] == "accounts" and idnum(parts[2]) >= 0 and method == "GET":
    kind = 2
    id = idnum(parts[2])
  elif parts.len() == 4 and parts[0] == "" and parts[1] == "accounts" and idnum(parts[2]) >= 0 and method == "POST" and parts[3] == "deposit":
    kind = 3
    id = idnum(parts[2])
  elif parts.len() == 4 and parts[0] == "" and parts[1] == "accounts" and idnum(parts[2]) >= 0 and method == "POST" and parts[3] == "withdraw":
    kind = 4
    id = idnum(parts[2])
  if kind == 0: return '404 {"error":"not found"}'
  if kind == 6:
    order = [i for i in 1..owners.len() + 1].sort_by(i => (-bals[i - 1], i))
    return "200 [" + ", ".join([acct(i) for i in order]).replace(", ", ",") + "]"
  if kind == 2:
    if not exists(id): return '404 {"error":"no such account"}'
    return "200 " + acct(id)
  j = json("null")
  if kind != 2:
    match json(body):
      Ok(v) => j = v
      Err(m) => return '400 {"error":"bad json"}'
  if kind == 1:
    match j["owner"]:
      Str(s) =>
        if s.is_empty(): return '400 {"error":"owner required"}'
        owners.push(s)
        bals.push(0)
        return "201 " + acct(owners.len())
      _ => return '400 {"error":"owner required"}'
  if kind == 3 or kind == 4:
    if not exists(id): return '404 {"error":"no such account"}'
    amt = amount_of(j)
    if amt <= 0: return '400 {"error":"bad amount"}'
    if kind == 4 and amt > bals[id - 1]: return '409 {"error":"insufficient funds"}'
    if kind == 3: bals[id - 1] += amt
    else: bals[id - 1] -= amt
    return "200 " + acct(id)
  a = j["from"].int()
  b = j["to"].int()
  if not exists(a) or not exists(b): return '404 {"error":"no such account"}'
  if a == b: return '400 {"error":"same account"}'
  amt = amount_of(j)
  if amt <= 0: return '400 {"error":"bad amount"}'
  if amt > bals[a - 1]: return '409 {"error":"insufficient funds"}'
  bals[a - 1] -= amt
  bals[b - 1] += amt
  '200 {"from":{bals[a - 1]},"to":{bals[b - 1]}}'

for line in lines():
  if line.trim().is_empty(): continue
  print(handle(line.trim()))
