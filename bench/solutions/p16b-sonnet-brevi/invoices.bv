data = json(stdin())
prods = data["products"]
custs = data["customers"]
outs = []
revenue = 0.dec()
for o in data["orders"]:
  idj = str(o["id"])
  cid = o["customer"].text()
  if not custs.has(cid):
    outs.push('{"id":{idj},"error":"unknown customer {cid}"}')
    continue
  cust = custs[cid]
  bad = ""
  for l in o["lines"]:
    sku = l["sku"].text()
    if not prods.has(sku) and bad == "": bad = sku
  if bad != "":
    outs.push('{"id":{idj},"error":"unknown sku {bad}"}')
    continue
  sub = 0.dec()
  catsum = {}
  catqty = {}
  for l in o["lines"]:
    p = prods[l["sku"].text()]
    amt = p["price"].text().dec() * l["qty"].int()
    sub += amt
    c = p["category"].text()
    catsum[c] += amt
    catqty[c] += l["qty"].int()
  disc = 0.dec()
  for c, q in catqty.pairs():
    if q >= 3:
      disc += (catsum[c] * "0.05".dec()).round(2)
  tier = cust["tier"].text()
  rate = 0.dec()
  if tier == "gold": rate = "0.10".dec()
  elif tier == "silver": rate = "0.05".dec()
  disc += ((sub - disc) * rate).round(2)
  net = sub - disc
  country = cust["country"].text()
  trate = 0.dec()
  if country == "UK": trate = "0.20".dec()
  elif country == "US": trate = "0.0825".dec()
  tax = (net * trate).round(2)
  total = net + tax
  revenue += total
  outs.push('{"id":{idj},"customer":{str(cust["name"])},"subtotal":"{sub.fmt(2)}","discount":"{disc.fmt(2)}","tax":"{tax.fmt(2)}","total":"{total.fmt(2)}"}')
print("[" + ",".join(outs) + "]")
print("revenue {revenue.fmt(2)}")
