lots = {}
seen = {}
cogs = {}
rev = {}
prof = {}
loss = {}
mprof = {}
mloss = {}
latest = ""

fn have(sku: str) -> int:
  n = 0
  for l in lots[sku]: n += l.0
  n

fn take(sku: str, q: int) -> dec:
  cost = 0.dec()
  rem = q
  nl = []
  for l in lots[sku]:
    if rem == 0:
      nl.push(l)
    elif l.0 <= rem:
      cost += l.1 * l.0
      rem -= l.0
    else:
      cost += l.1 * rem
      nl.push((l.0 - rem, l.1))
      rem = 0
  lots[sku] = nl
  cost

fn valid_date(s: str) -> bool:
  if s.re_full("\d{4}-\d{2}-\d{2}").len() == 0: return false
  m = s.slice(5, 7).int().or(0)
  d = s.slice(8, 10).int().or(0)
  m >= 1 and m <= 12 and d >= 1 and d <= 31

fn is_qty(s: str) -> bool = s.re_full("\d+").len() > 0 and s.int().or(0) >= 1

fn is_price(s: str) -> bool = s.re_full("\d+(\.\d{1,2})?").len() > 0

no = 0
for line in lines():
  no += 1
  w = line.words()
  if w.is_empty(): continue
  ok = false
  if w.len() >= 4 and valid_date(w[0]) and is_qty(w[3 - 1 + 0]) == false:
    ok = false
  op = if w.len() > 1: w[1] else: ""
  good = false
  if op == "RECEIVE" or op == "SHIP":
    good = w.len() == 5 and valid_date(w[0]) and is_qty(w[3]) and is_price(w[4])
  elif op == "LOSS":
    good = w.len() == 4 and valid_date(w[0]) and is_qty(w[3])
  if not good:
    print("line {no}: bad line")
    continue
  if w[0] < latest:
    print("line {no}: date out of order")
    continue
  sku = w[2]
  q = w[3].int().or(0)
  month = w[0].slice(0, 7)
  if op == "RECEIVE":
    lots[sku].push((q, w[4].dec().or(0.dec())))
    seen[sku] = 1
  else:
    h = if lots.has(sku): have(sku) else: 0
    if h < q:
      print("line {no}: short {sku} need {q} have {h}")
      continue
    c = take(sku, q)
    if op == "SHIP":
      r = w[4].dec().or(0.dec()) * q
      cogs[sku] += c
      rev[sku] += r
      prof[sku] += r - c
      mprof[month] += r - c
      mloss[month] += 0.dec()
    else:
      loss[sku] += c
      mloss[month] += c
      mprof[month] += 0.dec()
  latest = w[0]

total_p = 0.dec()
total_l = 0.dec()
for sku in seen.keys():
  v = 0.dec()
  oh = 0
  for l in lots[sku]:
    v += l.1 * l.0
    oh += l.0
  print("{sku} on_hand {oh} value {v.fmt(2)} cogs {cogs[sku].fmt(2)} revenue {rev[sku].fmt(2)} profit {prof[sku].fmt(2)} loss {loss[sku].fmt(2)}")
  total_p += prof[sku]
  total_l += loss[sku]
print("months")
for m in mprof.keys():
  print("  {m} profit {mprof[m].fmt(2)} loss {mloss[m].fmt(2)}")
print("total profit {total_p.fmt(2)} loss {total_l.fmt(2)} net {(total_p - total_l).fmt(2)}")
