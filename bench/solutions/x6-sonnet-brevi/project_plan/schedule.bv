use "graph.bv"

fn schedule(tasks: [Task], k: int) -> ([int], [int]):
  idx = index_of_names(tasks)
  n = tasks.len()
  tl = tails(tasks)
  st = [-1].repeat(n)
  en = [-1].repeat(n)
  t = 0
  started = 0
  while started < n:
    running = 0
    for i in 0..n:
      if st[i] >= 0 and en[i] > t: running += 1
    while running < k:
      best = -1
      for i in 0..n:
        if st[i] < 0:
          ready = true
          for d in tasks[i].deps:
            j = idx[d]
            if st[j] < 0 or en[j] > t: ready = false
          if ready and (best < 0 or tl[i] > tl[best]): best = i
      if best < 0: break
      st[best] = t
      en[best] = t + tasks[best].days
      started += 1
      running += 1
    nt = -1
    for i in 0..n:
      if st[i] >= 0 and en[i] > t and (nt < 0 or en[i] < nt): nt = en[i]
    if nt < 0: break
    t = nt
  (st, en)
