rows = csv(stdin())
totals: {str: dec} = {}
for r in rows.slice(1, rows.len()) {
  if r.len() < 3 {
    continue
  }
  item = r[0]
  v = r[1].int().or(0).dec() * r[2].dec()
  if totals.has(item) {
    totals[item] = totals[item] + v
  } else {
    totals[item] = v
  }
}
pairs: [(dec, str)] = []
for (k, v) in totals.pairs() {
  pairs.push((v, k))
}
pairs = pairs.sort_by(p => (-p.0, p.1))
for p in pairs {
  print(p.1 + ": " + p.0.fmt(2))
}
