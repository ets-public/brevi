pairs: [(int, int)] = []
for line in lines() {
  if line.trim() == "" {
    continue
  }
  nums = line.ints()
  pairs.push((nums[0], nums[1]))
}
pairs = pairs.sort()

ms: [(int, int)] = []
for p in pairs {
  if ms.is_empty() {
    ms.push(p)
  } else {
    last = ms.last()
    if p.0 <= last.1 {
      ms.pop()
      ms.push((last.0, max(last.1, p.1)))
    } else {
      ms.push(p)
    }
  }
}

total = 0
for m in ms {
  print("{m.0} {m.1}")
  total += m.1 - m.0
}
print("total {total}")
