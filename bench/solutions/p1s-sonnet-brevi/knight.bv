ls = lines()
n = ls[0].int()
fn sq(s: str) -> (int, int) = (s.code() - 97, s.slice(1).int() - 1)
moves = [(1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1)]
for l in ls.skip(1):
  w = l.words()
  if w.len() < 2: continue
  s = sq(w[0])
  t = sq(w[1])
  dist = {}
  dist[s] = 0
  q = [s]
  qi = 0
  while qi < q.len():
    u = q[qi]
    qi += 1
    for m in moves:
      v = (u.0 + m.0, u.1 + m.1)
      if v.0 < 0 or v.1 < 0 or v.0 >= n or v.1 >= n: continue
      if dist.has(v): continue
      dist[v] = dist[u] + 1
      q.push(v)
  if dist.has(t): print(dist[t])
  else: print(-1)
