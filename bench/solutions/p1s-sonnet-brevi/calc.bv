toks = []
pos = 0
bad = False
fn peek() -> str:
  if pos < toks.len(): toks[pos] else: ""
fn expr() -> int:
  v = term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = term()
    if op == "+": v += r
    else: v -= r
  v
fn term() -> int:
  v = factor()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = factor()
    if op == "*": v *= r
    elif r == 0: bad = True
    else: v = v / r
  v
fn factor() -> int:
  t = peek()
  pos += 1
  if t == "-": return -factor()
  if t == "(":
    v = expr()
    pos += 1
    return v
  t.int().or(0)
for line in lines():
  if line.trim().is_empty(): continue
  toks = []
  cur = ""
  for c in line.chars():
    if c.is_digit(): cur += c
    else:
      if cur: 
        toks.push(cur)
        cur = ""
      if c != " ": toks.push(c)
  if cur: toks.push(cur)
  pos = 0
  bad = False
  r = expr()
  if bad: print("error")
  else: print(r)
