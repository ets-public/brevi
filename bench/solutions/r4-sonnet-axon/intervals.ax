var iv: [(int, int)] = []
for l in lines() {
  let p = l.ints()?
  if p.len() < 2 { continue }
  iv.push((p[0], p[1]))
}
iv = iv.sort()
var total = 0
var cs = 0
var ce = 0
var have = false
for (s, e) in iv {
  if !have {
    cs = s
    ce = e
    have = true
  } else if s <= ce {
    if e > ce { ce = e }
  } else {
    print("{cs} {ce}")
    total += ce - cs
    cs = s
    ce = e
  }
}
if have {
  print("{cs} {ce}")
  total += ce - cs
}
print("total {total}")
