fn is_red(j: Json) -> bool {
  match j {
    Str(s) => s == "red"
    _ => false
  }
}

fn total(j: Json) -> int {
  match j {
    Num(n) => n.int()
    Arr(xs) => {
      var s = 0
      for x in xs {
        s += total(x)
      }
      s
    }
    Obj(m) => {
      var red = false
      for v in m.values() {
        if is_red(v) { red = true }
      }
      if red {
        0
      } else {
        var s = 0
        for v in m.values() {
          s += total(v)
        }
        s
      }
    }
    _ => 0
  }
}

let doc = json(stdin())?
print(total(doc))
