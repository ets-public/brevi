var toks: [str] = []
var pos = 0

fn tokenize(s: str) -> [str] {
  var out: [str] = []
  var cur = ""
  for c in s.chars() {
    if c.is_digit() {
      cur += c
    } else {
      if cur != "" {
        out.push(cur)
        cur = ""
      }
      if c != " " {
        out.push(c)
      }
    }
  }
  if cur != "" {
    out.push(cur)
  }
  out
}

fn peek() -> str {
  if pos < toks.len() { return toks[pos] }
  ""
}

fn advance() -> str {
  let t = peek()
  pos += 1
  t
}

fn atom() -> int {
  let t = advance()
  if t == "(" {
    let v = expr()?
    advance()
    return v
  }
  if t == "-" {
    let a = atom()?
    return 0 - a
  }
  t.int()?
}

fn term() -> int {
  var v = atom()?
  while peek() == "*" or peek() == "/" {
    let op = advance()
    let r = atom()?
    if op == "*" {
      v = v * r
    } else {
      if r == 0 { fail("division by zero") }
      v = v / r
    }
  }
  v
}

fn expr() -> int {
  var v = term()?
  while peek() == "+" or peek() == "-" {
    let op = advance()
    let r = term()?
    if op == "+" {
      v += r
    } else {
      v -= r
    }
  }
  v
}

for line in lines() {
  if line.trim() != "" {
    toks = tokenize(line)
    pos = 0
    match expr() {
      Ok(v) => print(v)
      Err(m) => print("error")
    }
  }
}
