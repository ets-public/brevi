ls = lines()
rc = ls[0].ints()
R = rc[0]
C = rc[1]
g = []
for i in 0..R: g.push(ls[i + 1].ints())
out = []
top = 0
bot = R - 1
left = 0
right = C - 1
while top <= bot and left <= right:
  for j in left..right + 1: out.push(g[top][j])
  top += 1
  for i in top..bot + 1: out.push(g[i][right])
  right -= 1
  if top <= bot:
    for j in (left..right + 1).rev(): out.push(g[bot][j])
    bot -= 1
  if left <= right:
    for i in (top..bot + 1).rev(): out.push(g[i][left])
    left += 1
print(out.join(" "))
cols = []
for j in 0..C:
  s = 0
  for i in 0..R: s += g[i][j]
  cols.push(s)
print(cols.join(" "))
