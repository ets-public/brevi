dur = {}
deps = {}
names = []
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  names.push(w[0])
  dur[w[0]] = w[1].int()
  if w.len() > 3: deps[w[0]] = w.skip(3)
  else: deps[w[0]] = []
valid = true
for n in names:
  for d in deps[n]:
    if !dur.has(d): valid = false
start = {}
endt = {}
if valid:
  progress = true
  while progress:
    progress = false
    for n in names:
      if endt.has(n): continue
      if deps[n].all(d => endt.has(d)):
        s = deps[n].map(d => endt[d]).max().or(0)
        start[n] = s
        endt[n] = s + dur[n]
        progress = true
  if endt.len() < names.len(): valid = false
if !valid:
  print("invalid")
else:
  rows = names.map(n => (start[n], n))
  rows = rows.sort()
  tot = 0
  for (s, n) in rows:
    print("{n} {s} {endt[n]}")
    tot = max(tot, endt[n])
  print("total {tot}")
