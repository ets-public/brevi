indeg = {}
adj = {}
for line in lines():
  p = line.split("->").map(x => x.trim())
  if p.len() < 2: continue
  a = p[0]
  b = p[1]
  if !indeg.has(a): indeg[a] = 0
  if !indeg.has(b): indeg[b] = 0
  adj[a].push(b)
  indeg[b] += 1
h = heap()
for (k, v) in indeg.pairs():
  if v == 0: h.push(k)
out = []
while !h.is_empty():
  n = h.pop()
  out.push(n)
  for m in adj[n]:
    indeg[m] -= 1
    if indeg[m] == 0: h.push(m)
if out.len() < indeg.len():
  print("cycle")
else:
  for x in out: print(x)
