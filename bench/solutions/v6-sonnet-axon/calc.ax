cs: [str] = []
pos = 0
fn peek() -> str = if pos < cs.len(): cs[pos] else: ""
fn atom() -> int:
  c = peek()
  if c == "-":
    pos += 1
    return 0 - atom()
  if c == "(":
    pos += 1
    v = expr()
    pos += 1
    return v
  n = 0
  while peek() != "" and peek().is_digit():
    n = n * 10 + peek().digit()
    pos += 1
  n
fn term() -> int:
  v = atom()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = atom()
    if op == "*":
      v = v * r
    else:
      if r == 0: fail("div0")
      v = v / r
  v
fn expr() -> int:
  v = term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  v
for line in lines():
  if line.trim().is_empty(): continue
  cs = line.chars().filter(c => c != " ")
  pos = 0
  match expr():
    Ok(v) => print(v)
    Err(m) => print("error")
