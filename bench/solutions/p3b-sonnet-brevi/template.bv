fn hasseg(j: Json, seg: str) -> bool:
  match j:
    Obj(m) => m.has(seg)
    _ => false
fn walk(j: Json, segs: [str]) -> Json:
  cur = j
  for s in segs:
    cur = cur[s]
  cur
fn lookup(name: str, ctx: [Json], idx: [int]) -> Json:
  if name == ".": return ctx.last()
  if name == "@index":
    if idx: return idx.last().json()
    return Null
  segs = name.split(".")
  for c in ctx.rev():
    if hasseg(c, segs[0]): return walk(c, segs)
  Null
fn truthy(j: Json) -> bool:
  match j:
    Null => false
    Bool(b) => b
    Num(n) => n != 0.0
    Str(s) => not s.is_empty()
    Arr(x) => not x.is_empty()
    Obj(m) => true
fn tostr(j: Json) -> str:
  match j:
    Null => ""
    Str(s) => s
    Bool(b) => if b: "true" else: "false"
    _ => str(j)
fn jlen(j: Json) -> int:
  match j:
    Str(s) => s.len()
    Arr(x) => x.len()
    _ => 0
fn isempty(j: Json) -> bool:
  match j:
    Null => true
    Str(s) => s.is_empty()
    _ => false
fn findend(items: [(str, str)], i: int, hi: int) -> int:
  depth = 0
  for k in i..hi:
    if items[k].0 == "g":
      t = items[k].1
      if t.starts_with("#"): depth += 1
      elif t.starts_with("/"):
        depth -= 1
        if depth == 0: return k
  hi
fn findelse(items: [(str, str)], i: int, e: int) -> int:
  depth = 0
  for k in i..e:
    if items[k].0 == "g":
      t = items[k].1
      if t.starts_with("#"): depth += 1
      elif t.starts_with("/"): depth -= 1
      elif t == "else" and depth == 1: return k
  -1
fn render(items: [(str, str)], lo: int, hi: int, ctx: [Json], idx: [int]) -> str:
  out = ""
  i = lo
  while i < hi:
    kind = items[i].0
    t = items[i].1
    if kind == "t":
      out += t
      i += 1
    elif t.starts_with("#each "):
      e = findend(items, i, hi)
      arr = lookup(t.slice(6).trim(), ctx, idx)
      match arr:
        Arr(xs) =>
          for k, el in xs.enumerate():
            out += render(items, i + 1, e, ctx + [el], idx + [k])
        _ => out += ""
      i = e + 1
    elif t.starts_with("#if "):
      e = findend(items, i, hi)
      el = findelse(items, i, e)
      v = lookup(t.slice(4).trim(), ctx, idx)
      if truthy(v):
        out += render(items, i + 1, if el >= 0: el else: e, ctx, idx)
      elif el >= 0:
        out += render(items, el + 1, e, ctx, idx)
      i = e + 1
    else:
      parts = t.split("|")
      v = lookup(parts[0].trim(), ctx, idx)
      for f in parts.skip(1):
        fn2 = f.trim()
        if fn2 == "upper": v = tostr(v).upper().json()
        elif fn2 == "lower": v = tostr(v).lower().json()
        elif fn2 == "len": v = jlen(v).json()
        elif fn2.starts_with("default:"):
          if isempty(v): v = fn2.slice(8).json()
      out += tostr(v)
      i += 1
  out
text = stdin()
nl = text.find("\n")
root = json(text[:nl])
tpl = text.slice(nl + 1)
texts = tpl.re_split("\{\{.*?\}\}")
tags = [m[1].trim() for m in tpl.re_all("\{\{(.*?)\}\}")]
items = []
for k in 0..texts.len():
  items.push(("t", texts[k]))
  if k < tags.len(): items.push(("g", tags[k]))
res = render(items, 0, items.len(), [root], [])
if res.ends_with("\n"): res = res[:-1]
print(res)
