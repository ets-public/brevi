succ: {str: [str]} = {}
indeg: {str: int} = {}
for l in lines() {
  if l.trim() != "" {
    p = l.split("->")
    a = p[0].trim()
    b = p[1].trim()
    if !indeg.has(a) { indeg[a] = 0 }
    if !indeg.has(b) { indeg[b] = 0 }
    succ[a].push(b)
    indeg[b] += 1
  }
}
h = heap()
for k in indeg.keys() {
  if indeg[k] == 0 { h.push(k) }
}
out: [str] = []
while !h.is_empty() {
  n = h.pop()
  out.push(n)
  for m in succ.get_or(n, []) {
    indeg[m] -= 1
    if indeg[m] == 0 { h.push(m) }
  }
}
if out.len() < indeg.len() {
  print("cycle")
} else {
  for x in out { print(x) }
}
