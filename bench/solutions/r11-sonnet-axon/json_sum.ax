fn isred(j: Json) -> bool = match j {
  Str(s) => s == "red"
  _ => false
}
fn total(j: Json) -> f64 = match j {
  Num(n) => n
  Arr(xs) => xs.map(x => total(x)).sum()
  Obj(m) => if m.values().any(v => isred(v)) { 0.0 } else { m.values().map(x => total(x)).sum() }
  _ => 0.0
}
print(total(json(stdin())).int())
