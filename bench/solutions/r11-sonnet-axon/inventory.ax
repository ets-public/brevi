rows = csv(stdin())
tot: {str: dec} = {}
for r in rows.skip(1) {
  if r.len() >= 3 {
    v = r[1].trim().int().dec() * r[2].trim().dec()
    if tot.has(r[0]) { tot[r[0]] = tot[r[0]] + v } else { tot[r[0]] = v }
  }
}
ps = tot.pairs().sort_by(p => (-p.1.float(), p.0))
for (k, v) in ps { print("{k}: {v.fmt(2)}") }
