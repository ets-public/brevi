store = {}
stack = []
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  cmd = w[0]
  if cmd == "SET" and w.len() >= 3:
    store[w[1]] = w[2]
  elif cmd == "GET" and w.len() >= 2:
    print(if store.has(w[1]): store[w[1]] else: "NULL")
  elif cmd == "DEL" and w.len() >= 2:
    if store.has(w[1]): store.remove(w[1])
    else: print("NOT FOUND")
  elif cmd == "INCR" and w.len() >= 3:
    cur = if store.has(w[1]): store[w[1]] else: "0"
    if cur.re_full("[-+]?\d+").is_empty():
      print("ERR not an integer")
    else:
      nv = cur.int() + w[2].int()
      store[w[1]] = nv.str()
      print(nv)
  elif cmd == "COUNT" and w.len() >= 2:
    print(store.values().count(v => v == w[1]))
  elif cmd == "KEYS" and w.len() >= 2:
    ks = store.keys().filter(k => k.starts_with(w[1])).sort()
    print(if ks: ks.join(" ") else: "(empty)")
  elif cmd == "BEGIN":
    stack.push(store)
  elif cmd == "ROLLBACK":
    if stack: store = stack.pop()
    else: print("NO TRANSACTION")
  elif cmd == "COMMIT":
    if stack: stack = []
    else: print("NO TRANSACTION")
  else:
    print("ERR unknown command")
