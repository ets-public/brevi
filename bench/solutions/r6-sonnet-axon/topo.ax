var indeg: {str: int} = {}
var adj: {str: [str]} = {}
for line in lines() {
  if line.trim().is_empty() { continue }
  let p = line.split("->")
  let a = p[0].trim()
  let b = p[1].trim()
  if !indeg.has(a) { indeg[a] = 0 }
  if !indeg.has(b) { indeg[b] = 0 }
  indeg[b] += 1
  adj[a].push(b)
}
var h = heap()
for k in indeg.keys() {
  if indeg[k] == 0 { h.push(k) }
}
var out: [str] = []
while !h.is_empty() {
  let x = h.pop()
  out.push(x)
  if adj.has(x) {
    for y in adj[x] {
      indeg[y] -= 1
      if indeg[y] == 0 { h.push(y) }
    }
  }
}
if out.len() < indeg.len() { print("cycle") } else {
  for x in out { print(x) }
}
