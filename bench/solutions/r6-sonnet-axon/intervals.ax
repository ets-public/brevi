var iv: [(int, int)] = []
for line in lines() {
  if line.trim().is_empty() { continue }
  let n = line.ints()?
  iv.push((n[0], n[1]))
}
iv = iv.sort()
var cs = 0
var ce = 0
var started = false
var total = 0
for (s, e) in iv {
  if !started {
    cs = s
    ce = e
    started = true
  } else if s <= ce {
    if e > ce { ce = e }
  } else {
    print("{cs} {ce}")
    total += ce - cs
    cs = s
    ce = e
  }
}
if started {
  print("{cs} {ce}")
  total += ce - cs
}
print("total {total}")
