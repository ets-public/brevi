ls = lines()
width = ls[0].trim().int()
paras: [[str]] = []
cur: [str] = []
for line in ls.skip(1):
  ws = line.words()
  if ws.is_empty():
    if !cur.is_empty():
      paras.push(cur)
      cur = []
  else:
    cur = cur + ws
if !cur.is_empty(): paras.push(cur)
first = true
for p in paras:
  if !first: print("")
  first = false
  line = ""
  for w in p:
    if line == "":
      line = w
    elif line.len() + 1 + w.len() <= width:
      line = line + " " + w
    else:
      print(line)
      line = w
  print(line)
