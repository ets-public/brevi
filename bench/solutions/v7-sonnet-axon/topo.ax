indeg: {str: int} = {}
adj: {str: [str]} = {}
for line in lines():
  if line.trim().is_empty(): continue
  parts = line.split("->")
  a = parts[0].trim()
  b = parts[1].trim()
  if !indeg.has(a): indeg[a] = 0
  if !indeg.has(b): indeg[b] = 0
  adj[a].push(b)
  indeg[b] += 1
h = heap()
for k in indeg.keys():
  if indeg[k] == 0: h.push(k)
out: [str] = []
while !h.is_empty():
  n = h.pop()
  out.push(n)
  for m in adj[n]:
    indeg[m] -= 1
    if indeg[m] == 0: h.push(m)
if out.len() < indeg.len():
  print("cycle")
else:
  for n in out: print(n)
