rows = csv(stdin())
inn: {str: dec} = {}
out: {str: dec} = {}
bal: {str: dec} = {}
for r in rows.skip(1):
  if r.len() < 3: continue
  m = r[0].slice(0, 7)
  a = r[2].dec()
  if !inn.has(m):
    inn[m] = 0.dec()
    out[m] = 0.dec()
  if a > 0:
    inn[m] += a
  else:
    out[m] += 0 - a
  bal[r[1]] += a
for m in inn.keys():
  print("{m} {inn[m].fmt(2)} {out[m].fmt(2)} {(inn[m] - out[m]).fmt(2)}")
best = ""
for (k, v) in bal.pairs():
  if best == "" or v > bal[best]: best = k
print("top {best} {bal[best].fmt(2)}")
