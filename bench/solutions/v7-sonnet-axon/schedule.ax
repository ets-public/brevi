dur: {str: int} = {}
deps: {str: [str]} = {}
for l in lines():
  w = l.words()
  if w.is_empty(): continue
  dur[w[0]] = w[1].int()
  deps[w[0]] = w.skip(3)
  if !deps.has(w[0]): deps[w[0]] = []
st: {str: int} = {}
en: {str: int} = {}
bad = false
for (n, ds) in deps.pairs():
  for d in ds:
    if !dur.has(d): bad = true
progress = true
while progress and !bad:
  progress = false
  for n in dur.keys():
    if en.has(n): continue
    ok = true
    s = 0
    for d in deps[n]:
      if !en.has(d):
        ok = false
      else:
        s = max(s, en[d])
    if ok:
      st[n] = s
      en[n] = s + dur[n]
      progress = true
if bad or en.len() < dur.len():
  print("invalid")
else:
  rows = dur.keys().map(n => (st[n], n))
  rows = rows.sort()
  t = 0
  for (s, n) in rows:
    print("{n} {s} {en[n]}")
    t = max(t, en[n])
  print("total {t}")
