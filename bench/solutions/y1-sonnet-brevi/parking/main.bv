use "garage.bv"
use "billing.bv"

ls = lines()
h = ls[0].re_full("spaces car (\d+) moto (\d+) van (\d+)")
g = Garage(nc: 0, nm: 0, nv: 0, spaces: {}, inside: {})
if not h.is_empty():
  g = Garage(nc: h[1].int(), nm: h[2].int(), nv: h[3].int(), spaces: {}, inside: {})
clock = -1
revenue = 0
exits = 0

fn handle(ws: [str]):
  if ws.len() < 3: fail("bad line")
  if not valid_stamp(ws[0], ws[1]): fail("bad line")
  c = ws[2]
  if c == "IN":
    if ws.len() != 5 or ws[4] not in ["car", "moto", "van"]: fail("bad line")
  elif c == "OUT":
    if ws.len() != 4: fail("bad line")
  elif c == "REPORT":
    if ws.len() != 3: fail("bad line")
  else:
    fail("bad line")
  t = stamp(ws[0], ws[1])
  if t < clock: fail("time goes back")
  if c == "IN":
    if g.inside.has(ws[3]): fail("already inside")
    sp = g_in(g, ws[3], ws[4], t)
    if sp == "":
      print("FULL {ws[3]}")
    else:
      print("IN {ws[3]} {sp}")
  elif c == "OUT":
    if not g.inside.has(ws[3]): fail("not inside")
    e = g_out(g, ws[3])
    d = t - e.2
    f = fee(e.0, d)
    revenue += f
    exits += 1
    print("OUT {ws[3]} {stay_fmt(d)} fee {money(f)}")
  else:
    cc = occ(g, "C")
    mm = occ(g, "M")
    vv = occ(g, "V")
    print("occupied car {cc}/{g.nc} moto {mm}/{g.nm} van {vv}/{g.nv} revenue {money(revenue)}")
  clock = t
  0

for i in 1..ls.len():
  ws = ls[i].words()
  if ws.is_empty(): continue
  match handle(ws):
    Ok(_) => revenue += 0
    Err(m) => print("line {i + 1}: {m}")
print("revenue {money(revenue)} from {exits} exits")
