tcols = {}
ttypes = {}
trows = {}
toks = []
pos = 0
kind = ""
tname = ""
names = []
types = []
vals = []
selall = false
conds = []
ordcol = ""
desc = false
lim = -1
setcol = ""
OPS = ["=", "!=", "<", ">", "<=", ">="]

fn peek() -> str:
  if pos < toks.len(): toks[pos] else: ""

fn isname(t: str) -> bool = t.re_full("[A-Za-z][A-Za-z0-9_]*").len() > 0
fn isval(t: str) -> bool = t.starts_with("'") or t.re_full("-?[0-9]+").len() > 0

fn eat(s: str) -> bool:
  if peek() == s:
    pos += 1
    true
  else: false

fn parse_conds() -> bool:
  while true:
    c = peek()
    if not isname(c): return false
    pos += 1
    op = peek()
    if op not in OPS: return false
    pos += 1
    v = peek()
    if not isval(v): return false
    pos += 1
    conds.push((c, op, v))
    if not eat("AND"): break
  true

fn parse_name() -> str:
  t = peek()
  if isname(t):
    pos += 1
    t
  else: ""

fn parse() -> bool:
  t0 = peek()
  if t0 == "CREATE":
    pos += 1
    kind = "create"
    if not eat("TABLE"): return false
    tname = parse_name()
    if not tname or not eat("("): return false
    while true:
      c = parse_name()
      ty = peek()
      if not c or (ty != "INT" and ty != "TEXT"): return false
      pos += 1
      names.push(c)
      types.push(ty)
      if eat(","): continue
      if eat(")"): break
      return false
  elif t0 == "INSERT":
    pos += 1
    kind = "insert"
    if not eat("INTO"): return false
    tname = parse_name()
    if not tname or not eat("VALUES") or not eat("("): return false
    while true:
      v = peek()
      if not isval(v): return false
      pos += 1
      vals.push(v)
      if eat(","): continue
      if eat(")"): break
      return false
  elif t0 == "SELECT":
    pos += 1
    kind = "select"
    if eat("COUNT"):
      kind = "count"
      if not eat("(") or not eat("*") or not eat(")"): return false
    elif eat("*"): selall = true
    else:
      while true:
        c = parse_name()
        if not c: return false
        names.push(c)
        if not eat(","): break
    if not eat("FROM"): return false
    tname = parse_name()
    if not tname: return false
    if eat("WHERE"):
      if not parse_conds(): return false
    if kind == "select":
      if eat("ORDER"):
        if not eat("BY"): return false
        ordcol = parse_name()
        if not ordcol: return false
        if eat("DESC"): desc = true
      if eat("LIMIT"):
        v = peek()
        if v.re_full("[0-9]+").len() == 0: return false
        pos += 1
        lim = v.int()
  elif t0 == "UPDATE":
    pos += 1
    kind = "update"
    tname = parse_name()
    if not tname or not eat("SET"): return false
    setcol = parse_name()
    if not setcol or not eat("="): return false
    v = peek()
    if not isval(v): return false
    pos += 1
    vals.push(v)
    if eat("WHERE"):
      if not parse_conds(): return false
  elif t0 == "DELETE":
    pos += 1
    kind = "delete"
    if not eat("FROM"): return false
    tname = parse_name()
    if not tname: return false
    if eat("WHERE"):
      if not parse_conds(): return false
  else: return false
  pos == toks.len()

fn vtype(v: str) -> str = if v.starts_with("'"): "TEXT" else: "INT"
fn vstore(v: str) -> str = if v.starts_with("'"): v.slice(1, -1).replace("''", "'") else: str(v.int())

fn cmp(op: str, a: str, b: str, isint: bool) -> bool:
  c = 0
  if isint:
    x = a.int()
    y = b.int()
    if x < y: c = -1
    elif x > y: c = 1
  else:
    if a < b: c = -1
    elif a > b: c = 1
  match op:
    "=" => c == 0
    "!=" => c != 0
    "<" => c < 0
    ">" => c > 0
    "<=" => c <= 0
    _ => c >= 0

fn matches(row: [str]) -> bool:
  for c in conds:
    i = tcols[tname].index_of(c.0)
    if not cmp(c.1, row[i], vstore(c.2), ttypes[tname][i] == "INT"): return false
  true

# returns error text or ""
fn check_conds() -> str:
  for c in conds:
    if c.0 not in tcols[tname]: return "error: no column {c.0}"
  for c in conds:
    i = tcols[tname].index_of(c.0)
    if ttypes[tname][i] != vtype(c.2): return "error: type mismatch"
  ""

fn run() -> [str]:
  out = []
  if kind == "create":
    if tcols.has(tname): return ["error: table {tname} exists"]
    tcols[tname] = names
    ttypes[tname] = types
    trows[tname] = []
    return ["ok"]
  if not tcols.has(tname): return ["error: no table {tname}"]
  cs = tcols[tname]
  if kind == "insert":
    if vals.len() != cs.len(): return ["error: type mismatch"]
    for i in 0..vals.len():
      if vtype(vals[i]) != ttypes[tname][i]: return ["error: type mismatch"]
    trows[tname].push([vstore(v) for v in vals])
    return ["ok"]
  if kind == "select":
    for c in names:
      if c not in cs: return ["error: no column {c}"]
  if kind == "update":
    if setcol not in cs: return ["error: no column {setcol}"]
  e = check_conds()
  if kind == "select" and ordcol and ordcol not in cs and e.starts_with("error: no column") == false:
    if e == "": e = "error: no column {ordcol}"
  if e: return [e]
  if kind == "update":
    si = cs.index_of(setcol)
    if ttypes[tname][si] != vtype(vals[0]): return ["error: type mismatch"]
    n = 0
    rows = trows[tname]
    for i in 0..rows.len():
      if matches(rows[i]):
        rows[i][si] = vstore(vals[0])
        n += 1
    trows[tname] = rows
    return ["updated {n}"]
  if kind == "delete":
    n = trows[tname].filter(r => matches(r)).len()
    trows[tname] = trows[tname].filter(r => not matches(r))
    return ["deleted {n}"]
  rows = trows[tname].filter(r => matches(r))
  if kind == "count": return ["{rows.len()}"]
  idx = if selall: (0..cs.len()).map(i => i) else: names.map(c => cs.index_of(c))
  head = [cs[i] for i in idx]
  if ordcol:
    ci = cs.index_of(ordcol)
    rank = []
    if ttypes[tname][ci] == "INT":
      kv = [r[ci].int() for r in rows]
      u = kv.unique()
      rank = [u.index_of(k) for k in kv]
    else:
      kv = [r[ci] for r in rows]
      u = kv.unique()
      rank = [u.index_of(k) for k in kv]
    rk = [(0 - r) if desc else r for r in rank]
    order = (0..rows.len()).sort_by(i => (rk[i], i))
    rows = [rows[i] for i in order]
  if lim >= 0: rows = rows.take(lim)
  out.push(" | ".join(head))
  for r in rows: out.push(" | ".join([r[i] for i in idx]))
  out.push("({rows.len()} rows)")
  out

for line in lines():
  if line.trim().is_empty(): continue
  toks = line.re_list("'(?:[^']|'')*'|-?[0-9]+|[A-Za-z_][A-Za-z0-9_]*|!=|<=|>=|[=<>(),*]")
  rest = line.re_sub("'(?:[^']|'')*'|-?[0-9]+|[A-Za-z_][A-Za-z0-9_]*|!=|<=|>=|[=<>(),*]", "")
  pos = 0
  kind = ""
  names = []
  types = []
  vals = []
  conds = []
  selall = false
  ordcol = ""
  desc = false
  lim = -1
  setcol = ""
  tname = ""
  if rest.replace(" ", "") != "" or not parse():
    print("error: syntax")
    continue
  for o in run(): print(o)
