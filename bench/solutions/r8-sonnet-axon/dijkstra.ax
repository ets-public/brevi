ls = lines().filter(l => !l.trim().is_empty())
var adj: {str: [(str, int)]} = {}
for i in 0..ls.len() - 1 {
  w = ls[i].words()
  adj[w[0]].push((w[1], w[2].int()))
  adj[w[1]].push((w[0], w[2].int()))
}
last = ls[-1].words()
src = last[0]
dst = last[1]
var dist: {str: int} = {}
h = heap()
dist[dst] = 0
h.push((0, dst))
while !h.is_empty() {
  let (d, u) = h.pop()
  if d > dist.get_or(u, 1000000000000) { continue }
  for (v, w) in adj.get_or(u, []) {
    nd = d + w
    if nd < dist.get_or(v, 1000000000000) {
      dist[v] = nd
      h.push((nd, v))
    }
  }
}
if !dist.has(src) { print("none") } else {
  print(dist[src])
  var path: [str] = [src]
  var cur = src
  while cur != dst {
    var best = ""
    for (v, w) in adj[cur] {
      if dist.has(v) and w + dist[v] == dist[cur] {
        if best == "" or v < best { best = v }
      }
    }
    path.push(best)
    cur = best
  }
  print(path.join("->"))
}
