var nodes: {str: int} = {}
var adj: {str: [str]} = {}
var indeg: {str: int} = {}
for line in lines() {
  if line.trim().is_empty() { continue }
  p = line.split("->")
  a = p[0].trim()
  b = p[1].trim()
  nodes[a] = 1
  nodes[b] = 1
  adj[a].push(b)
  indeg[b] += 1
}
h = heap()
for n in nodes.keys() {
  if indeg.get_or(n, 0) == 0 { h.push(n) }
}
var out: [str] = []
while !h.is_empty() {
  cur = h.pop()
  out.push(cur)
  for m in adj.get_or(cur, []) {
    indeg[m] -= 1
    if indeg[m] == 0 { h.push(m) }
  }
}
if out.len() < nodes.len() { print("cycle") } else {
  for n in out { print(n) }
}
