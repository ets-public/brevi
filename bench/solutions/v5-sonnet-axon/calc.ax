cs: [str] = []
pos = 0
bad = false

fn peek() -> str:
  while pos < cs.len() and cs[pos] == " ": pos += 1
  if pos < cs.len(): cs[pos] else: ""

fn atom() -> int:
  c = peek()
  if c == "-":
    pos += 1
    return -atom()
  if c == "(":
    pos += 1
    v = expr()
    peek()
    pos += 1
    return v
  n = 0
  while pos < cs.len() and cs[pos].is_digit():
    n = n * 10 + cs[pos].digit()
    pos += 1
  n

fn term() -> int:
  v = atom()
  while true:
    c = peek()
    if c == "*":
      pos += 1
      v = v * atom()
    elif c == "/":
      pos += 1
      d = atom()
      if d == 0:
        bad = true
        v = 0
      else:
        v = v / d
    else:
      break
  v

fn expr() -> int:
  v = term()
  while true:
    c = peek()
    if c == "+":
      pos += 1
      v = v + term()
    elif c == "-":
      pos += 1
      v = v - term()
    else:
      break
  v

for line in lines():
  if line.trim().is_empty(): continue
  cs = line.chars()
  pos = 0
  bad = false
  r = expr()
  if bad: print("error") else: print(r)
