ls = lines()
n = ls[0].trim().int()
fn sq(s: str) -> (int, int) = (s.slice(0, 1).code() - 97, s.slice(1, s.len()).int() - 1)
dx = [1, 2, 2, 1, -1, -2, -2, -1]
dy = [2, 1, -1, -2, -2, -1, 1, 2]
for line in ls.skip(1):
  w = line.words()
  if w.len() < 2: continue
  (sx, sy) = sq(w[0])
  (tx, ty) = sq(w[1])
  dist = [-1].repeat(n * n)
  dist[sx * n + sy] = 0
  q = [sx * n + sy]
  qi = 0
  while qi < q.len():
    cur = q[qi]
    qi += 1
    cx = cur / n
    cy = cur % n
    for k in 0..8:
      nx = cx + dx[k]
      ny = cy + dy[k]
      if nx >= 0 and nx < n and ny >= 0 and ny < n and dist[nx * n + ny] < 0:
        dist[nx * n + ny] = dist[cur] + 1
        q.push(nx * n + ny)
  print(dist[tx * n + ty])
