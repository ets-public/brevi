rows = csv(stdin())
inn: {str: dec} = {}
out: {str: dec} = {}
bal: {str: dec} = {}
months: [str] = []
for r in rows.skip(1):
  if r.len() < 3: continue
  m = r[0].trim().slice(0, 7)
  a = r[2].trim().dec()
  if !months.contains(m): months.push(m)
  if a > 0: inn[m] += a else: out[m] += -a
  bal[r[1].trim()] += a
months = months.sort()
for m in months:
  print("{m} {inn[m].fmt(2)} {out[m].fmt(2)} {(inn[m] - out[m]).fmt(2)}")
best = ""
bv = 0.dec()
first = true
for (k, v) in bal.pairs():
  if first or v > bv:
    best = k
    bv = v
    first = false
print("top {best} {bv.fmt(2)}")
