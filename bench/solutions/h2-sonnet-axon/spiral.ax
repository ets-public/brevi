all = stdin().ints()
r = all[0]
c = all[1]
g = all.skip(2)
out: [str] = []
top = 0
bot = r - 1
left = 0
right = c - 1
while top <= bot and left <= right {
  for j in left..(right + 1) { out.push(str(g[top * c + j])) }
  top += 1
  for i in top..(bot + 1) { out.push(str(g[i * c + right])) }
  right -= 1
  if top <= bot {
    j = right
    while j >= left { out.push(str(g[bot * c + j])) 
      j -= 1 }
    bot -= 1
  }
  if left <= right {
    i = bot
    while i >= top { out.push(str(g[i * c + left]))
      i -= 1 }
    left += 1
  }
}
print(out.join(" "))
cols: [str] = []
for j in 0..c {
  s = 0
  for i in 0..r { s += g[i * c + j] }
  cols.push(str(s))
}
print(cols.join(" "))
