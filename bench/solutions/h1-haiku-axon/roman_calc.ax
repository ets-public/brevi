fn rval(c: str) -> int {
  if c == "I" { return 1 }
  if c == "V" { return 5 }
  if c == "X" { return 10 }
  if c == "L" { return 50 }
  if c == "C" { return 100 }
  if c == "D" { return 500 }
  if c == "M" { return 1000 }
  return 0
}

fn roman(s: str) -> int {
  cs = s.chars()
  total = 0
  i = 0
  while i < cs.len() {
    v = rval(cs[i])
    if i + 1 < cs.len() and rval(cs[i + 1]) > v {
      total -= v
    } else {
      total += v
    }
    i += 1
  }
  total
}

fn to_roman(n: int) -> str {
  vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  out = ""
  x = n
  i = 0
  while i < vals.len() {
    while x >= vals[i] {
      out += syms[i]
      x -= vals[i]
    }
    i += 1
  }
  out
}

for line in stdin().lines() {
  toks = line.words()
  if toks.is_empty() { continue }
  total = 0
  sign = 1
  for t in toks {
    if t == "+" {
      sign = 1
    } else if t == "-" {
      sign = -1
    } else {
      total += sign * roman(t)
    }
  }
  if total <= 0 {
    print("nulla")
  } else {
    print(to_roman(total))
  }
}
