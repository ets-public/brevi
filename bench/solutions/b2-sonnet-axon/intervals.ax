iv: [(int, int)] = []
for line in lines() {
  if line.trim().is_empty() { continue }
  n = line.ints()
  iv.push((n[0], n[1]))
}
iv = iv.sort()
res: [(int, int)] = []
for (a, b) in iv {
  if res.len() > 0 and a <= res[-1].1 {
    if b > res[-1].1 { res[-1] = (res[-1].0, b) }
  } else {
    res.push((a, b))
  }
}
total = 0
for (a, b) in res {
  print("{a} {b}")
  total += b - a
}
print("total {total}")
