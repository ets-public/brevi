ls = lines()
rc = ls[0].ints()
r = rc[0]
c = rc[1]
m: [[int]] = []
for i in 0..r { m.push(ls[i + 1].ints()) }
out: [int] = []
top = 0
bot = r - 1
left = 0
right = c - 1
while top <= bot and left <= right {
  for j in left..(right + 1) { out.push(m[top][j]) }
  top += 1
  for i in top..(bot + 1) { out.push(m[i][right]) }
  right -= 1
  if top <= bot {
    for j in (left..(right + 1)).rev() { out.push(m[bot][j]) }
    bot -= 1
  }
  if left <= right {
    for i in (top..(bot + 1)).rev() { out.push(m[i][left]) }
    left += 1
  }
}
print(out.map(x => str(x)).join(" "))
cols: [str] = []
for j in 0..c {
  s = 0
  for i in 0..r { s += m[i][j] }
  cols.push(str(s))
}
print(cols.join(" "))
