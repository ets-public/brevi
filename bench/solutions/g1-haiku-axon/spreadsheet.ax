ftoks = {}
state = {}
vals = {}
tags = {}
toks: [str] = []
pos = 0
maxc = 0
maxr = 1

fn comb(a: str, b: str) -> str:
  if a == "C" or b == "C":
    return "C"
  if a == "D" or b == "D":
    return "D"
  return ""

fn tokenize(s: str) -> [str]:
  out = []
  cs = s.chars()
  n = cs.len()
  i = 0
  while i < n:
    c = cs[i]
    if c == " ":
      i += 1
    elif c.is_digit():
      tok = ""
      while i < n and cs[i].is_digit():
        tok = tok + cs[i]
        i += 1
      out.push(tok)
    elif c.is_alpha():
      tok = ""
      while i < n and (cs[i].is_alpha() or cs[i].is_digit()):
        tok = tok + cs[i]
        i += 1
      out.push(tok)
    else:
      out.push(c)
      i += 1
  return out

fn cell_val(nm: str) -> (int, str):
  if not ftoks.has(nm):
    return (0, "")
  st = state.get_or(nm, 0)
  if st == 2:
    return (vals[nm], tags[nm])
  if st == 1:
    return (0, "C")
  state[nm] = 1
  saved = toks
  saved_pos = pos
  toks = ftoks[nm]
  pos = 0
  (v, t) = expr()
  toks = saved
  pos = saved_pos
  state[nm] = 2
  vals[nm] = v
  tags[nm] = t
  return (v, t)

fn range_op(fname: str, a: str, b: str) -> (int, str):
  c1 = a.slice(0, 1).code() - 65
  c2 = b.slice(0, 1).code() - 65
  r1 = a.slice(1).int().or(1)
  r2 = b.slice(1).int().or(1)
  clo = min(c1, c2)
  chi = max(c1, c2)
  rlo = min(r1, r2)
  rhi = max(r1, r2)
  vs = []
  t = ""
  for c in clo..chi + 1:
    L = (c + 65).char()
    for r in rlo..rhi + 1:
      (v, u) = cell_val(L + str(r))
      vs.push(v)
      t = comb(t, u)
  if fname == "SUM":
    return (vs.sum(), t)
  if fname == "MIN":
    return (vs.min(), t)
  return (vs.max(), t)

fn factor() -> (int, str):
  tok = toks[pos]
  pos += 1
  c0 = tok.slice(0, 1)
  if tok == "-":
    (v, t) = factor()
    return (-v, t)
  if tok == "(":
    (v, t) = expr()
    pos += 1
    return (v, t)
  if c0.is_digit():
    return (tok.int().or(0), "")
  if tok == "SUM" or tok == "MIN" or tok == "MAX":
    a = toks[pos + 1]
    b = toks[pos + 3]
    pos += 5
    return range_op(tok, a, b)
  return cell_val(tok)

fn term() -> (int, str):
  (v, t) = factor()
  while pos < toks.len() and (toks[pos] == "*" or toks[pos] == "/"):
    op = toks[pos]
    pos += 1
    (w, u) = factor()
    t = comb(t, u)
    if op == "*":
      v = v * w
    elif w == 0:
      t = comb(t, "D")
      v = 0
    else:
      v = v / w
  return (v, t)

fn expr() -> (int, str):
  (v, t) = term()
  while pos < toks.len() and (toks[pos] == "+" or toks[pos] == "-"):
    op = toks[pos]
    pos += 1
    (w, u) = term()
    t = comb(t, u)
    if op == "+":
      v = v + w
    else:
      v = v - w
  return (v, t)

fn show(nm: str) -> str:
  if not ftoks.has(nm):
    return ""
  (v, t) = cell_val(nm)
  if t == "C":
    return "#CYCLE"
  if t == "D":
    return "#DIV0"
  return str(v)

for line in lines():
  if line.trim().is_empty():
    continue
  i = line.find("=")
  name = line.slice(0, i).trim()
  content = line.slice(i + 1).trim()
  if content.starts_with("="):
    content = content.slice(1)
  ts = tokenize(content)
  ftoks[name] = ts
  ccol = name.slice(0, 1).code() - 65
  crow = name.slice(1).int().or(1)
  maxc = max(maxc, ccol)
  maxr = max(maxr, crow)
  for t in ts:
    if t.slice(0, 1).is_alpha() and t.slice(1, 2).is_digit():
      tc = t.slice(0, 1).code() - 65
      tr = t.slice(1).int().or(1)
      maxc = max(maxc, tc)
      maxr = max(maxr, tr)

hdr = ""
for c in 0..maxc + 1:
  hdr = hdr + "\t" + (c + 65).char()
print(hdr)
for r in 1..maxr + 1:
  row = [str(r)]
  for c in 0..maxc + 1:
    row.push(show((c + 65).char() + str(r)))
  print(row.join("\t"))
