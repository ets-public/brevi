j = json(stdin())
prods = j["products"]
custs = j["customers"]
revenue = 0.dec()
outs = []
for o in j["orders"]:
  oid = str(o["id"])
  cid = o["customer"].text()
  if not custs.has(cid):
    outs.push('{"id":{oid},"error":"unknown customer {cid}"}')
    continue
  bad = ""
  for l in o["lines"]:
    sku = l["sku"].text()
    if bad.is_empty() and not prods.has(sku): bad = sku
  if not bad.is_empty():
    outs.push('{"id":{oid},"error":"unknown sku {bad}"}')
    continue
  cust = custs[cid]
  sub = 0.dec()
  catamt = {}
  catqty = {}
  for l in o["lines"]:
    p = prods[l["sku"].text()]
    amt = p["price"].text().dec() * l["qty"].int()
    sub += amt
    cat = p["category"].text()
    catamt[cat] += amt
    catqty[cat] += l["qty"].int()
  disc = 0.dec()
  for cat, q in catqty.pairs():
    if q >= 3:
      disc += (catamt[cat] * "0.05".dec()).round(2)
  tier = cust["tier"].text()
  rate = if tier == "gold": "0.10".dec() elif tier == "silver": "0.05".dec() else: 0.dec()
  disc += ((sub - disc) * rate).round(2)
  after = sub - disc
  country = cust["country"].text()
  trate = if country == "UK": "0.20".dec() elif country == "US": "0.0825".dec() else: 0.dec()
  tax = (after * trate).round(2)
  total = after + tax
  revenue += total
  outs.push('{"id":{oid},"customer":{str(cust["name"])},"subtotal":"{sub.fmt(2)}","discount":"{disc.fmt(2)}","tax":"{tax.fmt(2)}","total":"{total.fmt(2)}"}')
print("[" + ",".join(outs) + "]")
print("revenue {revenue.fmt(2)}")
