out = []
heads = []
seen = {}
para = []
items = []
listtag = ""

fn esc(s: str) -> str = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

fn fmt(s: str) -> str:
  t = s.replace("**", "\x01")
  t = s
  t = t.re_sub('\*\*(.+?)\*\*', "<strong>\1</strong>")
  t = t.re_sub('\*(.+?)\*', "<em>\1</em>")
  t = t.re_sub('\[([^\]]*)\]\(([^)]*)\)', '<a href="\2">\1</a>')
  t

fn inline(s: str) -> str:
  segs = esc(s).split("`")
  res = ""
  n = segs.len()
  for i in 0..n:
    if i % 2 == 1 and i < n - 1:
      res += "<code>" + segs[i] + "</code>"
    elif i % 2 == 1:
      res += "`" + fmt(segs[i])
    else:
      res += fmt(segs[i])
  res

fn flush():
  if para:
    out.push("<p>" + " ".join(para) + "</p>")
    para = []
  if items:
    out.push("<{listtag}>")
    for it in items: out.push("<li>" + inline(it) + "</li>")
    out.push("</{listtag}>")
    items = []
    listtag = ""

fn slug(s: str) -> str:
  r = s.lower().re_sub("[^a-z0-9]+", "-")
  while r.starts_with("-"): r = r.slice(1)
  while r.ends_with("-"): r = r.slice(0, r.len() - 1)
  r

ls = lines()
i = 0
while i < ls.len():
  line = ls[i]
  i += 1
  if line.trim() == "":
    flush()
    continue
  if line.trim() == "```":
    flush()
    code = []
    while i < ls.len() and ls[i].trim() != "```":
      code.push(esc(ls[i]))
      i += 1
    i += 1
    out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
    continue
  h = line.re_full('(#{1,6}) (.*)')
  if h:
    flush()
    lvl = h[1].len()
    txt = h[2].trim()
    base = slug(txt)
    c = seen[base]
    seen[base] += 1
    id = if c == 0: base else: base + "-" + str(c + 1)
    out.push("<h{lvl} id=\"{id}\">" + inline(txt) + "</h{lvl}>")
    heads.push((id, esc(txt.replace("`", "").replace("*", ""))))
    continue
  if line.starts_with("- "):
    if listtag != "ul": flush()
    listtag = "ul"
    items.push(line.slice(2))
    continue
  o = line.re_full('\d+\. (.*)')
  if o:
    if listtag != "ol": flush()
    listtag = "ol"
    items.push(o[1])
    continue
  if items: flush()
  para.push(inline(line.trim()))
flush()
if heads.len() >= 2:
  print("<nav>")
  for h in heads: print("<a href=\"#{h.0}\">{h.1}</a>")
  print("</nav>")
for l in out: print(l)
