owners = {}
bals = {}
cnt = 0

fn acct(id: int) -> str = str({"id": id, "owner": owners[id], "balance": bals[id]})

fn amt(j: Json) -> int = match j["amount"]:
  Num(n) => if n > 0.0 and n.floor() == n: n.int() else: -1
  _ => -1

fn handle(line: str) -> str:
  parts = line.split(" ")
  method = parts[0]
  path = if parts.len() > 1: parts[1] else: ""
  body = if parts.len() > 2: parts[2:].join(" ") else: ""
  segs = path.split("/")
  kind = ""
  id = 0
  if method == "POST" and path == "/accounts": kind = "create"
  elif method == "GET" and path == "/accounts": kind = "list"
  elif method == "POST" and path == "/transfer": kind = "transfer"
  elif segs.len() >= 3 and segs[0] == "" and segs[1] == "accounts" and segs[2].is_digit():
    id = segs[2].int()
    if method == "GET" and segs.len() == 3: kind = "get"
    elif method == "POST" and segs.len() == 4 and segs[3] == "deposit": kind = "deposit"
    elif method == "POST" and segs.len() == 4 and segs[3] == "withdraw": kind = "withdraw"
  if kind == "":
    return '404 {"error":"not found"}'
  if kind == "list":
    xs = [(bals[i], i) for i in 1..cnt + 1].sort_by(p => (-p.0, p.1))
    return "200 [" + ",".join([acct(p.1) for p in xs]) + "]"
  j = json("null")
  if kind != "get":
    match json(body):
      Ok(v) => j = v
      Err(e) => return '400 {"error":"bad json"}'
  if kind == "create":
    o = match j["owner"]:
      Str(s) => s
      _ => ""
    if o == "": return '400 {"error":"owner required"}'
    cnt += 1
    owners[cnt] = o
    bals[cnt] = 0
    return "201 " + acct(cnt)
  if kind == "transfer":
    a = j["from"].int()
    b = j["to"].int()
    if not owners.has(a) or not owners.has(b): return '404 {"error":"no such account"}'
    if a == b: return '400 {"error":"same account"}'
    n = amt(j)
    if n < 0: return '400 {"error":"bad amount"}'
    if n > bals[a]: return '409 {"error":"insufficient funds"}'
    bals[a] -= n
    bals[b] += n
    return "200 " + str({"from": bals[a], "to": bals[b]})
  if not owners.has(id): return '404 {"error":"no such account"}'
  if kind == "get": return "200 " + acct(id)
  n = amt(j)
  if n < 0: return '400 {"error":"bad amount"}'
  if kind == "withdraw":
    if n > bals[id]: return '409 {"error":"insufficient funds"}'
    bals[id] -= n
  else:
    bals[id] += n
  "200 " + acct(id)

for line in lines():
  if line.trim():
    print(handle(line.trim()))
