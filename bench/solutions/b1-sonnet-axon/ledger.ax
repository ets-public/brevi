rows = csv(stdin())
ins: {str: dec} = {}
outs: {str: dec} = {}
bal: {str: dec} = {}
for r in rows.skip(1) {
  if r.len() < 3 { continue }
  m = r[0].slice(0, 7)
  a = r[2].dec()
  if !ins.has(m) {
    ins[m] = "0".dec()
    outs[m] = "0".dec()
  }
  if a > "0".dec() { ins[m] += a } else { outs[m] += -a }
  bal[r[1]] += a
}
for (m, i) in ins.pairs() {
  o = outs[m]
  print("{m} {i.fmt(2)} {o.fmt(2)} {(i - o).fmt(2)}")
}
best = ""
bv = "0".dec()
for (k, v) in bal.pairs() {
  if best.is_empty() or v > bv {
    best = k
    bv = v
  }
}
print("top {best} {bv.fmt(2)}")
