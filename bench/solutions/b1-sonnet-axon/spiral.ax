nums = stdin().ints()
r = nums[0]
c: int = nums[1]
m: [int] = nums.skip(2)
fn at(i: int, j: int) -> int = m[i * c + j]
top = 0
bot = r - 1
lef = 0
rig = c - 1
out: [int] = []
while top <= bot and lef <= rig {
  for j in lef..(rig + 1) { out.push(at(top, j)) }
  top += 1
  for i in top..(bot + 1) { out.push(at(i, rig)) }
  rig -= 1
  if top <= bot {
    for j in (lef..(rig + 1)).rev() { out.push(at(bot, j)) }
    bot -= 1
  }
  if lef <= rig {
    for i in (top..(bot + 1)).rev() { out.push(at(i, lef)) }
    lef += 1
  }
}
print(out.map(x => str(x)).join(" "))
cols: [int] = []
for j in 0..c {
  s = 0
  for i in 0..r { s += at(i, j) }
  cols.push(s)
}
print(cols.map(x => str(x)).join(" "))
