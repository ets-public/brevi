fn main() {
  let g = stdin().lines().filter(l => !l.trim().is_empty()).map(l => l.chars())
  let h = g.len()
  var sr = 0
  var sc = 0
  for r in 0..h {
    for c in 0..g[r].len() {
      if g[r][c] == "S" {
        sr = r
        sc = c
      }
    }
  }
  var dist: {int: int} = {}
  var q: [(int, int)] = [(sr, sc)]
  dist[sr * 1000 + sc] = 0
  var qi = 0
  var ans = -1
  let dr = [1, -1, 0, 0]
  let dc = [0, 0, 1, -1]
  while qi < q.len() {
    let (r, c) = q[qi]
    qi += 1
    let d = dist[r * 1000 + c]
    if g[r][c] == "E" {
      ans = d
      break
    }
    for k in 0..4 {
      let nr = r + dr[k]
      let nc = c + dc[k]
      if nr < 0 or nr >= h or nc < 0 or nc >= g[nr].len() { continue }
      if g[nr][nc] == "#" { continue }
      if dist.has(nr * 1000 + nc) { continue }
      dist[nr * 1000 + nc] = d + 1
      q.push((nr, nc))
    }
  }
  print(ans)
}
