fn sv(j: Json) -> str:
  match j:
    Str(s) => s
    _ => ""

fn isnull(j: Json) -> bool:
  match j:
    Null => true
    _ => false

fn items(j: Json) -> [Json]:
  match j:
    Arr(xs) => xs
    _ => []

root = json(stdin())
prods = root["products"]
custs = root["customers"]
out = []
revenue = "0".dec()
for o in items(root["orders"]):
  idj = str(o["id"])
  cid = sv(o["customer"])
  cj = custs[cid]
  if isnull(cj):
    out.push("{{\"id\":{idj},\"error\":{str(("unknown customer " + cid).json())}}")
    continue
  badsku = ""
  for l in items(o["lines"]):
    sk = sv(l["sku"])
    if isnull(prods[sk]) and badsku == "": badsku = sk
  if badsku != "":
    out.push("{{\"id\":{idj},\"error\":{str(("unknown sku " + badsku).json())}}")
    continue
  sub = "0".dec()
  catamt = {}
  catqty = {}
  for l in items(o["lines"]):
    sk = sv(l["sku"])
    p = prods[sk]
    q = match l["qty"]:
      Num(n) => n.int()
      _ => 0
    a = sv(p["price"]).dec() * q
    cat = sv(p["category"])
    sub += a
    catamt[cat] += a
    catqty[cat] += q
  disc = "0".dec()
  for k, v in catamt.pairs():
    if catqty[k] >= 3:
      disc += (v * "0.05".dec()).round(2)
  tier = sv(cj["tier"])
  rate = "0".dec()
  if tier == "gold": rate = "0.10".dec()
  elif tier == "silver": rate = "0.05".dec()
  disc += ((sub - disc) * rate).round(2)
  country = sv(cj["country"])
  trate = "0".dec()
  if country == "UK": trate = "0.20".dec()
  elif country == "US": trate = "0.0825".dec()
  tax = ((sub - disc) * trate).round(2)
  total = sub - disc + tax
  revenue += total
  nm = str(sv(cj["name"]).json())
  out.push("{{\"id\":{idj},\"customer\":{nm},\"subtotal\":\"{sub.fmt(2)}\",\"discount\":\"{disc.fmt(2)}\",\"tax\":\"{tax.fmt(2)}\",\"total\":\"{total.fmt(2)}\"}")
print("[" + out.join(",") + "]")
print("revenue {revenue.fmt(2)}")
