cells = {}
kinds = {}
vals = {}
state = {}
tk = []
ps = 0

fn cellval(name: str) -> (int, int):
  if kinds.has(name): return (kinds[name], vals[name])
  if not cells.has(name): return (0, 0)
  if state[name] == 1: return (2, 0)
  state[name] = 1
  c = cells[name]
  res = (0, 0)
  if c.starts_with("="):
    saved = tk
    savedp = ps
    tk = c.slice(1).replace(" ", "").chars()
    ps = 0
    res = expr()
    tk = saved
    ps = savedp
  else:
    res = (0, c.int().or(0))
  state[name] = 2
  if res.0 == 2: res = (2, 0)
  elif res.0 == 1: res = (1, 0)
  kinds[name] = res.0
  vals[name] = res.1
  res

fn readref() -> str:
  r = tk[ps]
  ps += 1
  while ps < tk.len() and tk[ps].is_digit():
    r += tk[ps]
    ps += 1
  r

fn expr() -> (int, int):
  l = term()
  while ps < tk.len() and (tk[ps] == "+" or tk[ps] == "-"):
    op = tk[ps]
    ps += 1
    r = term()
    k = max(l.0, r.0)
    if op == "+": l = (k, l.1 + r.1)
    else: l = (k, l.1 - r.1)
  l

fn term() -> (int, int):
  l = factor()
  while ps < tk.len() and (tk[ps] == "*" or tk[ps] == "/"):
    op = tk[ps]
    ps += 1
    r = factor()
    k = max(l.0, r.0)
    if op == "*": l = (k, l.1 * r.1)
    elif r.1 == 0: l = (max(k, 1), 0)
    else: l = (k, l.1 / r.1)
  l

fn factor() -> (int, int):
  c = tk[ps]
  if c == "-":
    ps += 1
    f = factor()
    return (f.0, -f.1)
  if c == "(":
    ps += 1
    e = expr()
    ps += 1
    return e
  if c.is_digit():
    n = 0
    while ps < tk.len() and tk[ps].is_digit():
      n = n * 10 + tk[ps].digit()
      ps += 1
    return (0, n)
  if ps + 1 < tk.len() and tk[ps + 1].is_digit():
    return cellval(readref())
  fname = ""
  while tk[ps] != "(":
    fname += tk[ps]
    ps += 1
  ps += 1
  a = readref()
  ps += 1
  b = readref()
  ps += 1
  c1 = min(a.slice(0, 1).code(), b.slice(0, 1).code())
  c2 = max(a.slice(0, 1).code(), b.slice(0, 1).code())
  r1 = min(a.slice(1).int(), b.slice(1).int())
  r2 = max(a.slice(1).int(), b.slice(1).int())
  k = 0
  vs = []
  for cc in c1..c2 + 1:
    for rr in r1..r2 + 1:
      v = cellval(cc.char() + str(rr))
      k = max(k, v.0)
      vs.push(v.1)
  if k > 0: return (k, 0)
  if fname == "SUM": return (0, vs.sum())
  if fname == "MIN": return (0, vs.min())
  (0, vs.max())

maxc = 0
maxr = 0
fn note(c: str, r: int):
  if c.code() - 64 > maxc: maxc = c.code() - 64
  if r > maxr: maxr = r

for line in lines():
  i = line.find("=")
  if i < 0: continue
  name = line.slice(0, i).trim()
  cells[name] = line.slice(i + 1).trim()
  note(name.slice(0, 1), name.slice(1).int().or(0))
  state[name] = 0
  for m in line.slice(i + 1).re_all("([A-Z])(\d+)"):
    note(m[1], m[2].int())

hdr = ""
for c in 1..maxc + 1: hdr += "\t" + (c + 64).char()
print(hdr)
for r in 1..maxr + 1:
  row = str(r)
  for c in 1..maxc + 1:
    nm = (c + 64).char() + str(r)
    row += "\t"
    if cells.has(nm):
      v = cellval(nm)
      if v.0 == 2: row += "#CYCLE"
      elif v.0 == 1: row += "#DIV0"
      else: row += str(v.1)
  print(row)
