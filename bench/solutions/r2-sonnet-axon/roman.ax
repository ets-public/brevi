let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
for l in lines() {
  if l.trim().is_empty() { continue }
  var n = l.trim().int()?
  var out = ""
  for i in 0..13 {
    while n >= vals[i] {
      out = out + syms[i]
      n -= vals[i]
    }
  }
  print(out)
}
