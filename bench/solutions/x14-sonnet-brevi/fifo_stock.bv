type Lot:
  qty: int
  cost: dec

skus = {}
cogs = {}
revenue = {}
loss = {}
mprofit = {}
mloss = {}
mseen = {}

fn valid_date(s: str) -> bool:
  if s.re_full("[0-9]{4}-[0-9]{2}-[0-9]{2}").is_empty(): return false
  y = s.slice(0, 4).int()
  m = s.slice(5, 7).int()
  d = s.slice(8, 10).int()
  if m < 1 or m > 12 or d < 1: return false
  dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1]
  if m == 2 and (y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)): dim = 29
  d <= dim

fn is_price(s: str) -> bool = not s.re_full("[0-9]+(\.[0-9]{1,2})?").is_empty()

latest = ""

fn handle(line: str) -> int:
  w = line.words()
  n = w.len()
  if n < 4 or n > 5: fail("bad line")
  op = w[1]
  if op == "LOSS":
    if n != 4: fail("bad line")
  elif op == "RECEIVE" or op == "SHIP":
    if n != 5: fail("bad line")
    if not is_price(w[4]): fail("bad line")
  else:
    fail("bad line")
  if not valid_date(w[0]): fail("bad line")
  if w[3].re_full("[0-9]+").is_empty(): fail("bad line")
  q = w[3].int()
  if q < 1: fail("bad line")
  if w[0] < latest: fail("date out of order")
  sku = w[2]
  mon = w[0].slice(0, 7)
  if op == "RECEIVE":
    skus[sku].push(Lot(q, w[4].dec()))
  else:
    lots = skus[sku]
    have = sum([l.qty for l in lots])
    if q > have: fail("short {sku} need {q} have {have}")
    rem = q
    cost = 0.dec()
    while rem > 0:
      l = lots[0]
      t = min(rem, l.qty)
      cost += l.cost * t
      if t == l.qty:
        lots.remove(0)
      else:
        lots[0].qty -= t
      rem -= t
    skus[sku] = lots
    mseen[mon] = 1
    if op == "SHIP":
      rev = w[4].dec() * q
      cogs[sku] += cost
      revenue[sku] += rev
      mprofit[mon] += rev - cost
    else:
      loss[sku] += cost
      mloss[mon] += cost
  latest = w[0]
  0

ln = 0
for line in lines():
  ln += 1
  if line.trim().is_empty(): continue
  match handle(line):
    Ok(_) => ln = ln
    Err(m) => print("line {ln}: {m}")

tp = 0.dec()
tl = 0.dec()
for sku in skus.keys():
  lots = skus[sku]
  oh = sum([l.qty for l in lots])
  value = sum([l.cost * l.qty for l in lots])
  pr = revenue[sku] - cogs[sku]
  tp += pr
  tl += loss[sku]
  print("{sku} on_hand {oh} value {value.fmt(2)} cogs {cogs[sku].fmt(2)} revenue {revenue[sku].fmt(2)} profit {pr.fmt(2)} loss {loss[sku].fmt(2)}")
print("months")
for m in mseen.keys():
  print("  {m} profit {mprofit[m].fmt(2)} loss {mloss[m].fmt(2)}")
print("total profit {tp.fmt(2)} loss {tl.fmt(2)} net {(tp - tl).fmt(2)}")
