owners = []
balances = []

fn is_id(s: str) -> bool:
  return not s.re_full("[0-9]+").is_empty()

fn valid_id(id: int) -> bool = id >= 1 and id <= owners.len()

fn posint(j: Json) -> int:
  match j:
    Num(n) => if n >= 1 and n.floor() == n: n.int() else: -1
    _ => -1

fn owner_of(j: Json) -> str:
  match j["owner"]:
    Str(s) => s
    _ => ""

fn acct_json(id: int) -> str:
  str({"id": id, "owner": owners[id - 1], "balance": balances[id - 1]})

fn route(method: str, parts: [str]) -> str:
  n = parts.len()
  if n == 2 and parts[1] == "accounts":
    if method == "POST": return "create"
    if method == "GET": return "list"
  if n == 3 and parts[1] == "accounts" and method == "GET" and is_id(parts[2]): return "get"
  if n == 4 and parts[1] == "accounts" and method == "POST" and is_id(parts[2]):
    if parts[3] == "deposit": return "deposit"
    if parts[3] == "withdraw": return "withdraw"
  if n == 2 and parts[1] == "transfer" and method == "POST": return "transfer"
  return "none"

fn new_acct(j: Json) -> str:
  name = owner_of(j)
  if name.is_empty(): return '400 {"error":"owner required"}'
  owners.push(name)
  balances.push(0)
  return "201 " + acct_json(owners.len())

fn listing() -> str:
  keyed = []
  for i in 0..owners.len():
    keyed.push((-balances[i], i + 1))
  keyed.sort()
  items = [acct_json(p.1) for p in keyed]
  return "200 [" + items.join(",") + "]"

fn get_acct(id: int) -> str:
  if not valid_id(id): return '404 {"error":"no such account"}'
  return "200 " + acct_json(id)

fn deposit(id: int, j: Json) -> str:
  amt = posint(j["amount"])
  if amt < 0: return '400 {"error":"bad amount"}'
  balances[id - 1] = balances[id - 1] + amt
  return "200 " + acct_json(id)

fn withdraw(id: int, j: Json) -> str:
  amt = posint(j["amount"])
  if amt < 0: return '400 {"error":"bad amount"}'
  if amt > balances[id - 1]: return '409 {"error":"insufficient funds"}'
  balances[id - 1] = balances[id - 1] - amt
  return "200 " + acct_json(id)

fn transfer(j: Json) -> str:
  a = posint(j["from"])
  b = posint(j["to"])
  if not valid_id(a) or not valid_id(b): return '404 {"error":"no such account"}'
  if a == b: return '400 {"error":"same account"}'
  amt = posint(j["amount"])
  if amt < 0: return '400 {"error":"bad amount"}'
  if amt > balances[a - 1]: return '409 {"error":"insufficient funds"}'
  balances[a - 1] = balances[a - 1] - amt
  balances[b - 1] = balances[b - 1] + amt
  x = balances[a - 1]
  y = balances[b - 1]
  return '200 {"from":{x},"to":{y}}'

fn dispatch(kind: str, parts: [str], j: Json) -> str:
  if kind == "create": return new_acct(j)
  if kind == "list": return listing()
  if kind == "transfer": return transfer(j)
  id = parts[2].int().or(0)
  if kind == "get": return get_acct(id)
  if not valid_id(id): return '404 {"error":"no such account"}'
  if kind == "deposit": return deposit(id, j)
  return withdraw(id, j)

fn handle(method: str, path: str, body: str) -> str:
  parts = path.split("/")
  kind = route(method, parts)
  if kind == "none": return '404 {"error":"not found"}'
  t = body.trim()
  if t.is_empty(): t = "{}"
  match json(t):
    Ok(j) => dispatch(kind, parts, j)
    Err(_) => '400 {"error":"bad json"}'

for line in lines():
  if line.trim().is_empty(): continue
  (method, _, rest) = line.partition(" ")
  (path, _, body) = rest.partition(" ")
  print(handle(method, path, body))
