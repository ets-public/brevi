sta: [str] = []
tm: [int] = []
tripof: [int] = []
tname: [str] = []
nxt: [int] = []
ln: [int] = []
ll: [[str]] = []

fn tmin(t: str) -> int:
  (hh, _, mm) = t.partition(":")
  return hh.int().or(0) * 60 + mm.int().or(0)

fn two(x: int) -> str:
  if x < 10: return "0" + str(x)
  return str(x)

fn fmt_t(m: int) -> str = two(m // 60) + ":" + two(m % 60)

fn relax(u: int, cnt: int, lst: [str]) -> bool:
  if ln[u] < 0 or cnt < ln[u] or (cnt == ln[u] and lst < ll[u]):
    ln[u] = cnt
    ll[u] = lst
    return true
  return false

L = lines()
k = 0
while k < L.len() and L[k] != "---":
  k += 1
for i in 0..k:
  w = L[i].words()
  if w.is_empty(): continue
  base = sta.len()
  m = (w.len() - 1) // 2
  for j in 0..m:
    sta.push(w[1 + 2 * j])
    tm.push(tmin(w[2 + 2 * j]))
    tripof.push(i)
    tname.push(w[0])
    nx = -1
    if j < m - 1:
      nx = base + j + 1
    nxt.push(nx)

S = sta.len()
for q in L[k + 1:]:
  w = q.words()
  if w.is_empty(): continue
  fromst = w[0]
  tost = w[1]
  qt = tmin(w[2])
  if fromst == tost:
    print(fromst + " " + tost + " " + w[2] + " via -")
    continue
  ln = [-1].repeat(S)
  ll = []
  for s in 0..S:
    ll.push([])
  for s in 0..S:
    if sta[s] == fromst and tm[s] >= qt:
      relax(s, 1, [tname[s]])
  changed = true
  while changed:
    changed = false
    for s in 0..S:
      if ln[s] < 0: continue
      if nxt[s] >= 0:
        if relax(nxt[s], ln[s], ll[s]): changed = true
      for u in 0..S:
        if sta[u] == sta[s] and tripof[u] != tripof[s] and tm[u] >= tm[s] + 5:
          if relax(u, ln[s] + 1, ll[s] + [tname[u]]): changed = true
  have = false
  best = (0, 0, [""])
  for s in 0..S:
    if ln[s] >= 0 and sta[s] == tost:
      c = (tm[s], ln[s], ll[s])
      if not have or c < best:
        best = c
        have = true
  if have:
    print(fromst + " " + tost + " " + fmt_t(best.0) + " via " + best.2.join(">"))
  else:
    print(fromst + " " + tost + " unreachable")
