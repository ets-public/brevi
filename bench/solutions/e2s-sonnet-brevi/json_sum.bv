fn isred(j: Json) -> bool = match j:
  Str(s) => s == "red"
  _ => false

fn total(j: Json) -> f64 = match j:
  Num(n) => n
  Arr(xs) => sum([total(x) for x in xs])
  Obj(m) => if any(isred(v) for v in m.values()): 0.0 else: sum([total(v) for v in m.values()])
  _ => 0.0

print(total(json(stdin())).int())
