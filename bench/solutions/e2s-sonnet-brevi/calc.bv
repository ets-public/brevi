cs = []
pos = 0
bad = false

fn peek() -> str:
  while pos < cs.len() and cs[pos] == " ":
    pos += 1
  if pos < cs.len(): cs[pos] else: ""

fn expr() -> int:
  v = term()
  while true:
    c = peek()
    if c == "+":
      pos += 1
      v = v + term()
    elif c == "-":
      pos += 1
      v = v - term()
    else:
      break
  v

fn term() -> int:
  v = unary()
  while true:
    c = peek()
    if c == "*":
      pos += 1
      v = v * unary()
    elif c == "/":
      pos += 1
      d = unary()
      if d == 0:
        bad = true
      else:
        v = v / d
    else:
      break
  v

fn unary() -> int:
  c = peek()
  if c == "-":
    pos += 1
    return 0 - unary()
  if c == "+":
    pos += 1
    return unary()
  if c == "(":
    pos += 1
    v = expr()
    peek()
    pos += 1
    return v
  n = 0
  while pos < cs.len() and cs[pos].is_digit():
    n = n * 10 + cs[pos].digit()
    pos += 1
  n

for l in lines():
  if l.trim().is_empty(): continue
  cs = l.chars()
  pos = 0
  bad = false
  r = expr()
  if bad: print("error") else: print(r)
