fn is_red(v: Json) -> bool:
  match v:
    Str(s) => s == "red"
    _ => false

fn total(j: Json) -> f64:
  match j:
    Num(n) => n
    Arr(xs) => xs.fold(0.0, (a, x) => a + total(x))
    Obj(m) =>
      if m.values().any(v => is_red(v)):
        0.0
      else:
        m.values().fold(0.0, (a, x) => a + total(x))
    _ => 0.0

doc = stdin()
j = json(doc)
print(total(j).int())
