counts: {str: int} = {}
mss: {str: [int]} = {}
errs: {str: int} = {}
sums: {str: int} = {}

for line in lines():
  w = line.words()
  if w.is_empty():
    continue
  p = w[1]
  status = w[2].int()
  ms = w[3].int()
  if not counts.has(p):
    counts[p] = 0
    mss[p] = []
    errs[p] = 0
    sums[p] = 0
  counts[p] += 1
  sums[p] += ms
  mss[p].push(ms)
  if status >= 500:
    errs[p] += 1

paths = counts.keys().sort()
for p in paths:
  n = counts[p]
  avg = sums[p].float() / n.float()
  xs = mss[p].sort()
  need = (9 * n + 9) // 10
  p90 = xs[need - 1]
  err = errs[p].float() * 100.0 / n.float()
  a = avg.fmt(1)
  e = err.fmt(1)
  print("{p} {n} {a} {p90} {e}%")
