adj: {str: [str]} = {}
indeg: {str: int} = {}

for line in lines():
  if line.trim().is_empty():
    continue
  p = line.split("->")
  a = p[0].trim()
  b = p[1].trim()
  if not indeg.has(a):
    indeg[a] = 0
  if not indeg.has(b):
    indeg[b] = 0
  if not adj.has(a):
    adj[a] = []
  adj[a].push(b)
  indeg[b] += 1

h: heap[str] = heap()
for k in indeg.keys():
  if indeg[k] == 0:
    h.push(k)

out: [str] = []
while not h.is_empty():
  n = h.pop()
  out.push(n)
  if adj.has(n):
    for m in adj[n]:
      indeg[m] -= 1
      if indeg[m] == 0:
        h.push(m)

if out.len() < indeg.len():
  print("cycle")
else:
  for n in out:
    print(n)
