fn is_red(j: Json) -> bool {
  match j {
    Str(s) => s == "red"
    _ => false
  }
}

fn has_red(m: {str: Json}) -> bool {
  for v in m.values() {
    if is_red(v) {
      return true
    }
  }
  false
}

fn sum_arr(xs: [Json]) -> f64 {
  s = 0.0
  for x in xs {
    s += total(x)
  }
  s
}

fn sum_vals(m: {str: Json}) -> f64 {
  s = 0.0
  for v in m.values() {
    s += total(v)
  }
  s
}

fn total(j: Json) -> f64 {
  match j {
    Num(n) => n
    Arr(xs) => sum_arr(xs)
    Obj(m) => if has_red(m) { 0.0 } else { sum_vals(m) }
    _ => 0.0
  }
}

fn main() {
  j = json(stdin())
  print(total(j).int())
}
