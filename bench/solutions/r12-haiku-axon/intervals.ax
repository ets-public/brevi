ivs: [(int, int)] = []
for line in lines() {
  if line.trim().is_empty() {
    continue
  }
  p = line.ints()
  ivs.push((p[0], p[1]))
}
ivs = ivs.sort()
merged: [(int, int)] = []
for (s, e) in ivs {
  if merged.len() > 0 and s <= merged[-1].1 {
    last = merged.pop()
    merged.push((last.0, max(last.1, e)))
  } else {
    merged.push((s, e))
  }
}
total = 0
for (s, e) in merged {
  print("{s} {e}")
  total += e - s
}
print("total {total}")
