fn score(cards: [str]) -> (int, int):
  rs: [int] = []
  ss: [str] = []
  for c in cards:
    rs.push("23456789TJQKA".find(c.slice(0, 1)) + 2)
    ss.push(c.slice(1, 2))
  cnt: {int: int} = {}
  for r in rs: cnt[r] += 1
  groups: [(int, int)] = []
  for r in cnt.keys(): groups.push((cnt[r], r))
  groups.sort_by(g => (-g.0, -g.1))
  flush = ss.unique().len() == 1
  sr = rs.sort()
  straight = false
  high = 0
  if cnt.len() == 5:
    if sr[4] - sr[0] == 4:
      straight = true
      high = sr[4]
    elif sr[0] == 2 and sr[1] == 3 and sr[2] == 4 and sr[3] == 5 and sr[4] == 14:
      straight = true
      high = 5
  tb: [int] = []
  for g in groups: tb.push(g.1)
  c0 = groups[0].0
  c1 = groups[1].0
  cat = 0
  if flush and straight:
    cat = 8
    tb = [high]
  elif c0 == 4:
    cat = 7
  elif c0 == 3 and c1 == 2:
    cat = 6
  elif flush:
    cat = 5
  elif straight:
    cat = 4
    tb = [high]
  elif c0 == 3:
    cat = 3
  elif c0 == 2 and c1 == 2:
    cat = 2
  elif c0 == 2:
    cat = 1
  enc = cat
  k = 0
  for v in tb:
    enc = enc * 15 + v
    k += 1
  while k < 5:
    enc = enc * 15
    k += 1
  return (enc, cat)

fn main():
  cats = ["high card", "pair", "two pair", "three of a kind", "straight", "flush", "full house", "four of a kind", "straight flush"]
  rows = lines()
  rounds = 0
  players: [(int, str, int)] = []
  names: {str: bool} = {}
  dealt: {str: bool} = {}
  active = false
  for i in 0..rows.len() + 1:
    at_end = i == rows.len()
    raw = ""
    if not at_end: raw = rows[i]
    ln = i + 1
    if at_end or raw.trim().is_empty():
      if active:
        rounds += 1
        print("round {rounds}")
        if players.is_empty():
          print("no players")
        else:
          players.sort_by(p => (-p.0, p.1))
          pos = 0
          prev = -1
          for idx in 0..players.len():
            p = players[idx]
            if p.0 != prev:
              pos = idx + 1
              prev = p.0
            nm = p.1
            cn = cats[p.2]
            print("{pos}. {nm} {cn}")
        players = []
        names = {}
        dealt = {}
        active = false
      if at_end: break
      continue
    active = true
    words = raw.split()
    ok = words.len() == 6
    cards: [str] = []
    if ok:
      cards = words.slice(1, 6)
      for c in cards:
        if c.len() != 2 or not "23456789TJQKA".contains(c.slice(0, 1)) or not "SHDC".contains(c.slice(1, 2)):
          ok = false
    if not ok or cards.unique().len() != 5:
      print("line {ln}: bad hand")
      continue
    name = words[0]
    if names.has(name):
      print("line {ln}: duplicate player")
      continue
    hit = ""
    for c in cards:
      if dealt.has(c):
        hit = c
        break
    if hit != "":
      print("line {ln}: card {hit} already dealt")
      continue
    names[name] = true
    for c in cards: dealt[c] = true
    sc = score(cards)
    players.push((sc.0, name, sc.1))
  print("{rounds} rounds")
