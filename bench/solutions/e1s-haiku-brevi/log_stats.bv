paths = {}
errs = {}
for line in lines():
  p = line.words()
  if len(p) < 4: continue
  path = p[1]
  st = p[2].int().or(0)
  ms = p[3].int().or(0)
  paths[path] = paths.get_or(path, []) + [ms]
  if st >= 500:
    errs[path] = errs.get_or(path, 0) + 1

for path in paths.keys().sort():
  xs = paths[path].sort()
  n = xs.len()
  total = xs.sum()
  avg = total.float() / n.float()
  k = (9 * n + 9) // 10
  p90 = xs[k - 1]
  e = errs.get_or(path, 0)
  pct = e.float() * 100.0 / n.float()
  print("{path} {n} {avg.fmt(1)} {p90} {pct.fmt(1)}%")
