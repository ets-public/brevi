fn to_roman(n: int) -> str {
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var num = n
  var out = ""
  for i in 0..13 {
    while num >= vals[i] {
      out += syms[i]
      num -= vals[i]
    }
  }
  return out
}

fn main() ! {
  for line in stdin().lines() {
    let t = line.trim()
    if t.is_empty() { continue }
    print(to_roman(t.int()?))
  }
}
