fn main() ! {
  var names: [str] = []
  var scores: [int] = []
  for line in stdin().lines() {
    let t = line.trim()
    if t.is_empty() { continue }
    let p = t.split(" ")
    names.push(p[0])
    scores.push(p[1].int()?)
  }
  let sorted = scores.sort()
  let n = sorted.len()
  var tenths = 0
  if n % 2 == 1 {
    tenths = sorted[n / 2] * 10
  } else {
    tenths = (sorted[n / 2 - 1] + sorted[n / 2]) * 5
  }
  print(str(tenths / 10) + "." + str(tenths % 10))
  let best = scores.max()
  var winners: [str] = []
  for i in 0..names.len() {
    if scores[i] == best {
      winners.push(names[i])
    }
  }
  for w in winners.sort() {
    print(w)
  }
}
