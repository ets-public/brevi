toks: [str] = []
pos = 0

fn tokenize(s: str) -> [str]:
  out: [str] = []
  cur = ""
  for c in s.chars():
    if c.is_digit():
      cur += c
    else:
      if cur != "":
        out.push(cur)
      cur = ""
      if c != " ":
        out.push(c)
  if cur != "":
    out.push(cur)
  out

fn peek() -> str:
  if pos < toks.len():
    return toks[pos]
  ""

fn parse_factor() -> int:
  t = peek()
  if t == "-":
    pos += 1
    return 0 - parse_factor()
  if t == "(":
    pos += 1
    v = parse_expr()
    pos += 1
    return v
  pos += 1
  t.int()

fn parse_term() -> int:
  v = parse_factor()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = parse_factor()
    if op == "*":
      v = v * r
    else:
      if r == 0:
        fail("division by zero")
      v = v / r
  v

fn parse_expr() -> int:
  v = parse_term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = parse_term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  v

fn eval_line(s: str) -> int:
  toks = tokenize(s)
  pos = 0
  parse_expr()

for line in lines():
  if line.trim() == "":
    continue
  match eval_line(line):
    Ok(v) => print(v)
    Err(m) => print("error")
