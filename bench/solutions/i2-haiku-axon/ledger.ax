rows = csv(stdin())
zero = "0".dec()
inM: {str: dec} = {}
outM: {str: dec} = {}
bal: {str: dec} = {}
for row in rows.skip(1):
  if row.len() < 3:
    continue
  m = row[0].slice(0, 7)
  acct = row[1]
  amt = row[2].trim().dec()
  inM[m] += zero
  outM[m] += zero
  if amt > zero:
    inM[m] += amt
  else:
    outM[m] += zero - amt
  bal[acct] += amt

for m in inM.keys().sort():
  i = inM[m]
  o = outM[m]
  print("{m} {i.fmt(2)} {o.fmt(2)} {(i - o).fmt(2)}")

pairs: [(dec, str)] = []
for a in bal.keys():
  pairs.push((bal[a], a))
pairs = pairs.sort_by(p => (-p.0, p.1))
if not pairs.is_empty():
  print("top {pairs[0].1} {pairs[0].0.fmt(2)}")
