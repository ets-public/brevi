ms: {str: [int]} = {}
errs: {str: int} = {}
for line in lines():
  p = line.words()
  if p.len() < 4:
    continue
  path = p[1]
  status = p[2].int().or(0)
  if not ms.has(path):
    ms[path] = []
    errs[path] = 0
  ms[path].push(p[3].int().or(0))
  if status >= 500:
    errs[path] += 1

for path in ms.keys():
  xs = ms[path].sort()
  n = xs.len()
  total = xs.sum()
  avg = total.float() / n.float()
  k = (9 * n + 9) // 10
  p90 = xs[k - 1]
  err = errs[path].float() * 100.0 / n.float()
  print("{path} {n} {avg.fmt(1)} {p90} {err.fmt(1)}%")
