ls: [str] = []
for line in lines():
  if line.trim() != "":
    ls.push(line.trim())

q = ls[ls.len() - 1].words()
frm = q[0]
to = q[1]

adj: {str: [(int, str)]} = {}
for line in ls.slice(0, ls.len() - 1):
  p = line.words()
  a = p[0]
  b = p[1]
  w = p[2].int().or(0)
  if not adj.has(a):
    adj[a] = []
  if not adj.has(b):
    adj[b] = []
  adj[a].push((w, b))
  adj[b].push((w, a))

dist: {str: int} = {}
dist[to] = 0
h = heap()
h.push((0, to))
while not h.is_empty():
  (d, u) = h.pop()
  if d > dist[u]:
    continue
  for (w, v) in adj[u]:
    nd = d + w
    if not dist.has(v) or nd < dist[v]:
      dist[v] = nd
      h.push((nd, v))

if not dist.has(frm):
  print("none")
else:
  path: [str] = [frm]
  cur = frm
  while cur != to:
    best = ""
    for (w, v) in adj[cur]:
      if dist.has(v) and dist[v] + w == dist[cur]:
        if best == "" or v < best:
          best = v
    cur = best
    path.push(cur)
  print(dist[frm])
  print(path.join("->"))
