fn check(s: str) -> str:
  stack: [str] = []
  i = 0
  for c in s.chars():
    i += 1
    if c == "(" or c == "[" or c == "{":
      stack.push(c)
    elif c == ")" or c == "]" or c == "}":
      want = "("
      if c == "]":
        want = "["
      elif c == "}":
        want = "{"
      if stack.is_empty() or stack.pop() != want:
        return "error at {i}"
  if stack.is_empty():
    return "ok"
  return "error at {s.len() + 1}"

for line in lines():
  print(check(line))
