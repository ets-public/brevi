fn digit(c: str) -> int:
  if c == "I":
    return 1
  if c == "V":
    return 5
  if c == "X":
    return 10
  if c == "L":
    return 50
  if c == "C":
    return 100
  if c == "D":
    return 500
  if c == "M":
    return 1000
  return 0

fn roman_val(s: str) -> int:
  total = 0
  n = s.len()
  for i in 0..n:
    v = digit(s.slice(i, i + 1))
    if i + 1 < n and v < digit(s.slice(i + 1, i + 2)):
      total -= v
    else:
      total += v
  return total

fn to_roman(n: int) -> str:
  vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  out = ""
  m = n
  for i in 0..vals.len():
    while m >= vals[i]:
      out += syms[i]
      m -= vals[i]
  return out

for line in lines():
  p = line.words()
  if p.is_empty():
    continue
  acc = roman_val(p[0])
  i = 1
  while i + 1 < p.len():
    v = roman_val(p[i + 1])
    if p[i] == "+":
      acc += v
    else:
      acc -= v
    i += 2
  if acc <= 0:
    print("nulla")
  else:
    print(to_roman(acc))
