data: {str: [int]} = {}
errs: {str: int} = {}
for line in lines() {
  w = line.words()
  if w.len() >= 4 {
    path = w[1]
    status = w[2].int().or(0)
    ms = w[3].int().or(0)
    data[path].push(ms)
    if status >= 500 {
      errs[path] += 1
    }
  }
}

for p in data.keys().sort() {
  ms = data[p].sort()
  n = ms.len()
  avg = (ms.sum().float() / n.float()).fmt(1)
  idx = (9 * n + 9) / 10 - 1
  p90 = ms[idx]
  e = errs.get_or(p, 0)
  errp = (e.float() * 100.0 / n.float()).fmt(1)
  print("{p} {n} {avg} {p90} {errp}%")
}
