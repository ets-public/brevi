fn is_red(j: Json) -> bool {
  match j {
    Str(s) => s == "red"
    _ => false
  }
}

fn total(j: Json) -> f64 {
  match j {
    Num(n) => n
    Arr(xs) => xs.fold(0.0, (a, x) => a + total(x))
    Obj(m) => {
      if m.values().any(v => is_red(v)) {
        0.0
      } else {
        m.values().fold(0.0, (a, x) => a + total(x))
      }
    }
    _ => 0.0
  }
}

text = stdin()
print(total(json(text)).int())
