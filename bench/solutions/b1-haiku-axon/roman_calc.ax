fn rval(c: str) -> int {
  if c == "I" {
    1
  } else if c == "V" {
    5
  } else if c == "X" {
    10
  } else if c == "L" {
    50
  } else if c == "C" {
    100
  } else if c == "D" {
    500
  } else {
    1000
  }
}

fn from_roman(s: str) -> int {
  total = 0
  chars = s.chars()
  n = chars.len()
  for i in 0..n {
    v = rval(chars[i])
    if i + 1 < n and v < rval(chars[i + 1]) {
      total -= v
    } else {
      total += v
    }
  }
  total
}

fn to_roman(x: int) -> str {
  vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  out = ""
  n = x
  for i in 0..vals.len() {
    while n >= vals[i] {
      out = out + syms[i]
      n -= vals[i]
    }
  }
  out
}

for line in lines() {
  w = line.words()
  if w.len() > 0 {
    total = from_roman(w[0])
    i = 1
    while i + 1 < w.len() {
      v = from_roman(w[i + 1])
      if w[i] == "+" {
        total += v
      } else {
        total -= v
      }
      i += 2
    }
    if total <= 0 {
      print("nulla")
    } else {
      print(to_roman(total))
    }
  }
}
