fn digit_val(c: str) -> int:
  vals = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
  return vals[c]

fn roman_val(s: str) -> int:
  total = 0
  for i in 0..s.len():
    v = digit_val(s[i:i + 1])
    if i + 1 < s.len() and v < digit_val(s[i + 1:i + 2]):
      total -= v
    else:
      total += v
  return total

fn to_roman(n: int) -> str:
  table = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]
  out = ""
  rest = n
  for t in table:
    while rest >= t.0:
      out += t.1
      rest -= t.0
  return out

fn main():
  for line in lines():
    parts = line.words()
    if parts.is_empty():
      continue
    acc = roman_val(parts[0])
    i = 1
    while i + 1 < parts.len():
      num = roman_val(parts[i + 1])
      if parts[i] == "+":
        acc += num
      else:
        acc -= num
      i += 2
    if acc <= 0:
      print("nulla")
    else:
      print(to_roman(acc))
