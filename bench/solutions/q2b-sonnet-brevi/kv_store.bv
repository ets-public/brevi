store = {}
stack = []
fn isint(s: str) -> bool = not s.re_full('[+-]?\d+').is_empty()
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  c = w[0]
  n = w.len()
  if c == "SET" and n == 3:
    store[w[1]] = w[2]
  elif c == "GET" and n == 2:
    print(if store.has(w[1]): store[w[1]] else: "NULL")
  elif c == "DEL" and n == 2:
    if store.has(w[1]): store.remove(w[1])
    else: print("NOT FOUND")
  elif c == "INCR" and n == 3:
    cur = if store.has(w[1]): store[w[1]] else: "0"
    if isint(cur) and isint(w[2]):
      v = cur.int() + w[2].int()
      store[w[1]] = str(v)
      print(v)
    else: print("ERR not an integer")
  elif c == "COUNT" and n == 2:
    print(store.values().count(x => x == w[1]))
  elif c == "KEYS" and n == 2:
    ks = [k for k in store.keys() if k.starts_with(w[1])]
    print(if ks: " ".join(ks) else: "(empty)")
  elif c == "BEGIN" and n == 1:
    stack.push(store)
  elif c == "ROLLBACK" and n == 1:
    if stack: store = stack.pop()
    else: print("NO TRANSACTION")
  elif c == "COMMIT" and n == 1:
    if stack: stack = []
    else: print("NO TRANSACTION")
  else:
    print("ERR unknown command")
