dur: {str: int} = {}
deps: {str: [str]} = {}
names: [str] = []
for line in lines() {
  p = line.words()
  if p.len() >= 2 {
    names.push(p[0])
    dur[p[0]] = p[1].int()
    deps[p[0]] = p.skip(3)
  }
}
valid = true
for n in names {
  for d in deps[n] { if !dur.has(d) { valid = false } }
}
start: {str: int} = {}
fin: {str: int} = {}
if valid {
  progress = true
  while progress {
    progress = false
    for n in names {
      if !start.has(n) {
        ok = true
        s = 0
        for d in deps[n] {
          if fin.has(d) { s = max(s, fin[d]) } else { ok = false }
        }
        if ok {
          start[n] = s
          fin[n] = s + dur[n]
          progress = true
        }
      }
    }
  }
  if start.len() != dur.len() { valid = false }
}
if !valid {
  print("invalid")
} else {
  items = names.map(n => (start[n], n)).sort()
  total = 0
  for (s, n) in items {
    print("{n} {s} {fin[n]}")
    total = max(total, fin[n])
  }
  print("total {total}")
}
