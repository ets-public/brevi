fn make_names(c: int, m: int, v: int) -> [str]:
  names = []
  for i in range(1, c + 1):
    names.push("C" + str(i))
  for i in range(1, m + 1):
    names.push("M" + str(i))
  for i in range(1, v + 1):
    names.push("V" + str(i))
  return names

fn lowest_free(names: [str], occ: [str], kind: str) -> int:
  for i in range(0, names.len()):
    if names[i].slice(0, 1) == kind and occ[i] == "":
      return i
  return -1

fn park(names: [str], mut occ: [str], plate: str, vtype: str) -> str:
  i = -1
  if vtype == "van":
    i = lowest_free(names, occ, "V")
  elif vtype == "car":
    i = lowest_free(names, occ, "C")
  else:
    i = lowest_free(names, occ, "M")
    if i < 0:
      i = lowest_free(names, occ, "C")
  if i < 0:
    return ""
  occ[i] = plate
  return names[i]

fn release(names: [str], mut occ: [str], space: str):
  i = names.index_of(space)
  if i >= 0:
    occ[i] = ""

fn occupied(names: [str], occ: [str], kind: str) -> int:
  n = 0
  for i in range(0, names.len()):
    if names[i].slice(0, 1) == kind and occ[i] != "":
      n += 1
  return n
