use "catalog.bv"
use "rules.bv"

lib = Lib()
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  today = date(w[0]).days
  expire(lib, today)
  op = w[1]
  if op == "BOOK":
    add_book(lib, w[2], w[3].int(), w.skip(4).join(" "))
  elif op == "MEMBER":
    add_member(lib, w[2], w[3], w.skip(4).join(" "))
  elif op == "LOAN":
    do_loan(lib, today, w[2], w[3])
  elif op == "RETURN":
    do_return(lib, today, w[2], w[3])
  elif op == "RESERVE":
    do_reserve(lib, w[2], w[3])
  elif op == "PAY":
    do_pay(lib, w[2], w[3])
  elif op == "STATUS":
    do_status(lib, w[2])
