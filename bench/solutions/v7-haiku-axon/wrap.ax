all = lines()
width = all[0].trim().int().or(1)
paras = []
cur = []
for ln in all.skip(1):
  ws = ln.words()
  if ws.is_empty():
    if not cur.is_empty():
      paras.push(cur)
      cur = []
  else:
    for x in ws:
      cur.push(x)
if not cur.is_empty():
  paras.push(cur)

first_p = true
for p in paras:
  if not first_p:
    print("")
  first_p = false
  cur_line = ""
  for word in p:
    if cur_line.is_empty():
      cur_line = word
    elif cur_line.len() + 1 + word.len() <= width:
      cur_line = cur_line + " " + word
    else:
      print(cur_line)
      cur_line = word
  print(cur_line)
