nums = stdin().ints()
rows = nums[0]
cols = nums[1]
g = []
for i in 0..rows:
  row = []
  for j in 0..cols:
    row.push(nums[2 + i * cols + j])
  g.push(row)

out = []
top = 0
bot = rows - 1
left = 0
right = cols - 1
while top <= bot and left <= right:
  for j in left..right + 1:
    out.push(g[top][j])
  top += 1
  if top <= bot:
    for i in top..bot + 1:
      out.push(g[i][right])
  right -= 1
  if top <= bot and left <= right:
    for j in 0..(right - left + 1):
      out.push(g[bot][right - j])
  bot -= 1
  if left <= right and top <= bot:
    for i in 0..(bot - top + 1):
      out.push(g[bot - i][left])
  left += 1

print(out.join(" "))
sums = []
for j in 0..cols:
  s = 0
  for i in 0..rows:
    s += g[i][j]
  sums.push(s)
print(sums.join(" "))
