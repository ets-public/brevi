rows = csv(stdin())
ins = {}
outs = {}
bal = {}
for r in rows.skip(1):
  if r.len() < 3: continue
  m = r[0].slice(0, 7)
  a = r[2].dec()
  if not ins.has(m):
    ins[m] = 0.dec()
    outs[m] = 0.dec()
  if a > 0:
    ins[m] += a
  else:
    outs[m] += 0 - a
  bal[r[1]] += a
for m in ins.keys():
  print("{m} {ins[m].fmt(2)} {outs[m].fmt(2)} {(ins[m] - outs[m]).fmt(2)}")
best = ""
bv = 0.dec()
first = true
for p in bal.pairs():
  if first or p.1 > bv:
    best = p.0
    bv = p.1
    first = false
print("top {best} {bv.fmt(2)}")
