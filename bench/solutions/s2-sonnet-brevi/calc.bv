pos = 0
toks = []

fn atom() -> int:
  t = toks[pos]
  pos += 1
  if t == "(":
    v = expr()
    pos += 1
    return v
  if t == "-":
    return 0 - atom()
  t.int()

fn term() -> int:
  v = atom()
  while pos < toks.len() and (toks[pos] == "*" or toks[pos] == "/"):
    op = toks[pos]
    pos += 1
    r = atom()
    if op == "*":
      v = v * r
    else:
      if r == 0: fail("div")
      v = v / r
  v

fn expr() -> int:
  v = term()
  while pos < toks.len() and (toks[pos] == "+" or toks[pos] == "-"):
    op = toks[pos]
    pos += 1
    r = term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  v

fn run(line: str) -> int:
  toks = line.re_list("\d+|[-+*/()]")
  pos = 0
  expr()

for line in lines():
  if line.trim():
    match run(line):
      Ok(v) => print(v)
      Err(m) => print("error")
