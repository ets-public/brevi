j = json(stdin())
total_rev = 0.dec()
out = []
for o in j["orders"]:
  id = o["id"]
  cid = o["customer"].text()
  if not j["customers"].has(cid):
    out.push(str({"id": id, "error": "unknown customer {cid}"}))
    continue
  cust = j["customers"][cid]
  bad = ""
  for l in o["lines"]:
    if bad == "" and not j["products"].has(l["sku"].text()):
      bad = l["sku"].text()
  if bad != "":
    out.push(str({"id": id, "error": "unknown sku {bad}"}))
    continue
  qtys = {}
  for l in o["lines"]:
    qtys[j["products"][l["sku"].text()]["category"].text()] += l["qty"].int()
  sub = 0.dec()
  disc = 0.dec()
  cat_amt = {}
  for l in o["lines"]:
    p = j["products"][l["sku"].text()]
    a = p["price"].text().dec() * l["qty"].int()
    sub += a
    cat_amt[p["category"].text()] += a
  after = 0.dec()
  for c, a in cat_amt.pairs():
    if qtys[c] >= 3:
      d = (a * "0.05".dec()).round(2)
      disc += d
      after += a - d
    else:
      after += a
  tier = cust["tier"].text()
  rate = if tier == "gold": "0.10".dec() elif tier == "silver": "0.05".dec() else: 0.dec()
  td = (after * rate).round(2)
  disc += td
  net = sub - disc
  country = cust["country"].text()
  trate = if country == "UK": "0.20".dec() elif country == "US": "0.0825".dec() else: 0.dec()
  tax = (net * trate).round(2)
  tot = net + tax
  total_rev += tot
  out.push(str({"id": id, "customer": cust["name"].text(), "subtotal": sub.fmt(2), "discount": disc.fmt(2), "tax": tax.fmt(2), "total": tot.fmt(2)}))
print("[" + ",".join(out) + "]")
print("revenue {total_rev.fmt(2)}")
