ls = lines()
n = ls[0].trim().int()
order = []
vals = {}
for line in ls[1:]:
  w = line.words()
  if w.len() < 2:
    continue
  k = w[1]
  if w[0] == "get":
    if vals.has(k):
      order.remove(order.index_of(k))
      order.push(k)
      print(vals[k])
    else:
      print(-1)
  else:
    if vals.has(k):
      order.remove(order.index_of(k))
    elif vals.len() >= n:
      old = order.remove(0)
      vals.remove(old)
    order.push(k)
    vals[k] = w[2]
