requests = 0
malformed = 0
bytes = 0
ips = {}
classes = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  g = line.re_full("(\S+) - - \[([^\]]*)\] \"(\S+) (\S+) (\S+)\" (\d{3}) (\d+|-) \"([^\"]*)\" \"([^\"]*)\"")
  if g.is_empty():
    malformed += 1
    continue
  requests += 1
  ip = g[1]
  ips[ip] += 1
  path = g[4].split("?")[0]
  paths[path] += 1
  st = g[6].int()
  classes[st // 100] += 1
  if g[7] != "-": bytes += g[7].int()
  hours[g[2].slice(12, 14)] += 1
  if g[9].lower().contains("bot"): bots += 1
  if st >= 400: errs[ip] += 1
print("requests {requests}")
print("malformed {malformed}")
print("bytes {bytes}")
print("unique_ips {ips.len()}")
print("status")
for c, n in classes.pairs():
  print("  {c}xx {n}")
print("top_paths")
tp = paths.pairs().sort_by(p => (-p.1, p.0))
for p in tp.take(3):
  print("  {p.1} {p.0}")
print("hours")
mx = hours.values().max().or(1)
for h, n in hours.pairs():
  k = max((n * 40 + mx) // (2 * mx), 1)
  print("  {h} {n} {"#".repeat(k)}")
print("bots {bots}")
print("errors_by_ip")
ep = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for p in ep:
  print("  {p.0} {p.1}")
