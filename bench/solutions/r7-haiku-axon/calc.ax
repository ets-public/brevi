var toks: [str] = []
var pos = 0
var bad = false

fn tokenize(s: str) -> [str] {
  var out: [str] = []
  var num = ""
  for c in s.chars() {
    if c.is_digit() {
      num += c
    } else {
      if num != "" {
        out.push(num)
        num = ""
      }
      if c != " " and c != "\t" and c != "\r" {
        out.push(c)
      }
    }
  }
  if num != "" { out.push(num) }
  return out
}

fn peek() -> str {
  if pos < toks.len() { return toks[pos] }
  return ""
}

fn factor() -> int {
  let t = peek()
  if t == "-" {
    pos += 1
    return 0 - factor()
  }
  if t == "(" {
    pos += 1
    let v = expr()
    pos += 1
    return v
  }
  pos += 1
  return t.int().or(0)
}

fn term() -> int {
  var v = factor()
  while peek() == "*" or peek() == "/" {
    let op = peek()
    pos += 1
    let r = factor()
    if op == "*" {
      v = v * r
    } else {
      if r == 0 {
        bad = true
        return 0
      }
      v = v / r
    }
  }
  return v
}

fn expr() -> int {
  var v = term()
  while peek() == "+" or peek() == "-" {
    let op = peek()
    pos += 1
    let r = term()
    if op == "+" {
      v = v + r
    } else {
      v = v - r
    }
  }
  return v
}

for line in lines() {
  if line.trim() != "" {
    toks = tokenize(line)
    pos = 0
    bad = false
    let v = expr()
    if bad {
      print("error")
    } else {
      print(v)
    }
  }
}
