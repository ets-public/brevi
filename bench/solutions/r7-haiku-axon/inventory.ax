let rows = csv(stdin())
var totals: {str: dec} = {}
let zero = "0".dec()?
let hundred = "100".dec()?
for r in rows.skip(1) {
  if r.len() >= 3 {
    let q = r[1].trim().int()?
    let v = q.dec() * r[2].trim().dec()?
    totals[r[0]] = totals.get_or(r[0], zero) + v
  }
}

var items: [(int, str)] = []
for (name, v) in totals.pairs() {
  let cents = (v * hundred).int()
  items.push((cents, name))
}
items = items.sort_by(p => (-p.0, p.1))
for (c, name) in items {
  let s = totals[name].fmt(2)
  print("{name}: {s}")
}
