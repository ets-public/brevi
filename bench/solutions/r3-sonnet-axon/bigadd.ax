fn main() ! {
  for line in lines() {
    let w = line.words()
    if w.len() < 2 { continue }
    let a = w[0].chars().rev()
    let b = w[1].chars().rev()
    let n = if a.len() > b.len() { a.len() } else { b.len() }
    var carry = 0
    var out: [str] = []
    for i in 0..n {
      var d = carry
      if i < a.len() { d += a[i].int()? }
      if i < b.len() { d += b[i].int()? }
      out.push(str(d % 10))
      carry = d / 10
    }
    if carry > 0 { out.push(str(carry)) }
    var r = out.rev()
    while r.len() > 1 and r[0] == "0" { r.remove(0) }
    print(r.join(""))
  }
}
