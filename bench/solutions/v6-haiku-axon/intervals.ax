iv = []
for line in lines():
  if line.trim().is_empty():
    continue
  p = line.ints()
  iv.push((p[0], p[1]))
iv = iv.sort()

res = []
cs = 0
ce = 0
has = false
for (s, e) in iv:
  if !has:
    cs = s
    ce = e
    has = true
  elif s <= ce:
    if e > ce:
      ce = e
  else:
    res.push((cs, ce))
    cs = s
    ce = e
if has:
  res.push((cs, ce))

total = 0
for (a, b) in res:
  print("{a} {b}")
  total += b - a
print("total {total}")
