ls = lines()
W = ls[0].trim().int().or(1)
paras: [[str]] = []
cur: [str] = []
for line in ls.slice(1):
  if line.trim().is_empty():
    if cur.len() > 0:
      paras.push(cur)
      cur = []
  else:
    cur = cur + line.words()
if cur.len() > 0:
  paras.push(cur)

outs = []
first = true
for para in paras:
  if !first:
    outs.push("")
  first = false
  cl = ""
  for w in para:
    if cl.is_empty():
      cl = w
    elif cl.len() + 1 + w.len() <= W:
      cl = cl + " " + w
    else:
      outs.push(cl)
      cl = w
  if !cl.is_empty():
    outs.push(cl)

for o in outs:
  print(o)
