fn sq(s: str, n: int) -> int:
  c = s.slice(0, 1).code() - 97
  r = s.slice(1).int().or(1) - 1
  r * n + c

fn dist_between(n: int, src: int, dst: int) -> int:
  dist = [-1].repeat(n * n)
  dist[src] = 0
  q = [src]
  qi = 0
  while qi < q.len():
    cur = q[qi]
    qi += 1
    if cur == dst:
      return dist[cur]
    cr = cur // n
    cc = cur % n
    for (dr, dc) in [(1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1)]:
      nr = cr + dr
      nc = cc + dc
      if nr >= 0 and nr < n and nc >= 0 and nc < n:
        ni = nr * n + nc
        if dist[ni] < 0:
          dist[ni] = dist[cur] + 1
          q.push(ni)
  -1

ls = lines()
n = ls[0].trim().int().or(1)
for line in ls.slice(1):
  p = line.words()
  if p.len() < 2:
    continue
  a = sq(p[0], n)
  b = sq(p[1], n)
  print(dist_between(n, a, b))
