rv: {str: int} = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}

fn roman_to_int(s: str) -> int:
  total = 0
  for i in 0..s.len():
    v = rv[s.slice(i, i + 1)]
    if i + 1 < s.len() and v < rv[s.slice(i + 1, i + 2)]:
      total -= v
    else:
      total += v
  total

fn to_roman(n: int) -> str:
  vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  out = ""
  m = n
  for i in 0..vals.len():
    while m >= vals[i]:
      out = out + syms[i]
      m -= vals[i]
  out

for line in lines():
  ws = line.words()
  if ws.len() == 0:
    continue
  result = roman_to_int(ws[0])
  i = 1
  while i + 1 < ws.len():
    v = roman_to_int(ws[i + 1])
    if ws[i] == "+":
      result += v
    else:
      result -= v
    i += 2
  if result <= 0:
    print("nulla")
  else:
    print(to_roman(result))
