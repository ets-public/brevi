out = []
toc = []
used = {}
kind = ""
buf = []

fn esc(s: str) -> str = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
fn fmt_plain(s: str) -> str:
  t = s.re_sub("\[([^\]]+)\]\(([^)]*)\)", "<a href=\"\2\">\1</a>")
  t = t.re_sub("\*\*(.+?)\*\*", "<strong>\1</strong>")
  t.re_sub("\*(.+?)\*", "<em>\1</em>")
fn inline(raw: str) -> str:
  s = esc(raw)
  parts = s.split("`")
  if parts.len() % 2 == 0:
    last = parts.pop()
    prev = parts.pop()
    parts.push(prev + "`" + last)
  r = ""
  for i, p in parts.enumerate():
    if i % 2 == 1: r += "<code>" + p + "</code>"
    else: r += fmt_plain(p)
  r
fn flush():
  if kind == "p":
    out.push("<p>" + " ".join(buf.map(l => inline(l))) + "</p>")
  elif kind == "ul":
    out.push("<ul>")
    for l in buf: out.push("<li>" + inline(l) + "</li>")
    out.push("</ul>")
  elif kind == "ol":
    out.push("<ol>")
    for l in buf: out.push("<li>" + inline(l) + "</li>")
    out.push("</ol>")
  kind = ""
  buf = []

incode = false
code = []
for line in lines():
  if incode:
    if line == "```":
      out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
      incode = false
      code = []
    else:
      code.push(esc(line))
    continue
  if line == "```":
    flush()
    incode = true
    continue
  if line.trim().is_empty():
    flush()
    continue
  h = line.re_full("(#{1,6}) (.*)")
  ul = line.re_full("- (.*)")
  ol = line.re_full("\d+\. (.*)")
  if h:
    flush()
    txt = h[2]
    id = esc(txt).lower().re_sub("[^a-z0-9]+", "-").re_sub("^-+", "").re_sub("-+$", "")
    id = txt.lower().re_sub("[^a-z0-9]+", "-").re_sub("^-+", "").re_sub("-+$", "")
    base = id
    used[base] += 1
    if used[base] > 1:
      n = used[base]
      id = "{base}-{n}"
      while used.has(id):
        n += 1
        id = "{base}-{n}"
      used[id] = 1
    lvl = h[1].len()
    out.push("<h{lvl} id=\"{id}\">{inline(txt)}</h{lvl}>")
    toc.push("<a href=\"#{id}\">{esc(txt.replace("`", "").replace("*", ""))}</a>")
  elif ul:
    if kind != "ul":
      flush()
      kind = "ul"
    buf.push(ul[1])
  elif ol:
    if kind != "ol":
      flush()
      kind = "ol"
    buf.push(ol[1])
  else:
    if kind != "p":
      flush()
      kind = "p"
    buf.push(line)
flush()
if incode:
  out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
if toc.len() >= 2:
  print("<nav>")
  for t in toc: print(t)
  print("</nav>")
for o in out: print(o)
