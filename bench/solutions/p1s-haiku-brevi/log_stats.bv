msl = {}
errs = {}
for line in lines():
  p = line.words()
  if p.len() >= 4:
    path = p[1]
    st = p[2].int().or(0)
    ms = p[3].int().or(0)
    msl[path].push(ms)
    if not errs.has(path):
      errs[path] = 0
    if st >= 500:
      errs[path] += 1

for path in sorted(msl.keys()):
  xs = sorted(msl[path])
  n = xs.len()
  avg = sum(xs).float() / n.float()
  k = (9 * n + 9) // 10
  p90 = xs[k - 1]
  e = errs[path].float() * 100.0 / n.float()
  print("{path} {n} {avg.fmt(1)} {p90} {e.fmt(1)}%")
