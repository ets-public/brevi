fn tokenize(s: str) -> [str]:
  out = []
  i = 0
  n = s.len()
  while i < n:
    c = s[i:i + 1]
    if c.is_digit():
      j = i
      while j < n and s[j:j + 1].is_digit():
        j += 1
      out.push(s.slice(i, j))
      i = j
    else:
      if c != " ":
        out.push(c)
      i += 1
  out

toks = []
pos = 0
bad = false

fn peek() -> str:
  if pos < toks.len():
    return toks[pos]
  return ""

fn atom() -> int:
  t = peek()
  if t == "(":
    pos += 1
    v = expr()
    pos += 1
    return v
  pos += 1
  return t.int().or(0)

fn unary() -> int:
  if peek() == "-":
    pos += 1
    return 0 - unary()
  return atom()

fn term() -> int:
  v = unary()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = unary()
    if op == "*":
      v = v * r
    else:
      if r == 0:
        bad = true
        return 0
      v = v / r
  return v

fn expr() -> int:
  v = term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  return v

for line in lines():
  if line.trim().is_empty():
    continue
  toks = tokenize(line)
  pos = 0
  bad = false
  v = expr()
  if bad:
    print("error")
  else:
    print(str(v))
