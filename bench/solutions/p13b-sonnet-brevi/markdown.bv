fn esc(s: str) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

fn fmt_plain(s: str) -> str:
  t = s.re_sub('\*\*(.+?)\*\*', "<strong>\1</strong>")
  t = t.re_sub('\*(.+?)\*', "<em>\1</em>")
  t.re_sub('\[([^\]]*)\]\(([^)]*)\)', '<a href="\2">\1</a>')

fn inline(s: str) -> str:
  e = esc(s)
  parts = e.split("`")
  if parts.len() % 2 == 0: return fmt_plain(e)
  res = ""
  for i, p in parts.enumerate():
    if i % 2 == 1: res += "<code>" + p + "</code>"
    else: res += fmt_plain(p)
  res

out = []
tocs = []
used = {}
ls = lines()
i = 0
n = ls.len()
while i < n:
  l = ls[i]
  if l.trim().is_empty():
    i += 1
  elif l == "```":
    i += 1
    code = []
    while i < n and ls[i] != "```":
      code.push(esc(ls[i]))
      i += 1
    i += 1
    out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
  elif not l.re_full('(#{1,6}) (.*)').is_empty():
    m = l.re_full('(#{1,6}) (.*)')
    lvl = m[1].len()
    raw = m[2]
    base = raw.lower().re_sub('[^a-z0-9]+', "-").re_sub('^-+|-+$', "")
    id = base
    k = 2
    while used.has(id):
      id = "{base}-{k}"
      k += 1
    used[id] = 1
    out.push('<h{lvl} id="{id}">{inline(raw)}</h{lvl}>')
    tocs.push('<a href="#{id}">{esc(raw.replace("`", "").replace("*", ""))}</a>')
    i += 1
  elif l.starts_with("- "):
    out.push("<ul>")
    while i < n and ls[i].starts_with("- "):
      out.push("<li>" + inline(ls[i].slice(2)) + "</li>")
      i += 1
    out.push("</ul>")
  elif not l.re_full('\d+\. (.*)').is_empty():
    out.push("<ol>")
    while i < n and not ls[i].re_full('\d+\. (.*)').is_empty():
      out.push("<li>" + inline(ls[i].re_full('\d+\. (.*)')[1]) + "</li>")
      i += 1
    out.push("</ol>")
  else:
    para = []
    while i < n and not ls[i].trim().is_empty() and ls[i] != "```" and ls[i].re_full('(#{1,6}) (.*)').is_empty() and not ls[i].starts_with("- ") and ls[i].re_full('\d+\. (.*)').is_empty():
      para.push(inline(ls[i]))
      i += 1
    out.push("<p>" + " ".join(para) + "</p>")
if tocs.len() >= 2:
  print("<nav>")
  for t in tocs: print(t)
  print("</nav>")
for o in out: print(o)
