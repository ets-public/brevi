fn check(line: str) -> str:
  st: [str] = []
  cs = line.chars()
  for i in 0..cs.len():
    c = cs[i]
    if c == "(" or c == "[" or c == "{": st.push(c)
    elif c == ")" or c == "]" or c == "}":
      want = if c == ")": "(" elif c == "]": "[" else: "{"
      if st.is_empty(): return "error at {i + 1}"
      if st.pop() != want: return "error at {i + 1}"
  if !st.is_empty(): return "error at {cs.len() + 1}"
  "ok"
for line in lines(): print(check(line))
