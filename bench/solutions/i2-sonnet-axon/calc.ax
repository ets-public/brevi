cs: [str] = []
pos = 0
fn peek() -> str = if pos < cs.len(): cs[pos] else: ""
fn expr() -> int:
  v = term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = term()
    if op == "+": v += r
    else: v -= r
  v
fn term() -> int:
  v = factor()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = factor()
    if op == "*": v *= r
    else:
      if r == 0: fail("div0")
      v = v / r
  v
fn factor() -> int:
  c = peek()
  if c == "-":
    pos += 1
    return 0 - factor()
  if c == "(":
    pos += 1
    v = expr()
    pos += 1
    return v
  n = 0
  while peek().is_digit():
    n = n * 10 + peek().digit()
    pos += 1
  n
fn calc(line: str) -> int:
  cs = line.replace(" ", "").chars()
  pos = 0
  expr()
for line in lines():
  if line.trim().is_empty(): continue
  match calc(line):
    Ok(v) => print(v)
    Err(_) => print("error")
