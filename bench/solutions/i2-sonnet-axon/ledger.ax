rows = csv(stdin())
inn: {str: dec} = {}
out: {str: dec} = {}
bal: {str: dec} = {}
for r in rows.skip(1):
  if r.len() < 3: continue
  m = r[0].slice(0, 7)
  a = r[2].dec()
  if !inn.has(m):
    inn[m] = 0.dec()
    out[m] = 0.dec()
  if a > 0.dec(): inn[m] += a
  else: out[m] += 0.dec() - a
  bal[r[1]] += a
for (m, i) in inn.pairs():
  print("{m} {i.fmt(2)} {out[m].fmt(2)} {(i - out[m]).fmt(2)}")
best = ""
bv = 0.dec()
first = true
for (k, v) in bal.pairs():
  if first or v > bv:
    best = k
    bv = v
    first = false
print("top {best} {bv.fmt(2)}")
