ls = lines()
cap = ls[0].trim().int()
vals: {str: int} = {}
order: [str] = []
fn touch(k: str):
  i = order.index_of(k)
  if i >= 0: order.remove(i)
  order.push(k)
for line in ls.skip(1):
  w = line.words()
  if w.len() == 0: continue
  if w[0] == "get":
    if vals.has(w[1]):
      print(vals[w[1]])
      touch(w[1])
    else: print(-1)
  else:
    k = w[1]
    if !vals.has(k) and vals.len() >= cap:
      old = order.remove(0)
      vals.remove(old)
    vals[k] = w[2].int()
    touch(k)
