dur: {str: int} = {}
deps: {str: [str]} = {}
for line in lines():
  w = line.words()
  if w.len() < 2: continue
  dur[w[0]] = w[1].int()
  deps[w[0]] = if w.len() > 3: w.skip(3) else: []
names = dur.keys()
bad = false
for n in names:
  for d in deps[n]:
    if !dur.has(d): bad = true
start: {str: int} = {}
fin: {str: int} = {}
if !bad:
  left = names
  while !left.is_empty():
    rest: [str] = []
    for n in left:
      if deps[n].all(d => fin.has(d)):
        s = 0
        for d in deps[n]: s = max(s, fin[d])
        start[n] = s
        fin[n] = s + dur[n]
      else: rest.push(n)
    if rest.len() == left.len():
      bad = true
      break
    left = rest
if bad: print("invalid")
else:
  ps = names.map(n => (start[n], n)).sort()
  t = 0
  for (s, n) in ps:
    print("{n} {s} {fin[n]}")
    t = max(t, fin[n])
  print("total {t}")
