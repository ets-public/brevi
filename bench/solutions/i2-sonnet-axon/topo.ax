succ: {str: [str]} = {}
indeg: {str: int} = {}
for line in lines():
  if line.trim().is_empty(): continue
  p = line.split("->")
  a = p[0].trim()
  b = p[1].trim()
  if !indeg.has(a): indeg[a] = 0
  if !indeg.has(b): indeg[b] = 0
  succ[a].push(b)
  indeg[b] += 1
h = heap()
for (k, d) in indeg.pairs():
  if d == 0: h.push(k)
out: [str] = []
while !h.is_empty():
  n = h.pop()
  out.push(n)
  if succ.has(n):
    for m in succ[n]:
      indeg[m] -= 1
      if indeg[m] == 0: h.push(m)
if out.len() < indeg.len(): print("cycle")
else:
  for o in out: print(o)
