type Book:
  id: str
  title: str
  shelf: int
  waiting: [str]

type Loan:
  book: str
  due: int

type Member:
  id: str
  name: str
  tier: str
  owed: int
  loans: [Loan]

type Hold:
  member: str
  book: str
  last: int

type Lib:
  books: {str: Book}
  members: {str: Member}
  holds: [Hold]

fn new_lib() -> Lib = Lib(books: {}, members: {}, holds: [])

fn fm(c: int) -> str:
  s = if c < 0: "-" else: ""
  a = abs(c)
  "{s}{a // 100}.{a % 100:02d}"

fn cents(s: str) -> int:
  parts = s.split(".")
  c = parts[0].int() * 100
  if parts.len() > 1:
    f = parts[1]
    if f.len() == 1: f = f + "0"
    c += f.int()
  c

fn day_str(d: int) -> str = str(date("1970-01-01").add_days(d))

fn tier_limit(t: str) -> int = if t == "plus": 5 else: 2
fn tier_days(t: str) -> int = if t == "plus": 28 else: 14
fn tier_fee(t: str) -> int = if t == "plus": 10 else: 25

fn add_book(mut lib: Lib, id: str, copies: int, title: str) -> str:
  if lib.books.has(id): return "duplicate ID"
  lib.books[id] = Book(id, title, copies, [])
  "added {id}"

fn add_member(mut lib: Lib, id: str, tier: str, name: str) -> str:
  if lib.members.has(id): return "duplicate ID"
  lib.members[id] = Member(id, name, tier, 0, [])
  "welcome {name}"
