## main.py
import sys

import graph
import schedule


def main():
    try:
        K, tasks = graph.parse(sys.stdin.read())
    except graph.PlanError as e:
        sys.stdout.write(e.msg + '\n')
        return
    problem = graph.find_problem(tasks)
    if problem is not None:
        sys.stdout.write(problem + '\n')
        return

    order = graph.topo(tasks)
    out = ['unlimited']
    start, end, L, chain = graph.unlimited(tasks, order)
    for t in tasks:
        out.append('  %s %d-%d' % (t.name, start[t.name], end[t.name]))
    out.append('length %d' % L)
    out.append('critical ' + ' > '.join(chain))

    s2, e2, L2 = schedule.schedule(tasks, order, K)
    out.append('workers %d' % K)
    for t in tasks:
        out.append('  %s %d-%d' % (t.name, s2[t.name], e2[t.name]))
    out.append('length %d' % L2)
    sys.stdout.write('\n'.join(out) + '\n')


main()
## graph.py
import re

NAME = r'[A-Za-z0-9_]+'
TASK_RE = re.compile(r'(%s)\s+([0-9]+)(?:\s+after\s+(%s(?:\s*,\s*%s)*))?' % (NAME, NAME, NAME))
WORKERS_RE = re.compile(r'workers\s+([0-9]+)')


class PlanError(Exception):
    def __init__(self, msg):
        Exception.__init__(self, msg)
        self.msg = msg


class Task:
    def __init__(self, name, days, deps):
        self.name = name
        self.days = days
        self.deps = deps  # unique dependency names, in the order they are named


def parse(text):
    """Return (K, tasks) or raise PlanError with the first problem found while reading."""
    K = None
    tasks = []
    seen = set()
    for lineno, raw in enumerate(text.split('\n'), 1):
        line = raw.strip()
        if not line:
            continue
        if K is None:
            m = WORKERS_RE.fullmatch(line)
            if not m or int(m.group(1)) < 1:
                raise PlanError('line %d: bad line' % lineno)
            K = int(m.group(1))
            continue
        m = TASK_RE.fullmatch(line)
        if not m or int(m.group(2)) < 1:
            raise PlanError('line %d: bad line' % lineno)
        name = m.group(1)
        days = int(m.group(2))
        deps = []
        if m.group(3) is not None:
            for d in re.split(r'\s*,\s*', m.group(3)):
                if d not in deps:
                    deps.append(d)
        if name in seen:
            raise PlanError('line %d: duplicate %s' % (lineno, name))
        seen.add(name)
        tasks.append(Task(name, days, deps))
    if K is None:
        raise PlanError('line 1: bad line')
    return K, tasks


def find_problem(tasks):
    """Return an error message for the first missing dependency or a cycle, else None."""
    names = set(t.name for t in tasks)
    for t in tasks:
        for d in t.deps:
            if d not in names:
                return 'unknown %s' % d
    if topo(tasks) is None:
        return 'cycle'
    return None


def dependents(tasks):
    """Map each task name to the names of tasks that depend on it, in input order."""
    dep = dict((t.name, []) for t in tasks)
    for t in tasks:
        for d in t.deps:
            dep[d].append(t.name)
    return dep


def topo(tasks):
    """Topological order (Kahn), or None when there is a cycle."""
    indeg = dict((t.name, len(t.deps)) for t in tasks)
    dep = dependents(tasks)
    queue = [t.name for t in tasks if indeg[t.name] == 0]
    i = 0
    while i < len(queue):
        n = queue[i]
        i += 1
        for s in dep[n]:
            indeg[s] -= 1
            if indeg[s] == 0:
                queue.append(s)
    if len(queue) != len(tasks):
        return None
    return queue


def unlimited(tasks, order):
    """Earliest-start plan. Returns (start, end, length, critical chain names)."""
    by = dict((t.name, t) for t in tasks)
    dep = dependents(tasks)
    start = {}
    end = {}
    for n in order:
        t = by[n]
        s = max([end[d] for d in t.deps] or [0])
        start[n] = s
        end[n] = s + t.days
    L = max(end.values()) if end else 0

    # good[n]: a chain of gapless dependencies runs from n to a task ending at L
    good = {}
    for n in reversed(order):
        good[n] = end[n] == L or any(good[s] and start[s] == end[n] for s in dep[n])

    chain = []
    for t in tasks:
        if start[t.name] == 0 and good[t.name]:
            chain.append(t.name)
            break
    while chain and end[chain[-1]] != L:
        cur = chain[-1]
        nxt = None
        for s in dep[cur]:
            if good[s] and start[s] == end[cur]:
                nxt = s
                break
        if nxt is None:
            break
        chain.append(nxt)
    return start, end, L, chain
## schedule.py
from graph import dependents


def tails(tasks, order):
    by = dict((t.name, t) for t in tasks)
    dep = dependents(tasks)
    tail = {}
    for n in reversed(order):
        tail[n] = by[n].days + max([tail[s] for s in dep[n]] or [0])
    return tail


def schedule(tasks, order, K):
    """Plan with K workers. Returns (start, end, length)."""
    by = dict((t.name, t) for t in tasks)
    tail = tails(tasks, order)
    index = dict((t.name, i) for i, t in enumerate(tasks))
    start = {}
    end = {}
    running = []
    T = 0
    while len(start) < len(tasks):
        # finish tasks that end at T (they free their workers)
        running = [n for n in running if end[n] > T]
        ready = [t.name for t in tasks
                 if t.name not in start
                 and all(d in end and end[d] <= T for d in t.deps)]
        ready.sort(key=lambda n: (-tail[n], index[n]))
        for n in ready:
            if len(running) >= K:
                break
            start[n] = T
            end[n] = T + by[n].days
            running.append(n)
        if len(start) == len(tasks):
            break
        T = min(end[n] for n in running)
    L = max(end.values()) if end else 0
    return start, end, L
