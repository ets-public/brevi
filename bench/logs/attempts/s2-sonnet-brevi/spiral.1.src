ls = lines()
rc = ls[0].ints()
r = rc[0]
c = rc[1]
g = [ls[i + 1].ints() for i in 0..r]
top = 0
bot = r - 1
left = 0
right = c - 1
res = []
while top <= bot and left <= right:
  for j in left..right + 1: res.push(g[top][j])
  top += 1
  for i in top..bot + 1: res.push(g[i][right])
  right -= 1
  if top <= bot:
    for j in (left..right + 1).rev(): res.push(g[bot][j])
    bot -= 1
  if left <= right:
    for i in (top..bot + 1).rev(): res.push(g[i][left])
    left += 1
print(" ".join(res.map(x => str(x))))
cols = [sum(g[i][j] for i in 0..r) for j in 0..c]
print(" ".join(cols.map(x => str(x))))
