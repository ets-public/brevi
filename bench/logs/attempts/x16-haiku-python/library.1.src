## main.py
import sys
import re
import datetime

from catalog import Library, Book, Member, TIERS
import rules

AMOUNT_RE = re.compile(r'([0-9]+)(?:\.([0-9]{1,2}))?\Z')


def parse_amount(s):
    m = AMOUNT_RE.match(s)
    if not m:
        return None
    return int(m.group(1)) * 100 + int((m.group(2) or '').ljust(2, '0'))


def main():
    lib = Library()
    out = []

    for raw in sys.stdin.read().split('\n'):
        line = raw.strip()
        if not line:
            continue
        parts = line.split(None, 4)
        if len(parts) < 2:
            continue
        today = datetime.date.fromisoformat(parts[0])
        cmd = parts[1]

        out.extend(rules.expire_holds(lib, today))

        if cmd == 'BOOK' and len(parts) >= 4:
            bid = parts[2]
            title = parts[4] if len(parts) == 5 else ''
            if bid in lib.books:
                out.append('duplicate ID')
            else:
                lib.books[bid] = Book(bid, title, int(parts[3]))
                out.append('added %s' % bid)

        elif cmd == 'MEMBER' and len(parts) >= 4:
            mid = parts[2]
            tier = parts[3] if parts[3] in TIERS else 'basic'
            name = parts[4] if len(parts) == 5 else ''
            if mid in lib.members:
                out.append('duplicate ID')
            else:
                lib.members[mid] = Member(mid, name, tier)
                out.append('welcome %s' % name)

        elif cmd == 'LOAN' and len(parts) == 4:
            out.append(rules.loan(lib, today, parts[2], parts[3]))

        elif cmd == 'RETURN' and len(parts) == 4:
            out.append(rules.ret(lib, today, parts[2], parts[3]))

        elif cmd == 'RESERVE' and len(parts) == 4:
            out.append(rules.reserve(lib, today, parts[2], parts[3]))

        elif cmd == 'PAY' and len(parts) == 4:
            amount = parse_amount(parts[3])
            if amount is not None:
                out.append(rules.pay(lib, parts[2], amount))

        elif cmd == 'STATUS' and len(parts) == 3:
            out.append(rules.status(lib, parts[2]))

    if out:
        sys.stdout.write('\n'.join(out) + '\n')


if __name__ == '__main__':
    main()
## catalog.py
"""Book and member records, and the library state that holds them."""

TIERS = {
    'basic': {'limit': 2, 'days': 14, 'fee': 25},   # fee in cents per day
    'plus': {'limit': 5, 'days': 28, 'fee': 10},
}
MAX_FEE = 500        # cents per loan
HOLD_DAYS = 3


class Book:
    def __init__(self, bid, title, copies):
        self.id = bid
        self.title = title
        self.shelf = copies      # copies on the shelf, free to lend
        self.waiting = []        # member IDs, first in line first


class Member:
    def __init__(self, mid, name, tier):
        self.id = mid
        self.name = name
        self.tier = tier
        self.owed = 0            # cents, may be negative (credit)
        self.loans = []          # Loan objects in the order lent


class Loan:
    def __init__(self, book_id, due):
        self.book_id = book_id
        self.due = due           # datetime.date


class Hold:
    def __init__(self, member_id, book_id, last):
        self.member_id = member_id
        self.book_id = book_id
        self.last = last         # last day the copy can be collected


class Library:
    def __init__(self):
        self.books = {}
        self.members = {}
        self.holds = []


def money(c):
    sign = '-' if c < 0 else ''
    c = abs(c)
    return '%s%d.%02d' % (sign, c // 100, c % 100)
## rules.py
"""Lending rules: loans, returns, fees, reservations and holds."""
from datetime import timedelta

from catalog import TIERS, MAX_FEE, HOLD_DAYS, Loan, Hold, money


def refused(mid, bid, reason):
    return 'refused %s %s: %s' % (mid, bid, reason)


def find_hold(lib, mid, bid):
    for h in lib.holds:
        if h.member_id == mid and h.book_id == bid:
            return h
    return None


def expire_holds(lib, today):
    """Expire every hold whose last day is before today; pass copies on."""
    out = []
    while True:
        late = [h for h in lib.holds if h.last < today]
        if not late:
            break
        h = min(late, key=lambda x: (x.last, x.book_id))
        lib.holds.remove(h)
        out.append('hold expired %s %s' % (h.member_id, h.book_id))
        book = lib.books[h.book_id]
        if book.waiting:
            nxt = book.waiting.pop(0)
            # new hold starts the day after the old one ended and lasts HOLD_DAYS
            start = h.last + timedelta(days=1)
            lib.holds.append(Hold(nxt, h.book_id, start + timedelta(days=HOLD_DAYS)))
        else:
            book.shelf += 1
    return out


def loan(lib, today, mid, bid):
    m = lib.members.get(mid)
    if m is None:
        return refused(mid, bid, 'unknown member')
    b = lib.books.get(bid)
    if b is None:
        return refused(mid, bid, 'unknown book')
    if m.owed > 200:
        return refused(mid, bid, 'owes ' + money(m.owed))
    tier = TIERS[m.tier]
    if len(m.loans) >= tier['limit']:
        return refused(mid, bid, 'limit')
    if any(l.book_id == bid for l in m.loans):
        return refused(mid, bid, 'already has it')
    hold = find_hold(lib, mid, bid)
    if hold is None and b.shelf == 0:
        return refused(mid, bid, 'none available')
    if hold is not None:
        lib.holds.remove(hold)
    else:
        b.shelf -= 1
    due = today + timedelta(days=tier['days'])
    m.loans.append(Loan(bid, due))
    return 'loan %s %s due %s' % (mid, bid, due.isoformat())


def ret(lib, today, mid, bid):
    m = lib.members.get(mid)
    found = None
    if m is not None:
        for l in m.loans:
            if l.book_id == bid:
                found = l
                break
    if found is None:
        return refused(mid, bid, 'not on loan')
    m.loans.remove(found)
    tier = TIERS[m.tier]
    fee = 0
    if today > found.due:
        days = (today - found.due).days
        fee = min(days * tier['fee'], MAX_FEE)
        m.owed += fee
    msg = 'returned %s %s' % (mid, bid)
    if fee:
        msg += ' fee %s' % money(fee)
    book = lib.books[bid]
    if book.waiting:
        nxt = book.waiting.pop(0)
        lib.holds.append(Hold(nxt, bid, today + timedelta(days=HOLD_DAYS)))
    else:
        book.shelf += 1
    return msg


def reserve(lib, today, mid, bid):
    m = lib.members.get(mid)
    if m is None:
        return refused(mid, bid, 'unknown member')
    b = lib.books.get(bid)
    if b is None:
        return refused(mid, bid, 'unknown book')
    if any(l.book_id == bid for l in m.loans):
        return refused(mid, bid, 'already has it')
    if mid in b.waiting or find_hold(lib, mid, bid) is not None:
        return refused(mid, bid, 'already reserved')
    if b.shelf > 0:
        return refused(mid, bid, 'copy available')
    b.waiting.append(mid)
    return 'reserved %s %s position %d' % (mid, bid, len(b.waiting))


def pay(lib, mid, amount):
    m = lib.members.get(mid)
    if m is None:
        return 'refused %s: unknown member' % mid
    m.owed -= amount
    return 'paid %s owes %s' % (mid, money(m.owed))


def status(lib, mid):
    m = lib.members.get(mid)
    if m is None:
        return 'refused %s: unknown member' % mid
    books = ' '.join(l.book_id for l in m.loans) or '-'
    return '%s %s owes %s loans: %s' % (mid, m.name, money(m.owed), books)
