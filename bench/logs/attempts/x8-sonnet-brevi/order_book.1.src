book = []
used = {}
vol = 0
val = 0

fn money(c: int) -> str = "{c // 100}.{(c % 100):02d}"

fn process(id: str, side: str, qty0: int, limit: int, market: bool):
  q = qty0
  opp = if side == "B": "S" else: "B"
  while q > 0:
    bi = -1
    bk = 0
    for i in 0..book.len():
      o = book[i]
      if o.1 != opp: continue
      if not market:
        if side == "B" and o.2 > limit: continue
        if side == "S" and o.2 < limit: continue
      k = if opp == "S": o.2 else: -o.2
      if bi < 0 or k < bk:
        bi = i
        bk = k
    if bi < 0: break
    o = book[bi]
    t = min(q, o.3)
    if side == "B": print("TRADE {id} {o.0} {t} {money(o.2)}")
    else: print("TRADE {o.0} {id} {t} {money(o.2)}")
    vol += t
    val += t * o.2
    if o.3 == t: book.remove(bi)
    else: book[bi] = (o.0, o.1, o.2, o.3 - t)
    q -= t
  if q > 0:
    if market: print("DROPPED {id} {q}")
    else: book.push((id, side, limit, q))

fn cents(p: str) -> int:
  a = p.split(".")
  w = a[0].int()
  f = if a.len() > 1: (a[1] + "0").slice(0, 2).int() else: 0
  w * 100 + f

fn show(side: str):
  m = {}
  for o in book:
    if o.1 == side: m[o.2] += o.3
  if m.is_empty():
    print("  -")
    return 0
  ks = m.keys()
  if side == "B": ks = ks.rev()
  for k in ks: print("  {money(k)} {m[k]}")
  0

n = 0
for line in lines():
  n += 1
  w = line.words()
  if w.is_empty(): continue
  cmd = w[0]
  ok = false
  if (cmd == "BUY" or cmd == "SELL") and w.len() == 4:
    ok = w[1].re_full("\w+").len() > 0 and w[2].re_full("\d+").len() > 0 and w[3].re_full("\d+(\.\d{1,2})?").len() > 0
    if ok: ok = w[2].int() >= 1 and cents(w[3]) > 0
  elif (cmd == "MBUY" or cmd == "MSELL") and w.len() == 3:
    ok = w[1].re_full("\w+").len() > 0 and w[2].re_full("\d+").len() > 0
    if ok: ok = w[2].int() >= 1
  elif cmd == "CANCEL" and w.len() == 2:
    ok = w[1].re_full("\w+").len() > 0
  elif cmd == "BOOK" and w.len() == 1:
    ok = true
  if not ok:
    print("ERR line {n}: bad command")
    continue
  if cmd == "BOOK":
    print("asks")
    show("S")
    print("bids")
    show("B")
  elif cmd == "CANCEL":
    idx = -1
    for i in 0..book.len():
      if book[i].0 == w[1]: idx = i
    if idx < 0:
      print("ERR line {n}: unknown ID")
    else:
      print("CANCELLED {w[1]} {book[idx].3}")
      book.remove(idx)
  else:
    if used.has(w[1]):
      print("ERR line {n}: duplicate ID")
      continue
    used[w[1]] = 1
    side = if cmd == "BUY" or cmd == "MBUY": "B" else: "S"
    if cmd == "BUY" or cmd == "SELL":
      process(w[1], side, w[2].int(), cents(w[3]), false)
    else:
      process(w[1], side, w[2].int(), 0, true)
print("volume {vol} value {money(val)}")
