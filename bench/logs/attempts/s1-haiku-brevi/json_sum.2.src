fn is_red(v: Json) -> bool:
  match v:
    Str(s) => s == "red"
    _ => false

fn total(j: Json) -> int:
  match j:
    Num(n) => n.int()
    Arr(xs) =>
      s = 0
      for x in xs: s += total(x)
      return s
    Obj(m) =>
      for v in m.values():
        if is_red(v): return 0
      s = 0
      for v in m.values(): s += total(v)
      return s
    _ => 0

print(total(json(stdin())))
