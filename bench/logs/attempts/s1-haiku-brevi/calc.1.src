toks = []
pos = 0

fn peek() -> str:
  if pos < toks.len(): return toks[pos]
  return ""

fn parse_factor() -> int:
  t = peek()
  if t == "-":
    pos += 1
    r = parse_factor()
    return -r
  if t == "(":
    pos += 1
    v = parse_expr()
    pos += 1
    return v
  pos += 1
  return t.int()

fn parse_term() -> int:
  v = parse_factor()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = parse_factor()
    if op == "*":
      v = v * r
    else:
      if r == 0: fail("division by zero")
      v = v / r
  return v

fn parse_expr() -> int:
  v = parse_term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = parse_term()
    if op == "+":
      v = v + r
    else:
      v = v - r
  return v

fn eval_line() -> int:
  return parse_expr()

for line in lines():
  if line.trim().is_empty(): continue
  toks = line.re_list("\d+|[-+*/()]")
  pos = 0
  match eval_line():
    Ok(v) => print(v)
    Err(m) => print("error")
