g = {}
bad = {}
for line in lines():
  w = line.words()
  if w.len() < 4: continue
  path = w[1]
  if not g.has(path):
    g[path] = []
    bad[path] = 0
  g[path].push(w[3].int())
  if w[2].int() >= 500:
    bad[path] += 1

for path in sorted(g.keys()):
  xs = sorted(g[path])
  n = xs.len()
  total = sum(xs)
  avg = total.float() / n.float()
  k = (9 * n + 9) // 10
  p90 = xs[k - 1]
  errp = bad[path].float() * 100.0 / n.float()
  print("{path} {n} {avg.fmt(1)} {p90} {errp.fmt(1)}%")
