ps = []
for line in lines():
  w = line.ints()
  if w.len() == 2:
    ps.push((w[0], w[1]))
ps = ps.sort()
out = []
total = 0
if ps:
  cs = ps[0].0
  ce = ps[0].1
  for p in ps:
    if p.0 <= ce:
      ce = max(ce, p.1)
    else:
      out.push((cs, ce))
      cs = p.0
      ce = p.1
  out.push((cs, ce))
for p in out:
  print("{p.0} {p.1}")
  total += p.1 - p.0
print("total {total}")
