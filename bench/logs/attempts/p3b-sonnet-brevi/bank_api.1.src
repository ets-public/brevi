owners = []
bal = []
fn acct(i: int) = str({"id": i + 1, "owner": owners[i], "balance": bal[i]})
fn amt(j: Json) -> int:
  match j["amount"]:
    Num(n) => if n > 0.0 and n == n.floor(): n.int() else: -1
    _ => -1
fn idof(j: Json) -> int:
  match j:
    Num(n) => if n >= 1.0 and n == n.floor() and n <= owners.len().float(): n.int() else: 0
    _ => 0
fn segid(s: str) -> int:
  if s.is_empty() or not s.is_digit(): return 0
  n = s.int()
  if n >= 1 and n <= owners.len(): n else: 0
fn handle(method: str, path: str, body: str) -> str:
  seg = path.split("/")
  route = ""
  aid = 0
  if method == "POST" and path == "/accounts": route = "create"
  elif method == "GET" and path == "/accounts": route = "list"
  elif method == "POST" and path == "/transfer": route = "transfer"
  elif seg.len() == 3 and seg[0] == "" and seg[1] == "accounts" and method == "GET" and seg[2].is_digit() and not seg[2].is_empty(): route = "get"
  elif seg.len() == 4 and seg[0] == "" and seg[1] == "accounts" and method == "POST" and seg[2].is_digit() and not seg[2].is_empty() and (seg[3] == "deposit" or seg[3] == "withdraw"): route = seg[3]
  if route == "": return "404 {\"error\":\"not found\"}"
  j = Null
  if method == "POST" and not body.is_empty():
    ok = true
    match json(body):
      Ok(v) => j = v
      Err(m) => ok = false
    if not ok: return "400 {\"error\":\"bad json\"}"
  if route == "create":
    match j["owner"]:
      Str(s) =>
        if s.is_empty(): return "400 {\"error\":\"owner required\"}"
        owners.push(s)
        bal.push(0)
        return "201 " + acct(owners.len() - 1)
      _ => return "400 {\"error\":\"owner required\"}"
  if route == "list":
    idx = (0..owners.len()).map(i => i).sort_by(i => (-bal[i], i))
    return "200 [" + ", ".join([acct(i) for i in idx]).replace(", ", ",") + "]"
  if route == "transfer":
    a = idof(j["from"])
    b = idof(j["to"])
    if a == 0 or b == 0: return "404 {\"error\":\"no such account\"}"
    if a == b: return "400 {\"error\":\"same account\"}"
    n = amt(j)
    if n < 0: return "400 {\"error\":\"bad amount\"}"
    if n > bal[a - 1]: return "409 {\"error\":\"insufficient funds\"}"
    bal[a - 1] -= n
    bal[b - 1] += n
    return "200 " + str({"from": bal[a - 1], "to": bal[b - 1]})
  id = segid(seg[2])
  if id == 0: return "404 {\"error\":\"no such account\"}"
  if route == "get": return "200 " + acct(id - 1)
  n = amt(j)
  if n < 0: return "400 {\"error\":\"bad amount\"}"
  if route == "withdraw":
    if n > bal[id - 1]: return "409 {\"error\":\"insufficient funds\"}"
    bal[id - 1] -= n
  else:
    bal[id - 1] += n
  "200 " + acct(id - 1)
for line in lines():
  if line.trim().is_empty(): continue
  p = line.trim()
  sp = p.find(" ")
  if sp < 0:
    print(handle(p, "", ""))
    continue
  method = p[:sp]
  rest = p[sp + 1:]
  sp2 = rest.find(" ")
  if sp2 < 0: print(handle(method, rest, ""))
  else: print(handle(method, rest[:sp2], rest[sp2 + 1:]))
