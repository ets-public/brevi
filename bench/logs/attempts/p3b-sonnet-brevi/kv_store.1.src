store = {}
log = []
marks = []
fn rec(k: str):
  if marks:
    log.push((k, store.has(k), store[k]))
fn put(k: str, v: str):
  rec(k)
  store[k] = v
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  c = w[0]
  n = w.len()
  if c == "SET" and n == 3: put(w[1], w[2])
  elif c == "GET" and n == 2:
    if store.has(w[1]): print(store[w[1]])
    else: print("NULL")
  elif c == "DEL" and n == 2:
    if store.has(w[1]):
      rec(w[1])
      store.remove(w[1])
    else: print("NOT FOUND")
  elif c == "INCR" and n == 3:
    cur = if store.has(w[1]): store[w[1]] else: "0"
    if cur.re_full("-?\d+").is_empty(): print("ERR not an integer")
    else:
      nv = cur.int() + w[2].int()
      put(w[1], nv.str())
      print(nv)
  elif c == "COUNT" and n == 2:
    print(store.values().count(x => x == w[1]))
  elif c == "KEYS" and n == 2:
    ks = [k for k in store.keys() if k.starts_with(w[1])]
    if ks: print(" ".join(ks.sort()))
    else: print("(empty)")
  elif c == "BEGIN" and n == 1: marks.push(log.len())
  elif c == "ROLLBACK" and n == 1:
    if not marks: print("NO TRANSACTION")
    else:
      m = marks.pop()
      while log.len() > m:
        e = log.pop()
        if e.1: store[e.0] = e.2
        else: store.remove(e.0)
  elif c == "COMMIT" and n == 1:
    if not marks: print("NO TRANSACTION")
    else:
      marks = []
      log = []
  else: print("ERR unknown command")
