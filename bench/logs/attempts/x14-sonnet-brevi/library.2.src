## main.bv
use "catalog.bv"
use "rules.bv"

lib = new_lib()

for line in lines():
  w = line.words()
  if w.is_empty(): continue
  day = date(w[0]).days
  expire(lib, day)
  op = w[1]
  if op == "BOOK":
    add_book(lib, w[2], w[3].int(), " ".join(w.slice(4)))
  elif op == "MEMBER":
    add_member(lib, w[2], w[3], " ".join(w.slice(4)))
  elif op == "LOAN":
    do_loan(lib, day, w[2], w[3])
  elif op == "RETURN":
    do_return(lib, day, w[2], w[3])
  elif op == "RESERVE":
    do_reserve(lib, w[2], w[3])
  elif op == "PAY":
    do_pay(lib, w[2], w[3])
  elif op == "STATUS":
    do_status(lib, w[2])
## catalog.bv
type Loan:
  book: str
  due: int

type Book:
  id: str
  title: str
  shelf: int
  waiting: [str]

type Member:
  id: str
  name: str
  tier: str
  owes: dec
  loans: [Loan]

type Hold:
  member: str
  book: str
  last: int

type Lib:
  books: {str: Book}
  members: {str: Member}
  holds: [Hold]

fn new_lib() -> Lib = Lib({}, {}, [])

fn dstr(days: int) -> str = str(date("1970-01-01").add_days(days))

fn has_loan(m: Member, book: str) -> bool = [l for l in m.loans if l.book == book].len() > 0

fn add_book(mut lib: Lib, id: str, copies: int, title: str):
  if lib.books.has(id):
    print("duplicate ID")
  else:
    lib.books[id] = Book(id, title, copies, [])
    print("added {id}")

fn add_member(mut lib: Lib, id: str, tier: str, name: str):
  if lib.members.has(id):
    print("duplicate ID")
  else:
    lib.members[id] = Member(id, name, tier, 0.dec(), [])
    print("welcome {name}")
## rules.bv
use "catalog.bv"

fn tier_max(t: str) -> int = if t == "basic": 2 else: 5

fn tier_days(t: str) -> int = if t == "basic": 14 else: 28

fn tier_rate(t: str) -> dec = if t == "basic": "0.25".dec() else: "0.10".dec()

fn refuse(m: str, b: str, reason: str):
  print("refused {m} {b}: {reason}")

fn expire(mut lib: Lib, today: int):
  while true:
    bi = -1
    for i in 0..lib.holds.len():
      h = lib.holds[i]
      if h.last < today:
        if bi < 0:
          bi = i
        else:
          b = lib.holds[bi]
          if h.last < b.last or (h.last == b.last and h.book < b.book): bi = i
    if bi < 0: break
    h = lib.holds[bi]
    lib.holds.remove(bi)
    print("hold expired {h.member} {h.book}")
    wl = lib.books[h.book].waiting
    if wl.is_empty():
      lib.books[h.book].shelf += 1
    else:
      nm = wl.remove(0)
      lib.books[h.book].waiting = wl
      lib.holds.push(Hold(nm, h.book, h.last + 3))

fn do_loan(mut lib: Lib, day: int, mem: str, book: str):
  reason = ""
  hold_idx = -1
  if not lib.members.has(mem):
    reason = "unknown member"
  elif not lib.books.has(book):
    reason = "unknown book"
  else:
    m = lib.members[mem]
    for i in 0..lib.holds.len():
      if lib.holds[i].member == mem and lib.holds[i].book == book: hold_idx = i
    if m.owes > "2.00".dec():
      reason = "owes {m.owes.fmt(2)}"
    elif m.loans.len() >= tier_max(m.tier):
      reason = "limit"
    elif has_loan(m, book):
      reason = "already has it"
    elif hold_idx < 0 and lib.books[book].shelf < 1:
      reason = "none available"
  if reason != "":
    refuse(mem, book, reason)
  else:
    tier = lib.members[mem].tier
    if hold_idx >= 0:
      lib.holds.remove(hold_idx)
    else:
      lib.books[book].shelf -= 1
    due = day + tier_days(tier)
    lib.members[mem].loans.push(Loan(book, due))
    print("loan {mem} {book} due {dstr(due)}")

fn do_return(mut lib: Lib, day: int, mem: str, book: str):
  li = -1
  if lib.members.has(mem):
    ls = lib.members[mem].loans
    for i in 0..ls.len():
      if ls[i].book == book: li = i
  if li < 0:
    refuse(mem, book, "not on loan")
  else:
    m = lib.members[mem]
    due = m.loans[li].due
    fee = 0.dec()
    if day > due:
      fee = tier_rate(m.tier) * (day - due)
      if fee > "5.00".dec(): fee = "5.00".dec()
    lib.members[mem].loans.remove(li)
    lib.members[mem].owes += fee
    if fee > 0:
      print("returned {mem} {book} fee {fee.fmt(2)}")
    else:
      print("returned {mem} {book}")
    wl = lib.books[book].waiting
    if wl.is_empty():
      lib.books[book].shelf += 1
    else:
      nm = wl.remove(0)
      lib.books[book].waiting = wl
      lib.holds.push(Hold(nm, book, day + 3))

fn do_reserve(mut lib: Lib, mem: str, book: str):
  reason = ""
  if not lib.members.has(mem):
    reason = "unknown member"
  elif not lib.books.has(book):
    reason = "unknown book"
  elif has_loan(lib.members[mem], book):
    reason = "already has it"
  elif mem in lib.books[book].waiting:
    reason = "already reserved"
  elif lib.books[book].shelf > 0:
    reason = "copy available"
  if reason != "":
    refuse(mem, book, reason)
  else:
    lib.books[book].waiting.push(mem)
    print("reserved {mem} {book} position {lib.books[book].waiting.len()}")

fn do_pay(mut lib: Lib, mem: str, amount: str):
  if not lib.members.has(mem):
    print("refused {mem}: unknown member")
  else:
    lib.members[mem].owes -= amount.dec()
    print("paid {mem} owes {lib.members[mem].owes.fmt(2)}")

fn do_status(lib: Lib, mem: str):
  if not lib.members.has(mem):
    print("refused {mem}: unknown member")
  else:
    m = lib.members[mem]
    bs = if m.loans.is_empty(): "-" else: " ".join([l.book for l in m.loans])
    print("{mem} {m.name} owes {m.owes.fmt(2)} loans: {bs}")
