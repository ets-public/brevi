## main.bv
use "stock.bv"
use "orders.bv"

fn words(s: str) -> [str]:
  return s.split(" ").filter(x => x != "")

fn valid_date(s: str) -> bool:
  if not s.re_full("\d{4}-\d{2}-\d{2}"):
    return False
  yy = s[0:4].int()
  mo = s[5:7].int()
  dy = s[8:10].int()
  if mo < 1 or mo > 12:
    return False
  days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  top = days[mo - 1]
  if mo == 2 and ((yy % 4 == 0 and yy % 100 != 0) or yy % 400 == 0):
    top = 29
  return dy >= 1 and dy <= top

fn posint(s: str) -> bool:
  if not s.re_full("\d+"):
    return False
  return s.int() > 0

lots = []
backs = []
seen = {}
today = ""
seq = 0
shipped = 0
for i, ln in lines().enumerate():
  n = i + 1
  w = words(ln)
  if w.is_empty():
    continue
  cmd = w[0]
  if cmd == "DAY":
    if w.len() != 2 or not valid_date(w[1]):
      print("line {n}: bad line")
    elif today != "" and w[1] < today:
      print("line {n}: date goes back")
    else:
      today = w[1]
      for msg in discard_before(lots, today):
        print(msg)
  elif cmd == "RECV":
    if w.len() != 4 or not posint(w[2]) or not valid_date(w[3]):
      print("line {n}: bad line")
    elif today == "":
      print("line {n}: no date")
    elif w[3] < today:
      print("line {n}: expired on arrival")
    else:
      sku = w[1]
      q = w[2].int()
      seq += 1
      add_lot(lots, sku, q, w[3], seq)
      for bi in waiting_for(backs, sku):
        got = take(lots, sku, backs[bi].left)
        if got > 0:
          shipped += got
          backs[bi].left -= got
          bid = backs[bi].oid
          if backs[bi].left > 0:
            bleft = backs[bi].left
            print("BACKORDER {bid}: shipped {got}, {bleft} left")
          else:
            print("BACKORDER {bid}: done")
  elif cmd == "ORDER":
    if w.len() != 4 or not posint(w[3]):
      print("line {n}: bad line")
    elif today == "":
      print("line {n}: no date")
    elif not new_order(seen, w[1]):
      print("line {n}: duplicate order")
    else:
      oid = w[1]
      osku = w[2]
      oq = w[3].int()
      got = take(lots, osku, oq)
      shipped += got
      if got < oq:
        print("ORDER {oid}: shipped {got} of {oq}")
        add_back(backs, oid, osku, oq - got)
      else:
        print("ORDER {oid}: shipped {oq}")
  elif cmd == "STOCK":
    if w.len() != 1:
      print("line {n}: bad line")
    else:
      ls = stock_lines(lots)
      if ls.is_empty():
        print("stock empty")
      for s in ls:
        print(s)
  else:
    print("line {n}: bad line")

waiting = units_waiting(backs)
print("shipped {shipped} units, backordered {waiting} units")
## stock.bv
# Lots of stock and picking units in expiry order (earliest expiry first,
# then the lot received first). Lots with qty 0 are kept but have no units.

type Lot:
  sku: str
  qty: int
  exp: str
  seq: int

fn add_lot(mut lots: [Lot], sku: str, qty: int, exp: str, seq: int):
  lots.push(Lot(sku: sku, qty: qty, exp: exp, seq: seq))

# Indices of all lots in pick order.
fn pick_order(lots: [Lot]) -> [int]:
  keyed = []
  for ix in 0..lots.len():
    keyed.push((lots[ix].exp, lots[ix].seq, ix))
  return keyed.sort().map(t => t.2)

# Takes up to want units of sku; returns how many were taken.
fn take(mut lots: [Lot], sku: str, want: int) -> int:
  gotn = 0
  for ix in pick_order(lots):
    if gotn >= want:
      break
    if lots[ix].sku == sku and lots[ix].qty > 0:
      take_n = min(want - gotn, lots[ix].qty)
      lots[ix].qty -= take_n
      gotn += take_n
  return gotn

# Empties every lot expiring before day; returns the discard lines in
# SKU, expiry, received order.
fn discard_before(mut lots: [Lot], day: str) -> [str]:
  keyed = []
  for ix in 0..lots.len():
    if lots[ix].qty > 0 and lots[ix].exp < day:
      keyed.push((lots[ix].sku, lots[ix].exp, lots[ix].seq, ix))
  out = []
  for t in keyed.sort():
    ix = t.3
    dq = lots[ix].qty
    dsku = lots[ix].sku
    dexp = lots[ix].exp
    out.push("discard {dsku} {dq} {dexp}")
    lots[ix].qty = 0
  return out

# STOCK lines: one per SKU with units, sorted by SKU.
fn stock_lines(lots: [Lot]) -> [str]:
  totq = {}
  nlot = {}
  for lt in lots:
    if lt.qty > 0:
      totq[lt.sku] = totq.get_or(lt.sku, 0) + lt.qty
      nlot[lt.sku] = nlot.get_or(lt.sku, 0) + 1
  out = []
  for sk in totq.keys().sort():
    qv = totq[sk]
    lv = nlot[sk]
    out.push("{sk} {qv} in {lv} lots")
  return out
## orders.bv
# Order IDs and backorders (units still waiting, in the order created).

type Back:
  oid: str
  sku: str
  left: int

# False when the ID was used before; otherwise records it.
fn new_order(mut seen: {str: bool}, oid: str) -> bool:
  if seen.has(oid):
    return False
  seen[oid] = True
  return True

fn add_back(mut backs: [Back], oid: str, sku: str, left: int):
  backs.push(Back(oid: oid, sku: sku, left: left))

# Indices of backorders for sku that still wait, in creation order.
fn waiting_for(backs: [Back], sku: str) -> [int]:
  out = []
  for ix in 0..backs.len():
    if backs[ix].sku == sku and backs[ix].left > 0:
      out.push(ix)
  return out

fn units_waiting(backs: [Back]) -> int:
  tot = 0
  for b in backs:
    tot += b.left
  return tot
