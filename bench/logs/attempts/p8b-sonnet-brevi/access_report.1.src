reqs = 0
bad = 0
total = 0
ips = {}
classes = {}
paths = {}
hrs = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full("(\S+) - - \[([^\]]*)\] \"(\S+) (\S+) (\S+)\" (\d{3}) (\d+|-) \"([^\"]*)\" \"([^\"]*)\"")
  if not m:
    bad += 1
    continue
  reqs += 1
  ip = m[1]
  ts = m[2]
  path = m[4].split("?")[0]
  st = m[6].int()
  size = if m[7] == "-": 0 else: m[7].int()
  total += size
  ips[ip] = 1
  classes[st // 100] += 1
  paths[path] += 1
  hrs[ts.split(":")[1]] += 1
  if "bot" in m[9].lower(): bots += 1
  if st >= 400: errs[ip] += 1
print("requests {reqs}")
print("malformed {bad}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for k, v in classes.pairs():
  print("  {k}xx {v}")
print("top_paths")
for p in paths.pairs().sort_by(p => (-p.1, p.0)).take(3):
  print("  {p.1} {p.0}")
print("hours")
mx = hrs.values().max().or(1)
for h, n in hrs.pairs():
  w = max(1, (40 * n + mx) // (2 * mx))
  print("  {h} {n} {"#".repeat(w)}")
print("bots {bots}")
print("errors_by_ip")
for p in errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0)):
  print("  {p.0} {p.1}")
