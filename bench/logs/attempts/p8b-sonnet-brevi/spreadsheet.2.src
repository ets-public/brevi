cont = {}
state = {}
rs = {}
rv = {}
toks = []
pos = 0
dims = [0, 0]
fn comb(a: int, b: int) -> int = if a == 2 or b == 2: 2 else: (if a == 1 or b == 1: 1 else: 0)
fn is_ref(t: str) -> bool = t.re_full("[A-Z]\d+").len() > 0
fn colof(r: str) -> int = r.code() - 65
fn rowof(r: str) -> int = r.slice(1).int().or(0)
fn toksof(c: str) -> [str]:
  if cont[c].starts_with("="):
    return [m[0] for m in cont[c].slice(1).replace(" ", "").re_all("\d+|[A-Z]+\d+|[A-Z]+|[-+*/():]")]
  []
fn cells_in(a: str, b: str) -> [str]:
  c1 = min(colof(a), colof(b))
  c2 = max(colof(a), colof(b))
  r1 = min(rowof(a), rowof(b))
  r2 = max(rowof(a), rowof(b))
  res = []
  for cc in c1..(c2 + 1):
    for rr in r1..(r2 + 1):
      res.push((65 + cc).char() + rr.str())
  res
fn deps(c: str) -> [str]:
  tk = toksof(c)
  res = []
  i = 0
  while i < tk.len():
    if is_ref(tk[i]):
      if i + 2 < tk.len() and tk[i + 1] == ":" and is_ref(tk[i + 2]):
        res = res + cells_in(tk[i], tk[i + 2])
        i += 3
      else:
        res.push(tk[i])
        i += 1
    else:
      i += 1
  res
fn prim() -> (int, int):
  t = toks[pos]
  if t == "(":
    pos += 1
    r = expr()
    pos += 1
    return r
  if t == "-":
    pos += 1
    r = prim()
    return (r.0, -r.1)
  if t.re_full("\d+").len() > 0:
    pos += 1
    return (0, t.int().or(0))
  if t == "SUM" or t == "MIN" or t == "MAX":
    a = toks[pos + 2]
    b = toks[pos + 4]
    pos += 6
    vs = [rv[x] for x in cells_in(a, b)]
    if t == "SUM": return (0, vs.sum())
    if t == "MIN": return (0, vs.min().or(0))
    return (0, vs.max().or(0))
  pos += 1
  (0, rv[t])
fn term() -> (int, int):
  l = prim()
  while pos < toks.len() and (toks[pos] == "*" or toks[pos] == "/"):
    op = toks[pos]
    pos += 1
    r = prim()
    st = comb(l.0, r.0)
    if st != 0:
      l = (st, 0)
    elif op == "*":
      l = (0, l.1 * r.1)
    elif r.1 == 0:
      l = (1, 0)
    else:
      l = (0, l.1 / r.1)
  l
fn expr() -> (int, int):
  l = term()
  while pos < toks.len() and (toks[pos] == "+" or toks[pos] == "-"):
    op = toks[pos]
    pos += 1
    r = term()
    st = comb(l.0, r.0)
    if st != 0:
      l = (st, 0)
    elif op == "+":
      l = (0, l.1 + r.1)
    else:
      l = (0, l.1 - r.1)
  l
fn compute(c: str):
  state[c] = 1
  bad = 0
  for d in deps(c):
    if state[d] == 1:
      bad = 2
    else:
      if state[d] == 0: compute(d)
      bad = comb(bad, rs[d])
  if bad != 0:
    rs[c] = bad
    rv[c] = 0
  elif not cont.has(c):
    rs[c] = 0
    rv[c] = 0
  elif cont[c].starts_with("="):
    toks = toksof(c)
    pos = 0
    res = expr()
    rs[c] = res.0
    rv[c] = res.1
  else:
    rs[c] = 0
    rv[c] = cont[c].int().or(0)
  state[c] = 2
fn note(r: str):
  dims[0] = max(dims[0], colof(r) + 1)
  dims[1] = max(dims[1], rowof(r))
for line in lines():
  i = line.find("=")
  if i < 0: continue
  c = line.slice(0, i).trim()
  cont[c] = line.slice(i + 1).trim()
  note(c)
  for r in toksof(c):
    if is_ref(r): note(r)
for c in cont.keys():
  if state[c] == 0: compute(c)
hdr = ""
for cc in 0..dims[0]:
  hdr += "\t" + (65 + cc).char()
print(hdr)
for rr in 1..(dims[1] + 1):
  row = rr.str()
  for cc in 0..dims[0]:
    k = (65 + cc).char() + rr.str()
    if not cont.has(k):
      row += "\t"
    elif rs[k] == 2:
      row += "\t#CYCLE"
    elif rs[k] == 1:
      row += "\t#DIV0"
    else:
      row += "\t" + rv[k].str()
  print(row)
