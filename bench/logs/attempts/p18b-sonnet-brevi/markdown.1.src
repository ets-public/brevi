fn esc(s: str) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

fn fmt_plain(s: str) -> str:
  t = s.re_sub('\*\*(.+?)\*\*', '<strong>\1</strong>')
  t = t.re_sub('\*(.+?)\*', '<em>\1</em>')
  t.re_sub('\[([^\]]*)\]\(([^)]*)\)', '<a href="\1">\1</a>')

fn inline(s: str) -> str:
  e = esc(s)
  res = ""
  for tok in e.re_list('`[^`]*`|[^`]+|`'):
    if tok.len() >= 2 and tok.starts_with("`") and tok.ends_with("`"):
      res += "<code>" + tok.slice(1, -1) + "</code>"
    else:
      res += fmt_plain(tok)
  res

out = []
heads = []
used = {}
para = []
items = []
kind = ""
incode = false
code = []

fn flush():
  if para:
    out.push("<p>" + " ".join(para) + "</p>")
    para = []
  if items:
    out.push("<" + kind + ">")
    for it in items: out.push("<li>" + it + "</li>")
    out.push("</" + kind + ">")
    items = []
    kind = ""

for line in lines():
  if incode:
    if line == "```":
      out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
      code = []
      incode = false
    else:
      code.push(esc(line))
    continue
  if line == "```":
    flush()
    incode = true
    continue
  if line.trim() == "":
    flush()
    continue
  h = line.re_full('(#{1,6}) (.*)')
  ul = line.starts_with("- ")
  ol = line.re_full('\d+\. (.*)')
  if h:
    flush()
    lvl = h[1].len()
    raw = h[2].trim()
    base = raw.lower().re_sub('[^a-z0-9]+', '-').re_sub('^-+|-+$', '')
    used[base] += 1
    id = if used[base] > 1: base + "-" + str(used[base]) else: base
    out.push('<h{lvl} id="{id}">' + inline(raw) + '</h{lvl}>')
    heads.push((id, esc(raw.replace("`", "").replace("*", ""))))
  elif ul or ol:
    k = if ul: "ul" else: "ol"
    if kind != k:
      flush()
      kind = k
    items.push(inline(if ul: line.slice(2) else: ol[1]))
  else:
    if items: flush()
    para.push(inline(line.trim()))
flush()
if incode:
  out.push("<pre><code>" + "\n".join(code) + "</code></pre>")
if heads.len() >= 2:
  print("<nav>")
  for hd in heads:
    print('<a href="#{hd.0}">{hd.1}</a>')
  print("</nav>")
for o in out: print(o)
