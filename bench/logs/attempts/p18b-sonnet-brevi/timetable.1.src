names = []
stns = []
tms = []

fn mins(s: str) -> int:
  p = s.split(":")
  p[0].int() * 60 + p[1].int()

fn hhmm(m: int) -> str:
  h = m // 60
  mm = m % 60
  ("0" + str(h)).slice(-2) + ":" + ("0" + str(mm)).slice(-2)

fn solve(src: str, dst: str, q: int) -> str:
  if src == dst: return "{src} {dst} {hhmm(q)} via -"
  lab_s = [src]
  lab_a = [q]
  lab_p = [[]]
  recs = {}
  recs[src].push((q, 0))
  best = (100000, 0, "")
  found = false
  idx = 0
  while idx < lab_s.len():
    s = lab_s[idx]
    a = lab_a[idx]
    path = lab_p[idx]
    idx += 1
    if s == dst: continue
    gap = if path.is_empty(): 0 else: 5
    for t in 0..names.len():
      if names[t] in path: continue
      for i in 0..stns[t].len():
        if stns[t][i] == s and tms[t][i] >= a + gap:
          for j in i + 1..stns[t].len():
            na = tms[t][j]
            ns = stns[t][j]
            np = path + [names[t]]
            if ns == dst:
              cand = (na, np.len(), ">".join(np))
              if not found or cand < best:
                best = cand
                found = true
            else:
              dominated = false
              for r in recs[ns]:
                if r.0 <= na and r.1 < np.len(): dominated = true
                if r.0 == na and r.1 == np.len() and lab_p.contains(np): dominated = dominated
              if not dominated and (not found or na <= best.0):
                lab_s.push(ns)
                lab_a.push(na)
                lab_p.push(np)
                recs[ns].push((na, np.len()))
  if not found: return "{src} {dst} unreachable"
  "{src} {dst} {hhmm(best.0)} via {best.2}"

sec = 0
for line in lines():
  if line.trim() == "---":
    sec = 1
    continue
  w = line.words()
  if w.is_empty(): continue
  if sec == 0:
    names.push(w[0])
    ss = []
    ts = []
    k = 1
    while k + 1 < w.len():
      ss.push(w[k])
      ts.push(mins(w[k + 1]))
      k += 2
    stns.push(ss)
    tms.push(ts)
  else:
    print(solve(w[0], w[1], mins(w[2])))
