defs = {}
memo = {}
memo_err = {}
busy = {}
cur_err = 0
toks = []
pos = 0

fn peek() -> str = if pos < toks.len(): toks[pos] else: ""

fn cell_val(name: str) -> int:
  if memo.has(name):
    cur_err = max(cur_err, memo_err[name])
    return memo[name]
  if busy.has(name):
    cur_err = 2
    return 0
  if not defs.has(name): return 0
  content = defs[name]
  if not content.starts_with("="):
    return content.int().or(0)
  busy[name] = 1
  saved_toks = toks
  saved_pos = pos
  saved_err = cur_err
  cur_err = 0
  toks = content.slice(1).replace(" ", "").re_list('[A-Z]\d+|[A-Z]+|\d+|[-+*/():]')
  pos = 0
  v = expr()
  e = cur_err
  toks = saved_toks
  pos = saved_pos
  cur_err = max(saved_err, e)
  busy.remove(name)
  memo[name] = v
  memo_err[name] = e
  v

fn expr() -> int:
  v = term()
  while peek() == "+" or peek() == "-":
    op = peek()
    pos += 1
    r = term()
    if op == "+": v += r
    else: v -= r
  v

fn term() -> int:
  v = unary()
  while peek() == "*" or peek() == "/":
    op = peek()
    pos += 1
    r = unary()
    if op == "*":
      v *= r
    elif r == 0:
      cur_err = max(cur_err, 1)
      v = 0
    else:
      v = v / r
  v

fn unary() -> int:
  if peek() == "-":
    pos += 1
    return 0 - unary()
  primary()

fn primary() -> int:
  t = peek()
  pos += 1
  if t == "(":
    v = expr()
    pos += 1
    return v
  if t.is_digit(): return t.int()
  if t.re_full('[A-Z]\d+'): return cell_val(t)
  pos += 1
  a = peek()
  pos += 2
  b = toks[pos - 1]
  pos += 1
  c1 = min(a.code(), b.code())
  c2 = max(a.code(), b.code())
  r1 = min(a.slice(1).int(), b.slice(1).int())
  r2 = max(a.slice(1).int(), b.slice(1).int())
  vals = []
  for c in c1..c2 + 1:
    for r in r1..r2 + 1:
      vals.push(cell_val(c.char() + str(r)))
  if t == "SUM": return vals.sum()
  if t == "MIN": return vals.min()
  vals.max()

maxc = 0
maxr = 0
fn note(ref: str):
  maxc = max(maxc, ref.code() - 64)
  maxr = max(maxr, ref.slice(1).int())

for line in lines():
  if line.trim() == "": continue
  i = line.find("=")
  name = line.slice(0, i).trim()
  content = line.slice(i + 1).trim()
  defs[name] = content
  note(name)
  if content.starts_with("="):
    for m in content.re_all('([A-Z])(\d+)'):
      note(m[0])

print("\t" + "\t".join([(65 + i).char() for i in 0..maxc]))
for r in 1..maxr + 1:
  row = [str(r)]
  for c in 0..maxc:
    name = (65 + c).char() + str(r)
    if not defs.has(name):
      row.push("")
    else:
      cur_err = 0
      v = cell_val(name)
      e = max(cur_err, memo_err[name])
      row.push(if e == 2: "#CYCLE" elif e == 1: "#DIV0" else: str(v))
  print("\t".join(row))
