## main.bv
use "catalog.bv"
use "rules.bv"

fn main():
  lib = new_lib()
  for line in lines():
    w = line.words()
    if w.len() < 2: continue
    today = date(w[0]).days
    for s in expire(lib, today): print(s)
    cmd = w[1]
    if cmd == "BOOK":
      if lib.books.has(w[2]):
        print("duplicate ID")
      else:
        add_book(lib, w[2], w[3].int(), " ".join(w.skip(4)))
        print("added {w[2]}")
    elif cmd == "MEMBER":
      if lib.members.has(w[2]):
        print("duplicate ID")
      else:
        add_member(lib, w[2], w[3], " ".join(w.skip(4)))
        print("welcome {" ".join(w.skip(4))}")
    elif cmd == "LOAN":
      print(loan(lib, today, w[2], w[3]))
    elif cmd == "RETURN":
      print(give_back(lib, today, w[2], w[3]))
    elif cmd == "RESERVE":
      print(reserve(lib, w[2], w[3]))
    elif cmd == "PAY":
      print(pay(lib, w[2], w[3].dec()))
    elif cmd == "STATUS":
      print(status(lib, w[2]))
## catalog.bv
type Book:
  id: str
  title: str
  shelf: int
  waiting: [str]
  held: [(str, int)]

type Member:
  id: str
  name: str
  tier: str
  owes: dec
  loans: [str]
  dues: [int]

type Lib:
  books: {str: Book}
  members: {str: Member}

fn new_lib() -> Lib = Lib(books: {}, members: {})

fn add_book(mut lib: Lib, id: str, copies: int, title: str):
  lib.books[id] = Book(id: id, title: title, shelf: copies, waiting: [], held: [])

fn add_member(mut lib: Lib, id: str, tier: str, name: str):
  lib.members[id] = Member(id: id, name: name, tier: tier, owes: 0.dec(), loans: [], dues: [])

fn day_str(n: int) -> str = date("1970-01-01").add_days(n).str()
## rules.bv
use "catalog.bv"

fn max_books(tier: str) -> int = if tier == "plus": 5 else: 2

fn loan_days(tier: str) -> int = if tier == "plus": 28 else: 14

fn daily_fee(tier: str) -> dec = if tier == "plus": "0.10".dec() else: "0.25".dec()

fn expire(mut lib: Lib, today: int) -> [str]:
  out = []
  while true:
    bl = -1
    bb = ""
    for id in lib.books.keys():
      b = lib.books[id]
      for h in b.held:
        if h.1 < today and (bl < 0 or h.1 < bl):
          bl = h.1
          bb = id
    if bl < 0: break
    b = lib.books[bb]
    idx = -1
    for i in 0..b.held.len():
      if b.held[i].1 == bl and idx < 0: idx = i
    h = b.held[idx]
    b.held.remove(idx)
    out.push("hold expired {h.0} {bb}")
    if b.waiting.is_empty():
      b.shelf += 1
    else:
      nm = b.waiting[0]
      b.waiting.remove(0)
      b.held.push((nm, bl + 4))
    lib.books[bb] = b
  out

fn loan(mut lib: Lib, today: int, mid: str, bid: str) -> str:
  if not lib.members.has(mid): return "refused {mid} {bid}: unknown member"
  if not lib.books.has(bid): return "refused {mid} {bid}: unknown book"
  m = lib.members[mid]
  b = lib.books[bid]
  if m.owes > "2.00".dec(): return "refused {mid} {bid}: owes {m.owes.fmt(2)}"
  if m.loans.len() >= max_books(m.tier): return "refused {mid} {bid}: limit"
  if bid in m.loans: return "refused {mid} {bid}: already has it"
  hi = -1
  for i in 0..b.held.len():
    if b.held[i].0 == mid: hi = i
  if hi >= 0:
    b.held.remove(hi)
  elif b.shelf > 0:
    b.shelf -= 1
  else:
    return "refused {mid} {bid}: none available"
  due = today + loan_days(m.tier)
  m.loans.push(bid)
  m.dues.push(due)
  lib.members[mid] = m
  lib.books[bid] = b
  "loan {mid} {bid} due {day_str(due)}"

fn give_back(mut lib: Lib, today: int, mid: str, bid: str) -> str:
  if not lib.members.has(mid): return "refused {mid} {bid}: not on loan"
  m = lib.members[mid]
  idx = m.loans.index_of(bid)
  if idx < 0: return "refused {mid} {bid}: not on loan"
  due = m.dues[idx]
  m.loans.remove(idx)
  m.dues.remove(idx)
  fee = 0.dec()
  if today > due:
    fee = daily_fee(m.tier) * (today - due)
    if fee > "5.00".dec(): fee = "5.00".dec()
  m.owes += fee
  lib.members[mid] = m
  b = lib.books[bid]
  if b.waiting.is_empty():
    b.shelf += 1
  else:
    nm = b.waiting[0]
    b.waiting.remove(0)
    b.held.push((nm, today + 3))
  lib.books[bid] = b
  if fee > 0.dec(): "returned {mid} {bid} fee {fee.fmt(2)}" else: "returned {mid} {bid}"

fn reserve(mut lib: Lib, mid: str, bid: str) -> str:
  if not lib.members.has(mid): return "refused {mid} {bid}: unknown member"
  if not lib.books.has(bid): return "refused {mid} {bid}: unknown book"
  m = lib.members[mid]
  b = lib.books[bid]
  if bid in m.loans: return "refused {mid} {bid}: already has it"
  if mid in b.waiting: return "refused {mid} {bid}: already reserved"
  if b.shelf > 0: return "refused {mid} {bid}: copy available"
  b.waiting.push(mid)
  lib.books[bid] = b
  "reserved {mid} {bid} position {b.waiting.len()}"

fn pay(mut lib: Lib, mid: str, amount: dec) -> str:
  if not lib.members.has(mid): return "refused {mid}: unknown member"
  m = lib.members[mid]
  m.owes -= amount
  lib.members[mid] = m
  "paid {mid} owes {m.owes.fmt(2)}"

fn status(lib: Lib, mid: str) -> str:
  if not lib.members.has(mid): return "refused {mid}: unknown member"
  m = lib.members[mid]
  ls = if m.loans.is_empty(): "-" else: " ".join(m.loans)
  "{mid} {m.name} owes {m.owes.fmt(2)} loans: {ls}"
