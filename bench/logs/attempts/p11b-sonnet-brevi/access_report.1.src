reqs = 0
bad = 0
total = 0
ips = {}
cls = {}
paths = {}
hrs = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full('(\S+) - - \[([^\]]*)\] "(\S+) (\S+) (\S+)" (\d{3}) (\d+|-) "([^"]*)" "([^"]*)"')
  if not m:
    bad += 1
    continue
  reqs += 1
  ip = m[1]
  ips[ip] = 1
  path = m[4].split("?")[0]
  st = m[6].int()
  if m[7] != "-": total += m[7].int()
  c = "{st // 100}xx"
  cls[c] += 1
  paths[path] += 1
  h = m[2].slice(m[2].find(":") + 1, m[2].find(":") + 3)
  hrs[h] += 1
  if "bot" in m[9].lower(): bots += 1
  if st >= 400: errs[ip] += 1
print("requests {reqs}")
print("malformed {bad}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for k, v in cls.pairs(): print("  {k} {v}")
print("top_paths")
tp = paths.pairs().sort_by(p => (-p.1, p.0)).take(3)
for p, n in tp: print("  {n} {p}")
print("hours")
mx = max(hrs.values()).or(1)
for h, n in hrs.pairs():
  k = (n * 40 + mx) // (2 * mx)
  if k < 1: k = 1
  print("  {h} {n} {"#".repeat(k)}")
print("bots {bots}")
print("errors_by_ip")
ep = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for ip, n in ep: print("  {ip} {n}")
