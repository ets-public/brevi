## main.bv
use "graph.bv"
use "schedule.bv"

RX_DEP = "(\w+) (\d+) after (\w+(?:, \w+)*)"
RX_PLAIN = "(\w+) (\d+)"

problem = ""
k = 0
header = false
names = []
days = []
depnames = []
idx = {}
ln = 0

for i, raw in enumerate(stdin().lines()):
  ln = i + 1
  line = raw.trim()
  if line.is_empty(): continue
  if not header:
    g = line.re_full("workers (\d+)")
    if g.is_empty() or g[1].int().or(0) < 1:
      problem = "line {ln}: bad line"
      break
    k = g[1].int().or(0)
    header = true
    continue
  nm = ""
  dd = 0
  dl = []
  gd = line.re_full(RX_DEP)
  gp = line.re_full(RX_PLAIN)
  if not gd.is_empty():
    nm = gd[1]
    dd = gd[2].int().or(0)
    dl = gd[3].split(", ")
  elif not gp.is_empty():
    nm = gp[1]
    dd = gp[2].int().or(0)
  if nm == "" or dd < 1:
    problem = "line {ln}: bad line"
    break
  if idx.has(nm):
    problem = "line {ln}: duplicate {nm}"
    break
  idx[nm] = names.len()
  names.push(nm)
  days.push(dd)
  depnames.push(dl)

n = names.len()
if problem == "":
  unk = find_unknown(depnames, idx)
  if unk != "": problem = "unknown {unk}"

deps = []
dependents = []
order = []
if problem == "":
  deps = [[idx[d] for d in dl] for dl in depnames]
  for i in range(0, n):
    dependents.push([])
  for i in range(0, n):
    for d in deps[i]:
      dependents[d].push(i)
  order = topo_order(deps, dependents)
  if order.len() < n: problem = "cycle"

if problem != "":
  print(problem)
else:
  st = earliest(order, deps, days)
  ends = [st[i] + days[i] for i in range(0, n)]
  total = 0
  for e in ends:
    if e > total: total = e
  print("unlimited")
  for i in range(0, n):
    print("  {names[i]} {st[i]}-{ends[i]}")
  print("length {total}")
  chain = critical(order, deps, dependents, st, ends, total)
  print("critical " + " > ".join([names[c] for c in chain]))

  tl = tails(order, dependents, days)
  sst = make_schedule(k, deps, days, tl)
  sends = [sst[i] + days[i] for i in range(0, n)]
  stotal = 0
  for e in sends:
    if e > stotal: stotal = e
  print("workers {k}")
  for i in range(0, n):
    print("  {names[i]} {sst[i]}-{sends[i]}")
  print("length {stotal}")
## graph.bv
fn find_unknown(depnames: [[str]], idx: {str: int}) -> str:
  for dl in depnames:
    for d in dl:
      if not idx.has(d): return d
  return ""

fn topo_order(deps: [[int]], dependents: [[int]]) -> [int]:
  n = deps.len()
  indeg = [deps[i].len() for i in range(0, n)]
  order = []
  for i in range(0, n):
    if indeg[i] == 0: order.push(i)
  h = 0
  while h < order.len():
    u = order[h]
    h += 1
    for v in dependents[u]:
      indeg[v] = indeg[v] - 1
      if indeg[v] == 0: order.push(v)
  return order

fn earliest(order: [int], deps: [[int]], days: [int]) -> [int]:
  n = days.len()
  st = [0 for i in range(0, n)]
  for u in order:
    s = 0
    for d in deps[u]:
      e = st[d] + days[d]
      if e > s: s = e
    st[u] = s
  return st

fn critical(order: [int], deps: [[int]], dependents: [[int]], st: [int], ends: [int], total: int) -> [int]:
  n = ends.len()
  good = []
  for i in range(0, n):
    good.push(false)
  for u in order.rev():
    g = ends[u] == total
    for v in dependents[u]:
      if good[v] and st[v] == ends[u]: g = true
    good[u] = g
  chain = []
  start = -1
  for i in range(0, n):
    if start < 0 and st[i] == 0 and good[i]: start = i
  if start < 0: return chain
  cur = start
  chain.push(cur)
  while ends[cur] != total:
    nxt = -1
    for v in range(0, n):
      if nxt < 0 and good[v] and st[v] == ends[cur] and deps[v].contains(cur): nxt = v
    if nxt < 0: break
    chain.push(nxt)
    cur = nxt
  return chain
## schedule.bv
fn tails(order: [int], dependents: [[int]], days: [int]) -> [int]:
  n = days.len()
  tl = [0 for i in range(0, n)]
  for u in order.rev():
    m = 0
    for v in dependents[u]:
      if tl[v] > m: m = tl[v]
    tl[u] = days[u] + m
  return tl

fn ready(i: int, deps: [[int]], endt: [int], now: int) -> bool:
  for d in deps[i]:
    if endt[d] < 0 or endt[d] > now: return false
  return true

fn make_schedule(k: int, deps: [[int]], days: [int], tl: [int]) -> [int]:
  n = days.len()
  st = [0 for i in range(0, n)]
  endt = [-1 for i in range(0, n)]
  running = []
  done = 0
  now = 0
  while done < n:
    still = []
    for r in running:
      if endt[r] == now:
        done += 1
      else:
        still.push(r)
    running = still
    while running.len() < k:
      best = -1
      for i in range(0, n):
        if endt[i] < 0 and ready(i, deps, endt, now) and (best < 0 or tl[i] > tl[best]):
          best = i
      if best < 0: break
      st[best] = now
      endt[best] = now + days[best]
      running.push(best)
    if running.is_empty(): break
    nxt = -1
    for r in running:
      if nxt < 0 or endt[r] < nxt: nxt = endt[r]
    now = nxt
  return st
