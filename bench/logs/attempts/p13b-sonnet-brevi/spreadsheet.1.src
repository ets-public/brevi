defs = {}
memo = {}
visiting = {}
maxc = 0
maxr = 0

fn note(name: str):
  c = name.code() - 64
  r = name.slice(1).int()
  if c > maxc: maxc = c
  if r > maxr: maxr = r

fn getcell(name: str) -> (int, int):
  if memo.has(name): return memo[name]
  if visiting.has(name): return (2, 0)
  if not defs.has(name): return (0, 0)
  c = defs[name]
  res = (0, 0)
  if c.starts_with("="):
    visiting[name] = 1
    ts = c.slice(1).re_list('[A-Z]+\d+|\d+|[-+*/():]|[A-Z]+')
    e, v, p = expr(ts, 0)
    visiting.remove(name)
    if e > 0: v = 0
    res = (e, v)
  else:
    res = (0, c.int())
  memo[name] = res
  res

fn expr(ts: [str], p0: int) -> (int, int, int):
  e, v, p = term(ts, p0)
  while p < ts.len() and (ts[p] == "+" or ts[p] == "-"):
    op = ts[p]
    e2, v2, q = term(ts, p + 1)
    p = q
    e = max(e, e2)
    if op == "+": v = v + v2
    else: v = v - v2
  (e, v, p)

fn term(ts: [str], p0: int) -> (int, int, int):
  e, v, p = factor(ts, p0)
  while p < ts.len() and (ts[p] == "*" or ts[p] == "/"):
    op = ts[p]
    e2, v2, q = factor(ts, p + 1)
    p = q
    e = max(e, e2)
    if op == "*": v = v * v2
    elif v2 == 0:
      e = max(e, 1)
      v = 0
    else: v = v / v2
  (e, v, p)

fn factor(ts: [str], p: int) -> (int, int, int):
  t = ts[p]
  if t == "-":
    e, v, q = factor(ts, p + 1)
    return (e, -v, q)
  if t == "(":
    e, v, q = expr(ts, p + 1)
    return (e, v, q + 1)
  if t.is_digit(): return (0, t.int(), p + 1)
  if t == "SUM" or t == "MIN" or t == "MAX":
    a = ts[p + 2]
    b = ts[p + 4]
    c1 = min(a.code(), b.code())
    c2 = max(a.code(), b.code())
    r1 = min(a.slice(1).int(), b.slice(1).int())
    r2 = max(a.slice(1).int(), b.slice(1).int())
    e = 0
    vals = []
    for c in c1..c2 + 1:
      for r in r1..r2 + 1:
        ee, vv = getcell(c.char() + str(r))
        e = max(e, ee)
        vals.push(vv)
    v = 0
    if e == 0:
      if t == "SUM": v = vals.sum()
      elif t == "MIN": v = vals.min()
      else: v = vals.max()
    return (e, v, p + 6)
  e, v = getcell(t)
  (e, v, p + 1)

for line in lines():
  i = line.find("=")
  if i < 0: continue
  name = line.slice(0, i).trim()
  content = line.slice(i + 1).trim().replace(" ", "")
  defs[name] = content
  note(name)
  if content.starts_with("="):
    for m in content.re_list('[A-Z]+\d+'): note(m)
print("\t" + "\t".join([(c + 64).char() for c in 1..maxc + 1]))
for r in 1..maxr + 1:
  row = []
  for c in 1..maxc + 1:
    name = (c + 64).char() + str(r)
    s = ""
    if defs.has(name):
      e, v = getcell(name)
      if e == 2: s = "#CYCLE"
      elif e == 1: s = "#DIV0"
      else: s = str(v)
    row.push(s)
  print(str(r) + "\t" + "\t".join(row))
