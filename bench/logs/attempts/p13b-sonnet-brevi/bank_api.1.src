owners = {}
bals = {}
nextid = 1

fn acct(id: int) = str({"id": id, "owner": owners[id], "balance": bals[id]})

fn amount_ok(j: Json) -> bool = match j["amount"]:
  Num(n) => n > 0.0 and n == n.floor()
  _ => false

fn handle(line: str) -> str:
  sp = line.find(" ")
  if sp < 0: return '404 {"error":"not found"}'
  method = line.slice(0, sp)
  rest = line.slice(sp + 1)
  sp2 = rest.find(" ")
  path = rest
  body = ""
  if sp2 >= 0:
    path = rest.slice(0, sp2)
    body = rest.slice(sp2 + 1).trim()
  segs = path.split("/")
  # segs[0] is "" for a path starting with /
  route = ""
  id = 0
  if segs[0] != "": return '404 {"error":"not found"}'
  n = segs.len()
  if method == "POST" and path == "/accounts": route = "create"
  elif method == "GET" and path == "/accounts": route = "list"
  elif method == "POST" and path == "/transfer": route = "transfer"
  elif n == 3 and segs[1] == "accounts" and segs[2].is_digit() and method == "GET":
    route = "get"
    id = segs[2].int()
  elif n == 4 and segs[1] == "accounts" and segs[2].is_digit() and method == "POST" and segs[3] == "deposit":
    route = "deposit"
    id = segs[2].int()
  elif n == 4 and segs[1] == "accounts" and segs[2].is_digit() and method == "POST" and segs[3] == "withdraw":
    route = "withdraw"
    id = segs[2].int()
  if route == "": return '404 {"error":"not found"}'
  if route == "list":
    ids = owners.keys().sort_by(i => (-bals[i], i))
    return "200 " + "[" + ",".join([acct(i) for i in ids]) + "]"
  if route == "get":
    if not owners.has(id): return '404 {"error":"no such account"}'
    return "200 " + acct(id)
  j = json("{}")
  if body.is_empty():
    return '400 {"error":"bad json"}'
  match json(body):
    Ok(v) => j = v
    Err(e) => return '400 {"error":"bad json"}'
  if route == "create":
    name = match j["owner"]:
      Str(s) => s
      _ => ""
    if name.is_empty(): return '400 {"error":"owner required"}'
    nid = nextid
    nextid += 1
    owners[nid] = name
    bals[nid] = 0
    return "201 " + acct(nid)
  if route == "transfer":
    a = j["from"].int()
    b = j["to"].int()
    if not owners.has(a) or not owners.has(b): return '404 {"error":"no such account"}'
    if a == b: return '400 {"error":"same account"}'
    if not amount_ok(j): return '400 {"error":"bad amount"}'
    amt = j["amount"].int()
    if amt > bals[a]: return '409 {"error":"insufficient funds"}'
    bals[a] -= amt
    bals[b] += amt
    return "200 " + str({"from": bals[a], "to": bals[b]})
  if not owners.has(id): return '404 {"error":"no such account"}'
  if not amount_ok(j): return '400 {"error":"bad amount"}'
  amt = j["amount"].int()
  if route == "withdraw":
    if amt > bals[id]: return '409 {"error":"insufficient funds"}'
    bals[id] -= amt
  else:
    bals[id] += amt
  "200 " + acct(id)

for line in lines():
  if line.trim().is_empty(): continue
  print(handle(line.trim()))
