fn mins(s: str) -> int:
  p = s.split(":")
  return p[0].int().or(0) * 60 + p[1].int().or(0)

fn fmt_t(m: int) -> str:
  h = m // 60
  mi = m % 60
  hs = str(h)
  ms = str(mi)
  if h < 10: hs = "0" + hs
  if mi < 10: ms = "0" + ms
  return hs + ":" + ms

L = lines()
sep = L.index_of("---")
tnames = []
tst = {}
ttm = {}
for line in L.slice(0, sep):
  w = line.words()
  if w.is_empty(): continue
  T = w[0]
  stn = []
  tms = []
  for i in range(1, w.len(), 2):
    stn.push(w[i])
    tms.push(mins(w[i + 1]))
  tnames.push(T)
  tst[T] = stn
  ttm[T] = tms
for line in L.slice(sep + 1):
  w = line.words()
  if w.is_empty(): continue
  frm = w[0]
  to = w[1]
  qt = mins(w[2])
  if frm == to:
    print("{frm} {to} {fmt_t(qt)} via -")
    continue
  best = {}
  for T in tnames:
    st = tst[T]
    tm = ttm[T]
    for j in range(0, st.len() - 1):
      if st[j] == frm and tm[j] >= qt:
        key = frm + "@" + T
        cand = (1, T)
        if not best.has(key) or cand < best[key]: best[key] = cand
  changed = true
  while changed:
    changed = false
    for key in best.keys():
      parts = key.split("@")
      S = parts[0]
      T = parts[1]
      lab = best[key]
      cnt = lab.0
      route = lab.1
      st = tst[T]
      tm = ttm[T]
      j = st.index_of(S)
      for k in range(j + 1, st.len()):
        nk = st[k] + "@" + T
        cand = (cnt, route)
        if not best.has(nk) or cand < best[nk]:
          best[nk] = cand
          changed = true
      if cnt < tnames.len():
        for U in tnames:
          if U != T:
            su = tst[U]
            mu = ttm[U]
            for m in range(0, su.len() - 1):
              if su[m] == S and mu[m] >= tm[j] + 5:
                nk = S + "@" + U
                cand = (cnt + 1, route + ">" + U)
                if not best.has(nk) or cand < best[nk]:
                  best[nk] = cand
                  changed = true
  cands = []
  for key in best.keys():
    parts = key.split("@")
    if parts[0] == to:
      T = parts[1]
      tt = ttm[T][tst[T].index_of(to)]
      cands.push((tt, best[key].0, best[key].1))
  if cands.is_empty():
    print("{frm} {to} unreachable")
  else:
    c = min(cands)
    print("{frm} {to} {fmt_t(c.0)} via {c.2}")
