## main.py
import sys
from parse import parse_program
from machine import run


def main():
    lines = sys.stdin.read().split('\n')
    prog = lines
    rest = []
    for i, l in enumerate(lines):
        if l.strip() == '---':
            prog = lines[:i]
            rest = lines[i + 1:]
            break
    try:
        inputs = [int(t) for t in ' '.join(rest).split()]
    except ValueError:
        inputs = []
    instrs, labels, errors = parse_program(prog)
    if errors:
        print('\n'.join(errors))
        return
    out = []
    steps, regs = run(instrs, labels, inputs, out)
    out.append('steps %d' % steps)
    nz = ''.join(' r%d=%d' % (i, v) for i, v in enumerate(regs) if v != 0)
    out.append('regs' + (nz if nz else ' none'))
    print('\n'.join(out))


main()
## parse.py
import re

WORD = re.compile(r'[A-Za-z_][A-Za-z0-9_]*')
REG = re.compile(r'r[0-7]')
NUM = re.compile(r'-?[0-9]+')

# kinds: r register, v value, l label
SIGS = {
    'MOV': 'rv', 'ADD': 'rv', 'SUB': 'rv', 'MUL': 'rv', 'DIV': 'rv', 'MOD': 'rv',
    'JMP': 'l', 'JZ': 'rl', 'JNZ': 'rl', 'JLT': 'vvl', 'CALL': 'l', 'RET': '',
    'PUSH': 'v', 'POP': 'r', 'READ': 'r', 'PRINT': 'v', 'HALT': '',
}


def operand(kind, s):
    if kind == 'r':
        return ('r', int(s[1])) if REG.fullmatch(s) else None
    if kind == 'v':
        if REG.fullmatch(s):
            return ('r', int(s[1]))
        if NUM.fullmatch(s):
            return ('n', int(s))
        return None
    if kind == 'l':
        return ('l', s) if WORD.fullmatch(s) else None
    return None


def parse_program(lines):
    """lines: list of program lines. Returns (instrs, errors)."""
    instrs = []  # (op, args, lineno)
    labels = {}
    errors = []  # (lineno, text)
    for idx, raw in enumerate(lines):
        n = idx + 1
        line = raw.split(';', 1)[0].strip()
        if not line:
            continue
        if line.endswith(':'):
            name = line[:-1]
            if WORD.fullmatch(name):
                if name in labels:
                    errors.append((n, 'line %d: duplicate label %s' % (n, name)))
                else:
                    labels[name] = len(instrs)
            else:
                errors.append((n, 'line %d: bad instruction' % n))
            continue
        parts = line.split(None, 1)
        op = parts[0]
        if op not in SIGS:
            errors.append((n, 'line %d: bad instruction' % n))
            continue
        sig = SIGS[op]
        ops = parts[1].split(', ') if len(parts) > 1 else []
        if len(ops) != len(sig):
            errors.append((n, 'line %d: bad instruction' % n))
            continue
        args = [operand(k, s) for k, s in zip(sig, ops)]
        if any(a is None for a in args):
            errors.append((n, 'line %d: bad instruction' % n))
            continue
        instrs.append((op, args, n))
    for op, args, n in instrs:
        for a in args:
            if a[0] == 'l' and a[1] not in labels:
                errors.append((n, 'line %d: unknown label %s' % (n, a[1])))
    errors.sort(key=lambda e: e[0])
    return instrs, labels, [e[1] for e in errors]
## machine.py
MAX_STEPS = 10000


def tdiv(a, b):
    q = abs(a) // abs(b)
    return q if (a < 0) == (b < 0) else -q


def run(instrs, labels, inputs, out):
    """Runs the program; appends output lines to out. Returns (steps, regs)."""
    regs = [0] * 8
    data = []
    calls = []
    pc = 0
    steps = 0
    inp = 0

    def val(a):
        return regs[a[1]] if a[0] == 'r' else a[1]

    while pc < len(instrs):
        if steps >= MAX_STEPS:
            out.append('error: too many steps')
            break
        op, args, n = instrs[pc]
        steps += 1
        pc += 1
        if op == 'MOV':
            regs[args[0][1]] = val(args[1])
        elif op == 'ADD':
            regs[args[0][1]] += val(args[1])
        elif op == 'SUB':
            regs[args[0][1]] -= val(args[1])
        elif op == 'MUL':
            regs[args[0][1]] *= val(args[1])
        elif op in ('DIV', 'MOD'):
            b = val(args[1])
            if b == 0:
                out.append('error line %d: division by zero' % n)
                break
            a = regs[args[0][1]]
            q = tdiv(a, b)
            regs[args[0][1]] = q if op == 'DIV' else a - q * b
        elif op == 'JMP':
            pc = labels[args[0][1]]
        elif op == 'JZ':
            if val(args[0]) == 0:
                pc = labels[args[1][1]]
        elif op == 'JNZ':
            if val(args[0]) != 0:
                pc = labels[args[1][1]]
        elif op == 'JLT':
            if val(args[0]) < val(args[1]):
                pc = labels[args[2][1]]
        elif op == 'CALL':
            calls.append(pc)
            pc = labels[args[0][1]]
        elif op == 'RET':
            if not calls:
                out.append('error line %d: stack empty' % n)
                break
            pc = calls.pop()
        elif op == 'PUSH':
            data.append(val(args[0]))
        elif op == 'POP':
            if not data:
                out.append('error line %d: stack empty' % n)
                break
            regs[args[0][1]] = data.pop()
        elif op == 'READ':
            if inp >= len(inputs):
                out.append('error line %d: no input' % n)
                break
            regs[args[0][1]] = inputs[inp]
            inp += 1
        elif op == 'PRINT':
            out.append(str(val(args[0])))
        elif op == 'HALT':
            break
    return steps, regs
