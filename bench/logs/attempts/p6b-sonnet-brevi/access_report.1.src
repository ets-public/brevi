reqs = 0
bad = 0
total = 0
ips = {}
cls = {}
paths = {}
hrs = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full("(\S+) - - \[([^\]]*)\] \"(\S+) (\S+) (\S+)\" (\d+) (\d+|-) \"([^\"]*)\" \"([^\"]*)\"")
  if m.is_empty():
    bad += 1
    continue
  reqs += 1
  ips[m[1]] = 1
  st = m[6].int()
  size = if m[7] == "-": 0 else: m[7].int()
  total += size
  cls[st // 100] += 1
  p = m[4].split("?")[0]
  paths[p] += 1
  h = m[2].split(":")[1]
  hrs[h] += 1
  if m[9].lower().contains("bot"): bots += 1
  if st >= 400: errs[m[1]] += 1
print("requests {reqs}")
print("malformed {bad}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for k, v in cls.pairs():
  print("  {k}xx {v}")
print("top_paths")
tp = paths.pairs().sort_by(p => (-p.1, p.0))
for p in tp.take(3):
  print("  {p.1} {p.0}")
print("hours")
mx = max(hrs.values()) if hrs else 1
for k, v in hrs.pairs():
  n = max((2 * v * 20 + mx) // (2 * mx), 1)
  print("  {k} {v} {"#".repeat(n)}")
print("bots {bots}")
print("errors_by_ip")
ep = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for p in ep:
  print("  {p.0} {p.1}")
