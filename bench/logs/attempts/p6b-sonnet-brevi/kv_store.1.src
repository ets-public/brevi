store: {str: str} = {}
snaps: [{str: str}] = []
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  c = w[0]
  if c == "SET" and w.len() == 3:
    store[w[1]] = w[2]
  elif c == "GET" and w.len() == 2:
    if store.has(w[1]): print(store[w[1]])
    else: print("NULL")
  elif c == "DEL" and w.len() == 2:
    if store.has(w[1]): store.remove(w[1])
    else: print("NOT FOUND")
  elif c == "INCR" and w.len() == 3:
    cur = if store.has(w[1]): store[w[1]] else: "0"
    ok = true
    a = 0
    b = 0
    match cur.int():
      Ok(n) => a = n
      Err(m) => ok = false
    match w[2].int():
      Ok(n) => b = n
      Err(m) => ok = false
    if ok:
      store[w[1]] = str(a + b)
      print(a + b)
    else:
      print("ERR not an integer")
  elif c == "COUNT" and w.len() == 2:
    print(store.values().count(v => v == w[1]))
  elif c == "KEYS" and w.len() == 2:
    ks = [k for k in store.keys() if k.starts_with(w[1])]
    if ks: print(" ".join(ks.sort()))
    else: print("(empty)")
  elif c == "BEGIN":
    snaps.push(store)
  elif c == "ROLLBACK":
    if snaps: store = snaps.pop()
    else: print("NO TRANSACTION")
  elif c == "COMMIT":
    if snaps: snaps = []
    else: print("NO TRANSACTION")
  else:
    print("ERR unknown command")
