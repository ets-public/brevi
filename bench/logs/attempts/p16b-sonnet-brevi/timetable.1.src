tnames = []
tst = []
ttm = []
stops = {}
best = {}
h = heap()

fn mins(s: str) -> int:
  p = s.split(":")
  p[0].int().or(0) * 60 + p[1].int().or(0)

fn two(n: int) -> str = if n < 10: "0" + str(n) else: str(n)

fn tfmt(m: int) -> str = two(m // 60) + ":" + two(m % 60)

fn relax(st: str, ti: int, arr: int, n: int, path: str):
  key = (st, ti)
  cand = (arr, n, path)
  if not best.has(key) or cand < best[key]:
    best[key] = cand
    h.push((arr, n, path, st, ti))

fn ride(u: int, k: int, n: int, path: str):
  for j in k + 1..tst[u].len():
    relax(tst[u][j], u, ttm[u][j], n, path)

in_q = False
queries = []
for line in lines():
  if line.trim() == "---":
    in_q = True
    continue
  w = line.words()
  if w.is_empty(): continue
  if in_q:
    queries.push(w)
  else:
    sts = []
    tms = []
    i = 1
    while i + 1 < w.len():
      sts.push(w[i])
      tms.push(mins(w[i + 1]))
      i += 2
    ti = tnames.len()
    tnames.push(w[0])
    tst.push(sts)
    ttm.push(tms)
    for k in 0..sts.len():
      stops[sts[k]].push((ti, k))

for q in queries:
  fr = q[0]
  to = q[1]
  t0 = mins(q[2])
  if fr == to:
    print("{fr} {to} {tfmt(t0)} via -")
    continue
  best = {}
  h = heap()
  for s in stops.get_or(fr, []):
    if ttm[s.0][s.1] >= t0: ride(s.0, s.1, 1, tnames[s.0])
  while not h.is_empty():
    e = h.pop()
    key = (e.3, e.4)
    if best[key] != (e.0, e.1, e.2): continue
    for s in stops.get_or(e.3, []):
      if s.0 != e.4 and ttm[s.0][s.1] >= e.0 + 5:
        ride(s.0, s.1, e.1 + 1, e.2 + ">" + tnames[s.0])
  res = []
  for k, v in best.pairs():
    if k.0 == to: res.push(v)
  if res.is_empty(): print("{fr} {to} unreachable")
  else:
    r = res.min()
    print("{fr} {to} {tfmt(r.0)} via {r.2}")
