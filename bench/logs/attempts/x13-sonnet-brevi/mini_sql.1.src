type Table:
  cols: [str]
  types: [str]
  rows: [[str]]

tables = {}
cnt = 0
PN = "[A-Za-z][A-Za-z0-9_]*"
PV = "(?:-?\d+|'(?:[^']|'')*')"
PO = "(?:!=|<=|>=|=|<|>)"
PC = PN + " " + PO + " " + PV + "(?: AND " + PN + " " + PO + " " + PV + ")*"

fn vtype(v: str) = if v.starts_with("'"): "TEXT" else: "INT"

fn norm(v: str) -> str:
  if v.starts_with("'"): return v.slice(1, -1).replace("''", "'")
  v.int().str()

fn holds(a: str, op: str, b: str, ty: str) -> bool:
  lt = if ty == "INT": a.int() < b.int() else: a < b
  eq = a == b
  if op == "=": return eq
  if op == "!=": return not eq
  if op == "<": return lt
  if op == ">": return not lt and not eq
  if op == "<=": return lt or eq
  not lt

fn conds_of(s: str) -> [(str, str, str)]:
  out = []
  for g in s.re_all("(" + PN + ") (" + PO + ") (" + PV + ")(?: AND |$)"): out.push((g[1], g[2], g[3]))
  out

fn exist_conds(t: Table, cs: [(str, str, str)]):
  for c in cs:
    if c.0 not in t.cols: fail("error: no column {c.0}")

fn type_conds(t: Table, cs: [(str, str, str)]):
  for c in cs:
    if t.types[t.cols.index_of(c.0)] != vtype(c.2): fail("error: type mismatch")

fn matches(t: Table, r: [str], cs: [(str, str, str)]) -> bool:
  for c in cs:
    i = t.cols.index_of(c.0)
    if not holds(r[i], c.1, norm(c.2), t.types[i]): return false
  true

fn get_table(name: str) -> Table:
  if not tables.has(name): fail("error: no table {name}")
  tables[name]

fn exec(line: str) -> int:
  m = line.re_full("CREATE TABLE (" + PN + ") \((" + PN + " (?:INT|TEXT)(?:, " + PN + " (?:INT|TEXT))*)\)")
  if m:
    name = m[1]
    if tables.has(name): fail("error: table {name} exists")
    cols = []
    types = []
    for d in m[2].split(", "):
      p = d.split(" ")
      cols.push(p[0])
      types.push(p[1])
    tables[name] = Table(cols: cols, types: types, rows: [])
    print("ok")
    return 0
  m = line.re_full("INSERT INTO (" + PN + ") VALUES \((" + PV + "(?:, " + PV + ")*)\)")
  if m:
    t = get_table(m[1])
    vals = m[2].re_list(PV)
    if vals.len() != t.cols.len(): fail("error: type mismatch")
    for i in 0..vals.len():
      if vtype(vals[i]) != t.types[i]: fail("error: type mismatch")
    tables[m[1]].rows.push([norm(v) for v in vals])
    print("ok")
    return 0
  m = line.re_full("SELECT COUNT\(\*\) FROM (" + PN + ")(?: WHERE (" + PC + "))?")
  if m:
    t = get_table(m[1])
    cs = conds_of(m[2])
    exist_conds(t, cs)
    type_conds(t, cs)
    print(t.rows.filter(r => matches(t, r, cs)).len())
    return 0
  m = line.re_full("SELECT (\*|" + PN + "(?:, " + PN + ")*) FROM (" + PN + ")(?: WHERE (" + PC + "))?(?: ORDER BY (" + PN + ")( DESC)?)?(?: LIMIT (\d+))?")
  if m:
    t = get_table(m[2])
    names = if m[1] == "*": t.cols else: m[1].split(", ")
    for n in names:
      if n not in t.cols: fail("error: no column {n}")
    cs = conds_of(m[3])
    exist_conds(t, cs)
    if m[4] != "" and m[4] not in t.cols: fail("error: no column {m[4]}")
    type_conds(t, cs)
    rows = t.rows.filter(r => matches(t, r, cs))
    if m[4] != "":
      ci = t.cols.index_of(m[4])
      desc = m[5] != ""
      if t.types[ci] == "INT": rows = rows.sort_by(r => r[ci].int(), desc)
      else: rows = rows.sort_by(r => r[ci], desc)
    if m[6] != "": rows = rows.take(m[6].int())
    idx = [t.cols.index_of(n) for n in names]
    print(names.join(" | "))
    for r in rows: print([r[i] for i in idx].join(" | "))
    print("({rows.len()} rows)")
    return 0
  m = line.re_full("UPDATE (" + PN + ") SET (" + PN + ") = (" + PV + ")(?: WHERE (" + PC + "))?")
  if m:
    t = get_table(m[1])
    cs = conds_of(m[4])
    if m[2] not in t.cols: fail("error: no column {m[2]}")
    exist_conds(t, cs)
    ci = t.cols.index_of(m[2])
    if t.types[ci] != vtype(m[3]): fail("error: type mismatch")
    type_conds(t, cs)
    nv = norm(m[3])
    n = 0
    for i in 0..t.rows.len():
      if matches(t, t.rows[i], cs):
        t.rows[i][ci] = nv
        n += 1
    tables[m[1]] = t
    print("updated {n}")
    return 0
  m = line.re_full("DELETE FROM (" + PN + ")(?: WHERE (" + PC + "))?")
  if m:
    t = get_table(m[1])
    cs = conds_of(m[2])
    exist_conds(t, cs)
    type_conds(t, cs)
    before = t.rows.len()
    t.rows = t.rows.filter(r => not matches(t, r, cs))
    tables[m[1]] = t
    print("deleted {before - t.rows.len()}")
    return 0
  fail("error: syntax")
  0

for line in lines():
  if line.trim().is_empty(): continue
  match exec(line):
    Ok(_) => cnt += 1
    Err(m) => print(m)
