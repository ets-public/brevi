## main.bv
use "graph.bv"
use "schedule.bv"

tasks = []
seen = {}
bad = ""
k = 0
hdr = false
n = 0

for raw in stdin().lines():
  n += 1
  line = raw.trim()
  if line == "": continue
  if not hdr:
    g = line.re_full("workers (\d+)")
    if g.len() == 0 or g[1].int().or(0) < 1:
      bad = "line {n}: bad line"
      break
    k = g[1].int().or(0)
    hdr = true
    continue
  g = line.re_full("([A-Za-z0-9_]+) (\d+)(?: after ([A-Za-z0-9_]+(?:\s*,\s*[A-Za-z0-9_]+)*))?")
  if g.len() == 0 or g[2].int().or(0) < 1:
    bad = "line {n}: bad line"
    break
  if seen.has(g[1]):
    bad = "line {n}: duplicate {g[1]}"
    break
  seen[g[1]] = true
  deps = []
  if g[3] != "":
    deps = [d.trim() for d in g[3].split(",")]
  tasks.push(Task(name: g[1], days: g[2].int().or(0), deps: deps))

if bad != "":
  print(bad)
else:
  unk = first_unknown(tasks)
  if unk != "":
    print("unknown " + unk)
  elif topo(tasks).len() < tasks.len():
    print("cycle")
  else:
    for out in plan_unlimited(tasks):
      print(out)
    for out in plan_workers(tasks, k):
      print(out)
## graph.bv
type Task:
  name: str
  days: int
  deps: [str]

fn index_of_tasks(tasks: [Task]) -> {str: int}:
  idx = {}
  for i in 0..tasks.len():
    idx[tasks[i].name] = i
  return idx

fn first_unknown(tasks: [Task]) -> str:
  names = index_of_tasks(tasks)
  for t in tasks:
    for d in t.deps:
      if not names.has(d): return d
  return ""

fn successors(tasks: [Task], idx: {str: int}) -> {int: [int]}:
  succ = {}
  for i in 0..tasks.len():
    succ[i] = []
  for i in 0..tasks.len():
    for d in tasks[i].deps:
      succ[idx[d]].push(i)
  return succ

fn topo(tasks: [Task]) -> [int]:
  n = tasks.len()
  idx = index_of_tasks(tasks)
  succ = successors(tasks, idx)
  indeg = []
  queue = []
  for i in 0..n:
    indeg.push(tasks[i].deps.len())
    if tasks[i].deps.len() == 0: queue.push(i)
  order = []
  head = 0
  while head < queue.len():
    u = queue[head]
    head += 1
    order.push(u)
    for v in succ[u]:
      indeg[v] -= 1
      if indeg[v] == 0: queue.push(v)
  return order

fn plan_unlimited(tasks: [Task]) -> [str]:
  n = tasks.len()
  idx = index_of_tasks(tasks)
  order = topo(tasks)
  st = []
  en = []
  for i in 0..n:
    st.push(0)
    en.push(0)
  for u in order:
    s = 0
    for d in tasks[u].deps:
      s = max(s, en[idx[d]])
    st[u] = s
    en[u] = s + tasks[u].days
  L = 0
  for i in 0..n:
    L = max(L, en[i])
  succ = successors(tasks, idx)
  ba = []
  for i in 0..n:
    ba.push(false)
  for u in order.rev():
    ok = en[u] == L
    for s in succ[u]:
      if st[s] == en[u] and ba[s]: ok = true
    ba[u] = ok
  cur = -1
  for i in 0..n:
    if cur < 0 and st[i] == 0 and ba[i]: cur = i
  chain = []
  while cur >= 0:
    chain.push(tasks[cur].name)
    if en[cur] == L: break
    nxt = -1
    for s in succ[cur]:
      if nxt < 0 and st[s] == en[cur] and ba[s]: nxt = s
    cur = nxt
  lines = ["unlimited"]
  for i in 0..n:
    lines.push("  {tasks[i].name} {st[i]}-{en[i]}")
  lines.push("length " + str(L))
  lines.push("critical " + " > ".join(chain))
  return lines
## schedule.bv
use "graph.bv"

fn is_ready(tasks: [Task], idx: {str: int}, sch: [bool], en: [int], t: int, u: int) -> bool:
  for d in tasks[u].deps:
    p = idx[d]
    if not sch[p] or en[p] > t: return false
  return true

fn plan_workers(tasks: [Task], k: int) -> [str]:
  n = tasks.len()
  idx = index_of_tasks(tasks)
  succ = successors(tasks, idx)
  order = topo(tasks)
  tl = []
  for i in 0..n:
    tl.push(0)
  for u in order.rev():
    best = 0
    for s in succ[u]:
      best = max(best, tl[s])
    tl[u] = tasks[u].days + best
  sch = []
  st = []
  en = []
  for i in 0..n:
    sch.push(false)
    st.push(0)
    en.push(0)
  running = []
  free = k
  done = 0
  t = 0
  while done < n:
    keep = []
    for r in running:
      if en[r] == t:
        free += 1
      else:
        keep.push(r)
    running = keep
    while free > 0:
      best = -1
      for u in 0..n:
        if not sch[u] and is_ready(tasks, idx, sch, en, t, u):
          if best < 0 or tl[u] > tl[best]: best = u
      if best < 0: break
      sch[best] = true
      st[best] = t
      en[best] = t + tasks[best].days
      running.push(best)
      free -= 1
      done += 1
    if done >= n: break
    if running.len() == 0: break
    nxt = en[running[0]]
    for r in running:
      nxt = min(nxt, en[r])
    t = nxt
  L = 0
  for i in 0..n:
    L = max(L, en[i])
  lines = ["workers " + str(k)]
  for i in 0..n:
    lines.push("  {tasks[i].name} {st[i]}-{en[i]}")
  lines.push("length " + str(L))
  return lines
