ms = {}
errs = {}
for l in lines():
  w = l.words()
  if w.len() < 4: continue
  ms[w[1]].push(w[3].int())
  if w[2].int() >= 500: errs[w[1]] += 1
for p, v in ms.pairs():
  s = v.sort()
  n = s.len()
  k = (9 * n + 9) // 10
  avg = s.sum().float() / n.float()
  er = errs[p].float() * 100.0 / n.float()
  print("{p} {n} {avg.fmt(1)} {s[k - 1]} {er.fmt(1)}%")
