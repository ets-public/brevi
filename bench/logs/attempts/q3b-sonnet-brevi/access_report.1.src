reqs = 0
bad = 0
bytes = 0
ips = {}
classes = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full('(\S+) - - \[([^\]]*)\] "(\S+) (\S+) (\S+)" (\d{3}) (\d+|-) "([^"]*)" "([^"]*)"')
  if not m:
    bad += 1
    continue
  reqs += 1
  ip = m[1]
  ips[ip] = 1
  path = m[4].split("?")[0]
  status = m[6].int()
  if m[7] != "-": bytes += m[7].int()
  classes[status // 100] += 1
  paths[path] += 1
  hr = m[2].split(":")[1]
  hours[hr] += 1
  if "bot" in m[9].lower(): bots += 1
  if status >= 400: errs[ip] += 1
print("requests {reqs}")
print("malformed {bad}")
print("bytes {bytes}")
print("unique_ips {ips.len()}")
print("status")
for c, n in classes.pairs():
  print("  {c}xx {n}")
print("top_paths")
pp = paths.pairs().sort_by(p => (-p.1, p.0))
for p in pp.take(3):
  print("  {p.1} {p.0}")
print("hours")
mx = max(hours.values())
for h, n in hours.pairs():
  k = (40 * n + mx) // (2 * mx)
  if k < 1: k = 1
  print("  {h} {n} {"#".repeat(k)}")
print("bots {bots}")
print("errors_by_ip")
ee = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for p in ee:
  print("  {p.0} {p.1}")
