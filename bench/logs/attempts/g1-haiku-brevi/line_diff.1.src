fn main():
  allL = lines()
  sep = allL.index_of("=====")
  old = []
  new = []
  if sep < 0:
    old = allL
  else:
    old = allL[0:sep]
    new = allL[sep + 1:]
  if old == new:
    print("no changes")
  else:
    n = old.len()
    m = new.len()
    L = []
    for i in 0..n + 1:
      L.push([0].repeat(m + 1))
    for k in 0..n:
      i = n - 1 - k
      for h in 0..m:
        j = m - 1 - h
        if old[i] == new[j]:
          L[i][j] = L[i + 1][j + 1] + 1
        else:
          L[i][j] = max(L[i + 1][j], L[i][j + 1])
    out = []
    minus = 0
    plus = 0
    i = 0
    j = 0
    while i < n and j < m:
      if old[i] == new[j]:
        out.push("  " + old[i])
        i += 1
        j += 1
      elif L[i + 1][j] >= L[i][j + 1]:
        out.push("- " + old[i])
        minus += 1
        i += 1
      else:
        out.push("+ " + new[j])
        plus += 1
        j += 1
    while i < n:
      out.push("- " + old[i])
      minus += 1
      i += 1
    while j < m:
      out.push("+ " + new[j])
      plus += 1
      j += 1
    for line in out:
      print(line)
    print("@@ -{minus} +{plus} @@")
