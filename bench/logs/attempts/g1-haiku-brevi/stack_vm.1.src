fn main():
  ops = []
  args = []
  lnos = []
  labels = {}
  lineno = 0
  for line in lines():
    lineno += 1
    p = line.find("#")
    s = line
    if p >= 0: s = line[0:p]
    s = s.trim()
    if s == "": continue
    if s.ends_with(":"):
      labels[s[0:s.len() - 1].trim()] = ops.len()
      continue
    parts = s.split(" ").filter(x => x != "")
    op = parts[0]
    arg = ""
    if parts.len() > 1: arg = parts[1]
    ops.push(op)
    args.push(arg)
    lnos.push(lineno)
  n = ops.len()
  known = ["push", "pop", "dup", "swap", "add", "sub", "mul", "div", "mod", "jmp", "jz", "jnz", "call", "ret", "print", "halt"]
  err = false
  for i in 0..n:
    if ops[i] not in known:
      print("error line {lnos[i]}: unknown instruction {ops[i]}")
      err = true
      break
    if ops[i] in ["jmp", "jz", "jnz", "call"] and not labels.has(args[i]):
      print("error line {lnos[i]}: unknown label {args[i]}")
      err = true
      break
  if not err:
    stack = []
    calls = []
    pc = 0
    steps = 0
    done = false
    while not done and pc < n:
      if steps >= 10000:
        print("error: step limit")
        done = true
        continue
      steps += 1
      op = ops[pc]
      arg = args[pc]
      ln = lnos[pc]
      need = 0
      if op in ["pop", "dup", "print", "jz", "jnz"]: need = 1
      if op in ["swap", "add", "sub", "mul", "div", "mod"]: need = 2
      if stack.len() < need:
        print("error line {ln}: stack underflow")
        done = true
      elif op == "push":
        stack.push(arg.int().or(0))
        pc += 1
      elif op == "pop":
        stack.pop()
        pc += 1
      elif op == "dup":
        stack.push(stack[-1])
        pc += 1
      elif op == "swap":
        i1 = stack.len() - 1
        i2 = i1 - 1
        t = stack[i1]
        stack[i1] = stack[i2]
        stack[i2] = t
        pc += 1
      elif op in ["add", "sub", "mul", "div", "mod"]:
        b = stack[-1]
        a = stack[-2]
        if (op == "div" or op == "mod") and b == 0:
          print("error line {ln}: division by zero")
          done = true
        else:
          r = 0
          if op == "add": r = a + b
          elif op == "sub": r = a - b
          elif op == "mul": r = a * b
          elif op == "div": r = a / b
          else: r = a % b
          stack.pop()
          stack.pop()
          stack.push(r)
          pc += 1
      elif op == "jmp":
        pc = labels[arg]
      elif op == "jz":
        v = stack[-1]
        stack.pop()
        if v == 0:
          pc = labels[arg]
        else:
          pc += 1
      elif op == "jnz":
        v = stack[-1]
        stack.pop()
        if v != 0:
          pc = labels[arg]
        else:
          pc += 1
      elif op == "call":
        calls.push(pc + 1)
        pc = labels[arg]
      elif op == "ret":
        if calls.len() == 0:
          done = true
        else:
          pc = calls[-1]
          calls.pop()
      elif op == "print":
        print(stack[-1])
        stack.pop()
        pc += 1
      else:
        done = true
