owners = []
bals = []

fn err(msg: str) -> str = "{\"error\":\"" + msg + "\"}"

fn acct(i: int) -> str = str({"id": i + 1, "owner": owners[i], "balance": bals[i]})

fn exists(id: int) -> bool = id >= 1 and id <= owners.len()

fn is_num(s: str) -> bool:
  if s.is_empty():
    return false
  for c in s:
    if not c.is_digit():
      return false
  return true

fn parse(body: str) -> Json:
  match json(body):
    Ok(j) => j
    Err(e) => Null

fn is_null(j: Json) -> bool:
  match j:
    Null => true
    _ => false

fn field(j: Json, key: str) -> Json:
  match j:
    Obj(m) => m.get_or(key, Null)
    _ => Null

fn as_amount(j: Json) -> int:
  match j:
    Num(n) => if n >= 1.0 and n == n.floor(): n.int() else: -1
    _ => -1

fn as_id(j: Json) -> int:
  match j:
    Num(n) => if n == n.floor(): n.int() else: -1
    _ => -1

fn owner_of(j: Json) -> str:
  match j:
    Str(s) => s
    _ => ""

fn list_json() -> str:
  order = [i for i in 0..owners.len()]
  order = order.sort_by(i => (-bals[i], i))
  return "[" + ",".join([acct(i) for i in order]) + "]"

fn create(body: str) -> str:
  j = parse(body)
  if is_null(j):
    return "400 " + err("bad json")
  name = owner_of(field(j, "owner"))
  if name.is_empty():
    return "400 " + err("owner required")
  owners.push(name)
  bals.push(0)
  return "201 " + acct(owners.len() - 1)

fn op(id: int, kind: str, body: str) -> str:
  j = parse(body)
  if is_null(j):
    return "400 " + err("bad json")
  if not exists(id):
    return "404 " + err("no such account")
  amt = as_amount(field(j, "amount"))
  if amt < 0:
    return "400 " + err("bad amount")
  i = id - 1
  if kind == "deposit":
    bals[i] += amt
  else:
    if amt > bals[i]:
      return "409 " + err("insufficient funds")
    bals[i] -= amt
  return "200 " + acct(i)

fn transfer(body: str) -> str:
  j = parse(body)
  if is_null(j):
    return "400 " + err("bad json")
  a = as_id(field(j, "from"))
  b = as_id(field(j, "to"))
  if not exists(a) or not exists(b):
    return "404 " + err("no such account")
  if a == b:
    return "400 " + err("same account")
  amt = as_amount(field(j, "amount"))
  if amt < 0:
    return "400 " + err("bad amount")
  if amt > bals[a - 1]:
    return "409 " + err("insufficient funds")
  bals[a - 1] -= amt
  bals[b - 1] += amt
  return "200 {\"from\":" + str(bals[a - 1]) + ",\"to\":" + str(bals[b - 1]) + "}"

fn respond(method: str, path: str, body: str) -> str:
  segs = path.split("/")
  n = segs.len()
  if n == 2 and segs[0] == "" and segs[1] == "accounts":
    if method == "GET":
      return "200 " + list_json()
    if method == "POST":
      return create(body)
    return "404 " + err("not found")
  if n == 2 and segs[0] == "" and segs[1] == "transfer" and method == "POST":
    return transfer(body)
  if n >= 3 and segs[0] == "" and segs[1] == "accounts" and is_num(segs[2]):
    id = segs[2].int().or(0)
    if n == 3 and method == "GET":
      if not exists(id):
        return "404 " + err("no such account")
      return "200 " + acct(id - 1)
    if n == 4 and method == "POST" and (segs[3] == "deposit" or segs[3] == "withdraw"):
      return op(id, segs[3], body)
  return "404 " + err("not found")

for line in lines():
  if line.is_empty():
    continue
  sp = line.find(" ")
  method = line
  rest = ""
  if sp >= 0:
    method = line.slice(0, sp)
    rest = line.slice(sp + 1)
  path = rest
  body = ""
  sp2 = rest.find(" ")
  if sp2 >= 0:
    path = rest.slice(0, sp2)
    body = rest.slice(sp2 + 1)
  print(respond(method, path, body))
