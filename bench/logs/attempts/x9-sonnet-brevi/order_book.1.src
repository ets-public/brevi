type Order:
  id: str
  side: str
  qty: int
  price: dec
  seq: int

book = []
used = {}
vol = 0
val = 0.dec()
seq = 0

fn best(side: str, limit: bool, p: dec) -> int:
  bi = -1
  for i in 0..book.len():
    o = book[i]
    ok = o.side == side and (not limit or (side == "S" and o.price <= p) or (side == "B" and o.price >= p))
    if ok:
      if bi < 0:
        bi = i
      else:
        b = book[bi]
        better = if side == "S": o.price < b.price else: o.price > b.price
        if better: bi = i
  bi

fn trade(side: str, id: str, qty: int, limit: bool, p: dec) -> int:
  rem = qty
  rs = if side == "B": "S" else: "B"
  while rem > 0:
    i = best(rs, limit, p)
    if i < 0: break
    o = book[i]
    q = min(rem, o.qty)
    bid = if side == "B": id else: o.id
    sid = if side == "B": o.id else: id
    print("TRADE {bid} {sid} {q} {o.price.fmt(2)}")
    vol += q
    val += o.price * q
    rem -= q
    if q == o.qty:
      book.remove(i)
    else:
      book[i].qty -= q
  rem

fn money(c: int) -> str = "{c // 100}.{c % 100:02d}"

fn show(side: str):
  m = {}
  for o in book:
    if o.side == side: m[(o.price * 100).int()] += o.qty
  ps = [(c, q) for c, q in m.pairs()]
  if side == "B": ps = ps.rev()
  if not ps: print("  -")
  for c, q in ps: print("  {money(c)} {q}")

fn handle(line: str) -> int:
  w = line.words()
  cmd = w[0]
  n = w.len()
  isl = (cmd == "BUY" or cmd == "SELL") and n == 4
  ism = (cmd == "MBUY" or cmd == "MSELL") and n == 3
  if cmd == "BOOK" and n == 1:
    print("asks")
    show("S")
    print("bids")
    show("B")
    return 0
  if cmd == "CANCEL" and n == 2:
    for i in 0..book.len():
      if book[i].id == w[1]:
        print("CANCELLED {w[1]} {book[i].qty}")
        book.remove(i)
        return 0
    fail("unknown ID")
  if not (isl or ism): fail("bad command")
  if not w[1].re_full("\w+"): fail("bad command")
  if not w[2].re_full("[0-9]+"): fail("bad command")
  qty = w[2].int()
  if qty < 1: fail("bad command")
  p = 0.dec()
  if isl:
    if not w[3].re_full("[0-9]+(\.[0-9]{1,2})?"): fail("bad command")
    p = w[3].dec()
    if p <= 0: fail("bad command")
  if used.has(w[1]): fail("duplicate ID")
  used[w[1]] = 1
  side = if cmd == "BUY" or cmd == "MBUY": "B" else: "S"
  rem = trade(side, w[1], qty, isl, p)
  if rem > 0:
    if isl:
      seq += 1
      book.push(Order(id: w[1], side: side, qty: rem, price: p, seq: seq))
    else:
      print("DROPPED {w[1]} {rem}")
  0

ln = 0
for line in lines():
  ln += 1
  if line.trim().is_empty(): continue
  match handle(line):
    Ok(_) => ln = ln
    Err(m) => print("ERR line {ln}: {m}")
print("volume {vol} value {val.fmt(2)}")
