pat = "^(\S+) - - \[([^\]]+)\] \"(\S+) (\S+) (\S+)\" (\d{3}) (\d+|-) \"[^\"]*\" \"([^\"]*)\"$"
requests = 0
malformed = 0
total = 0
ips = {}
status = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full(pat)
  if m.is_empty():
    malformed += 1
    continue
  requests += 1
  total += m[7].int().or(0)
  ips[m[1]] += 1
  status[m[6].slice(0, 1) + "xx"] += 1
  paths[m[4].split("?")[0]] += 1
  hours[m[2].slice(12, 14)] += 1
  if m[8].lower().contains("bot"):
    bots += 1
  if m[6].int().or(0) >= 400:
    errs[m[1]] += 1

print("requests {requests}")
print("malformed {malformed}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for k, v in status.pairs():
  print("  {k} {v}")
print("top_paths")
items = [(n, p) for p, n in paths.pairs()]
items = items.sort_by(t => (-t.0, t.1))
for t in items.take(3):
  print("  {t.0} {t.1}")
print("hours")
mx = hours.values().max().or(1)
for h, n in hours.pairs():
  bar = "#".repeat(max(1, (40 * n + mx) // (2 * mx)))
  print("  {h} {n} {bar}")
print("bots {bots}")
print("errors_by_ip")
bad = [(n, ip) for ip, n in errs.pairs() if n >= 2]
bad = bad.sort_by(t => (-t.0, t.1))
for t in bad:
  print("  {t.1} {t.0}")
