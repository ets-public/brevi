## main.bv
use "billing.bv"
use "garage.bv"

fn main():
  src = lines()
  if src.is_empty():
    return
  hw = src[0].words()
  c = hw[2].int()
  m = hw[4].int()
  v = hw[6].int()
  names = make_names(c, m, v)
  occ = [""].repeat(names.len())
  inside = {}
  last = -1
  revenue = 0
  exits = 0
  for i in range(1, src.len()):
    ln = i + 1
    w = src[i].words()
    if w.is_empty():
      continue
    ok = false
    t = -1
    cmd = ""
    if w.len() >= 3 and valid_date(w[0]) and valid_time(w[1]):
      t = to_abs(w[0], w[1])
      cmd = w[2]
      ok = (cmd == "IN" and w.len() == 5 and (w[4] == "car" or w[4] == "moto" or w[4] == "van")) or (cmd == "OUT" and w.len() == 4) or (cmd == "REPORT" and w.len() == 3)
    if not ok:
      print("line " + str(ln) + ": bad line")
      continue
    if last >= 0 and t < last:
      print("line " + str(ln) + ": time goes back")
      continue
    if cmd == "IN":
      plate = w[3]
      vt = w[4]
      if inside.has(plate):
        print("line " + str(ln) + ": already inside")
        continue
      sp = park(names, occ, plate, vt)
      if sp == "":
        print("FULL " + plate)
      else:
        inside[plate] = (sp, vt, t)
        print("IN " + plate + " " + sp)
    elif cmd == "OUT":
      plate = w[3]
      if not inside.has(plate):
        print("line " + str(ln) + ": not inside")
        continue
      rec = inside[plate]
      d = t - rec.2
      f = fee_cents(rec.1, d)
      release(names, occ, rec.0)
      inside.remove(plate)
      revenue += f
      exits += 1
      print("OUT " + plate + " " + fmt_stay(d) + " fee " + fmt_money(f))
    else:
      print("occupied car " + str(occupied(names, occ, "C")) + "/" + str(c) + " moto " + str(occupied(names, occ, "M")) + "/" + str(m) + " van " + str(occupied(names, occ, "V")) + "/" + str(v) + " revenue " + fmt_money(revenue))
    last = t
  print("revenue " + fmt_money(revenue) + " from " + str(exits) + " exits")
## garage.bv
fn make_names(c: int, m: int, v: int) -> [str]:
  names = []
  for i in range(1, c + 1):
    names.push("C" + str(i))
  for i in range(1, m + 1):
    names.push("M" + str(i))
  for i in range(1, v + 1):
    names.push("V" + str(i))
  return names

fn lowest_free(names: [str], occ: [str], kind: str) -> int:
  for i in range(0, names.len()):
    if names[i].slice(0, 1) == kind and occ[i] == "":
      return i
  return -1

fn park(names: [str], mut occ: [str], plate: str, vtype: str) -> str:
  i = -1
  if vtype == "van":
    i = lowest_free(names, occ, "V")
  elif vtype == "car":
    i = lowest_free(names, occ, "C")
  else:
    i = lowest_free(names, occ, "M")
    if i < 0:
      i = lowest_free(names, occ, "C")
  if i < 0:
    return ""
  occ[i] = plate
  return names[i]

fn release(names: [str], mut occ: [str], space: str):
  i = names.index_of(space)
  if i >= 0:
    occ[i] = ""

fn occupied(names: [str], occ: [str], kind: str) -> int:
  n = 0
  for i in range(0, names.len()):
    if names[i].slice(0, 1) == kind and occ[i] != "":
      n += 1
  return n
## billing.bv
fn is_digits(s: str) -> bool:
  if s.is_empty():
    return false
  for c in s.chars():
    if not c.is_digit():
      return false
  return true

fn valid_date(s: str) -> bool:
  cs = s.chars()
  if cs.len() != 10 or cs[4] != "-" or cs[7] != "-":
    return false
  if not is_digits(s.slice(0, 4)) or not is_digits(s.slice(5, 7)) or not is_digits(s.slice(8, 10)):
    return false
  y = s.slice(0, 4).int()
  mo = s.slice(5, 7).int()
  dd = s.slice(8, 10).int()
  if mo < 1 or mo > 12 or dd < 1:
    return false
  leap = (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
  dim = 31
  if mo == 2:
    dim = 28
    if leap:
      dim = 29
  elif mo == 4 or mo == 6 or mo == 9 or mo == 11:
    dim = 30
  return dd <= dim

fn valid_time(s: str) -> bool:
  if s.len() != 5 or s.slice(2, 3) != ":":
    return false
  if not is_digits(s.slice(0, 2)) or not is_digits(s.slice(3, 5)):
    return false
  return s.slice(0, 2).int() <= 23 and s.slice(3, 5).int() <= 59

fn to_abs(day: str, clock: str) -> int:
  return date(day).days * 1440 + clock.slice(0, 2).int() * 60 + clock.slice(3, 5).int()

fn fee_cents(vtype: str, d: int) -> int:
  if d <= 15:
    return 0
  rate = 250
  cap = 2000
  if vtype == "moto":
    rate = 120
    cap = 800
  elif vtype == "van":
    rate = 400
    cap = 3000
  days = d // 1440
  rest = d % 1440
  hours = (rest + 59) // 60
  part = hours * rate
  if part > cap:
    part = cap
  return days * cap + part

fn pad2(n: int) -> str:
  if n < 10:
    return "0" + str(n)
  return str(n)

fn fmt_money(c: int) -> str:
  return str(c // 100) + "." + pad2(c % 100)

fn fmt_stay(d: int) -> str:
  return str(d // 60) + "h" + pad2(d % 60) + "m"
