fn whole(s: str) -> int:
  if s.is_empty():
    return -1
  if s.len() > 1 and s.slice(0, 1) == "0":
    return -1
  v = 0
  for c in s.chars():
    if not c.is_digit():
      return -1
    v = v * 10 + c.digit()
  return v

fn main():
  played = {}
  won = {}
  drawn = {}
  lost = {}
  gf = {}
  ga = {}
  pts = {}
  teams = []
  matches = []
  seen_pairs = {}
  n = 0
  for line in lines():
    n += 1
    w = line.words()
    if w.is_empty():
      continue
    if w.len() != 3:
      print("line {n}: bad line")
      continue
    sc = w[2].split("-")
    if sc.len() != 2:
      print("line {n}: bad line")
      continue
    hg = whole(sc[0])
    ag = whole(sc[1])
    if hg < 0 or ag < 0:
      print("line {n}: bad line")
      continue
    h = w[0]
    a = w[1]
    if h == a:
      print("line {n}: same team")
      continue
    if seen_pairs.has((h, a)):
      print("line {n}: already played")
      continue
    seen_pairs[(h, a)] = true
    matches.push((h, a, hg, ag))
    for t in [h, a]:
      if t not in teams:
        teams.push(t)
    played[h] += 1
    played[a] += 1
    gf[h] += hg
    ga[h] += ag
    gf[a] += ag
    ga[a] += hg
    if hg > ag:
      won[h] += 1
      lost[a] += 1
      pts[h] += 3
    elif hg < ag:
      won[a] += 1
      lost[h] += 1
      pts[a] += 3
    else:
      drawn[h] += 1
      drawn[a] += 1
      pts[h] += 1
      pts[a] += 1

  if matches.is_empty():
    print("no matches")
    return

  kstr = {}
  h2h = {}
  for t in teams:
    gdv = gf[t] - ga[t]
    kstr[t] = str(pts[t]) + "|" + str(gdv) + "|" + str(gf[t])
    h2h[t] = 0
  for m in matches:
    if kstr[m.0] == kstr[m.1]:
      if m.2 > m.3:
        h2h[m.0] += 3
      elif m.2 < m.3:
        h2h[m.1] += 3
      else:
        h2h[m.0] += 1
        h2h[m.1] += 1

  rows = []
  for t in teams:
    gdv = gf[t] - ga[t]
    rows.push((-pts[t], -gdv, -gf[t], -h2h[t], t))
  order = sorted(rows)

  print("Pos Team P W D L GF GA GD Pts")
  pos = 0
  bg_team = ""
  bg = -1
  bd_team = ""
  bd = -1
  for r in order:
    t = r.4
    pos += 1
    p = played[t]
    wn = won[t]
    dr = drawn[t]
    ls = lost[t]
    gfv = gf[t]
    gav = ga[t]
    gdv = gfv - gav
    gds = str(gdv)
    if gdv > 0:
      gds = "+" + gds
    pv = pts[t]
    print("{pos} {t} {p} {wn} {dr} {ls} {gfv} {gav} {gds} {pv}")
    if bg < 0 or gfv > bg:
      bg = gfv
      bg_team = t
    if bd < 0 or gav < bd:
      bd = gav
      bd_team = t
  print("most goals: {bg_team} ({bg})")
  print("best defence: {bd_team} ({bd})")
