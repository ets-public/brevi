owners = []
bals = []
fn acct(i: int) -> str = str({"id": i, "owner": owners[i - 1], "balance": bals[i - 1]})
fn exists(i: int) -> bool = i >= 1 and i <= owners.len()
fn amt(j: Json) -> int = match j["amount"]:
  Num(n) => if n > 0.0 and n == n.floor(): n.int() else: -1
  _ => -1
fn idof(j: Json, k: str) -> int = match j[k]:
  Num(n) => n.int()
  _ => -1
fn ownerof(j: Json) -> str = match j["owner"]:
  Str(s) => s
  _ => ""
fn handle(method: str, path: str, body: str) -> str:
  seg = path.split("/")
  kind = ""
  id = 0
  if seg.len() >= 2 and seg[0] == "" and seg[1] == "accounts":
    if seg.len() == 2:
      kind = if method == "POST": "create" elif method == "GET": "list" else: ""
    elif seg.len() == 3 and seg[2].is_digit():
      id = seg[2].int()
      kind = if method == "GET": "get" else: ""
    elif seg.len() == 4 and seg[2].is_digit() and method == "POST":
      id = seg[2].int()
      kind = if seg[3] == "deposit": "deposit" elif seg[3] == "withdraw": "withdraw" else: ""
  elif path == "/transfer" and method == "POST":
    kind = "transfer"
  if kind == "":
    return "404 {\"error\":\"not found\"}"
  if kind == "list":
    ids = (1..owners.len() + 1).map(i => i).sort_by(i => (-bals[i - 1], i))
    return "200 [" + ", ".join([acct(i) for i in ids]).replace(", ", ",") + "]"
  if kind == "get":
    if not exists(id): return "404 {\"error\":\"no such account\"}"
    return "200 " + acct(id)
  j = Null
  match json(body):
    Ok(v) => j = v
    Err(m) => return "400 {\"error\":\"bad json\"}"
  if kind == "create":
    o = ownerof(j)
    if o == "": return "400 {\"error\":\"owner required\"}"
    owners.push(o)
    bals.push(0)
    return "201 " + acct(owners.len())
  if kind == "transfer":
    f = idof(j, "from")
    t = idof(j, "to")
    if not exists(f) or not exists(t): return "404 {\"error\":\"no such account\"}"
    if f == t: return "400 {\"error\":\"same account\"}"
    a = amt(j)
    if a < 0: return "400 {\"error\":\"bad amount\"}"
    if a > bals[f - 1]: return "409 {\"error\":\"insufficient funds\"}"
    bals[f - 1] -= a
    bals[t - 1] += a
    return "200 {\"from\":{bals[f - 1]},\"to\":{bals[t - 1]}}"
  if not exists(id): return "404 {\"error\":\"no such account\"}"
  a = amt(j)
  if a < 0: return "400 {\"error\":\"bad amount\"}"
  if kind == "withdraw":
    if a > bals[id - 1]: return "409 {\"error\":\"insufficient funds\"}"
    bals[id - 1] -= a
  else:
    bals[id - 1] += a
  "200 " + acct(id)
for line in lines():
  m = line.trim().re_full("(\S+) (\S+)(?: (.*))?")
  if m.is_empty(): continue
  print(handle(m[1], m[2], m[3]))
