fn main():
  ls = lines()
  hdr = ls[0].words()
  nr = hdr[0].int()
  nc = hdr[1].int()
  g = []
  for i in 0..nr:
    g.push([w.int() for w in ls[i + 1].words()])
  top = 0
  bot = nr - 1
  left = 0
  right = nc - 1
  out = []
  while top <= bot and left <= right:
    for j in left..right + 1:
      out.push(g[top][j])
    top += 1
    for i in top..bot + 1:
      out.push(g[i][right])
    right -= 1
    if top <= bot:
      j = right
      while j >= left:
        out.push(g[bot][j])
        j -= 1
      bot -= 1
    if left <= right:
      i = bot
      while i >= top:
        out.push(g[i][left])
        i -= 1
      left += 1
  print(out.join(" "))
  sums = []
  for j in 0..nc:
    s = 0
    for i in 0..nr:
      s += g[i][j]
    sums.push(s)
  print(sums.join(" "))
