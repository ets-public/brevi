fn is_red(j: Json) -> bool = match j:
  Str(s) => s == "red"
  _ => false

fn total(j: Json) -> f64:
  match j:
    Num(n) => n
    Arr(xs) =>
      s = 0.0
      for x in xs:
        s += total(x)
      s
    Obj(m) =>
      for v in m.values():
        if is_red(v):
          return 0.0
      s = 0.0
      for v in m.values():
        s += total(v)
      s
    _ => 0.0

fn main():
  doc = json(stdin())
  print(total(doc).int())
