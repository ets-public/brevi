fn check(line: str) -> str:
  stack: [str] = []
  pos = 0
  for c in line.chars():
    pos += 1
    if c == "(" or c == "[" or c == "{":
      stack.push(c)
    elif c == ")" or c == "]" or c == "}":
      want = "{"
      if c == ")":
        want = "("
      elif c == "]":
        want = "["
      if stack.is_empty() or stack.last() != want:
        return "error at {pos}"
      stack.pop()
  if not stack.is_empty():
    n = line.len() + 1
    return "error at {n}"
  return "ok"

fn main():
  for line in lines():
    print(check(line))
