j = json(stdin())
prods = j["products"]
custs = j["customers"]
out = []
revenue = 0.dec()
for o in j["orders"]:
  idj = str(o["id"])
  cid = o["customer"].text()
  if not custs.has(cid):
    out.push('{"id":' + idj + ',"error":"unknown customer ' + cid + '"}')
    continue
  c = custs[cid]
  bad = ""
  for l in o["lines"]:
    sku = l["sku"].text()
    if bad.is_empty() and not prods.has(sku): bad = sku
  if not bad.is_empty():
    out.push('{"id":' + idj + ',"error":"unknown sku ' + bad + '"}')
    continue
  sub = 0.dec()
  units = {}
  amts = {}
  for l in o["lines"]:
    p = prods[l["sku"].text()]
    q = l["qty"].int()
    a = p["price"].text().dec() * q
    sub += a
    cat = p["category"].text()
    units[cat] += q
    amts[cat] += a
  disc = 0.dec()
  for cat, u in units.pairs():
    if u >= 3: disc += (amts[cat] * "0.05".dec()).round(2)
  tier = c["tier"].text()
  rate = if tier == "gold": "0.10".dec() else: (if tier == "silver": "0.05".dec() else: 0.dec())
  disc += ((sub - disc) * rate).round(2)
  country = c["country"].text()
  trate = if country == "UK": "0.20".dec() else: (if country == "US": "0.0825".dec() else: 0.dec())
  tax = ((sub - disc) * trate).round(2)
  total = sub - disc + tax
  revenue += total
  out.push('{"id":' + idj + ',"customer":' + str(c["name"]) + ',"subtotal":"' + sub.fmt(2) + '","discount":"' + disc.fmt(2) + '","tax":"' + tax.fmt(2) + '","total":"' + total.fmt(2) + '"}')
print("[" + ",".join(out) + "]")
print("revenue " + revenue.fmt(2))
