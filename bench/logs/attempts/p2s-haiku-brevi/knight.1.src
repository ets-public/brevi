moves = [(1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1)]

fn knight_dist(n: int, a: str, b: str) -> int:
  sx = a.slice(0, 1).code() - 97
  sy = a.slice(1).int().or(1) - 1
  tx = b.slice(0, 1).code() - 97
  ty = b.slice(1).int().or(1) - 1
  start = (sx, sy)
  target = (tx, ty)
  dist = {}
  dist[start] = 0
  q = [start]
  i = 0
  while i < q.len():
    cur = q[i]
    i += 1
    if cur == target: return dist[cur]
    for m in moves:
      nx = cur.0 + m.0
      ny = cur.1 + m.1
      if nx >= 0 and nx < n and ny >= 0 and ny < n and not dist.has((nx, ny)):
        dist[(nx, ny)] = dist[cur] + 1
        q.push((nx, ny))
  return -1

ls = lines()
n = ls[0].trim().int().or(8)
for line in ls[1:]:
  p = line.words()
  if p.len() < 2: continue
  print(knight_dist(n, p[0], p[1]))
