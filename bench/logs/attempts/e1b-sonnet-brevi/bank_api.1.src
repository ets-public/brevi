owners = []
bals = []

fn acct(id: int) -> str = str({"id": id, "owner": owners[id - 1], "balance": bals[id - 1]})

fn amt(j: Json) -> int = match j["amount"]:
  Num(n) => if n > 0.0 and n == n.floor(): n.int() else: -1
  _ => -1

fn idof(j: Json) -> int = match j:
  Num(n) => n.int()
  _ => 0

fn isid(s: str) -> bool = not s.is_empty() and s.is_digit()

fn parse(b: str) -> (bool, Json):
  if b.is_empty(): return (true, json("{}"))
  match json(b):
    Ok(v) => (true, v)
    Err(m) => (false, json("{}"))

fn handle(line: str) -> str:
  sp = line.find(" ")
  method = line
  rest = ""
  if sp >= 0:
    method = line.slice(0, sp)
    rest = line.slice(sp + 1).trim()
  sp2 = rest.find(" ")
  path = rest
  body = ""
  if sp2 >= 0:
    path = rest.slice(0, sp2)
    body = rest.slice(sp2 + 1).trim()
  parts = path.split("/")
  n = parts.len()
  nf = "404 {\"error\":\"not found\"}"
  if parts[0] != "" or n < 2 or parts[1] != "accounts" and parts[1] != "transfer": return nf
  if method == "GET":
    if path == "/accounts":
      items = [(bals[i], i + 1) for i in 0..owners.len()]
      items = items.sort_by(p => (-p.0, p.1))
      return "200 [" + items.map(p => acct(p.1)).join(",") + "]"
    if n == 3 and parts[1] == "accounts" and isid(parts[2]):
      id = parts[2].int()
      if id < 1 or id > owners.len(): return "404 {\"error\":\"no such account\"}"
      return "200 " + acct(id)
    return nf
  if method != "POST": return nf
  if path == "/accounts":
    ok, j = parse(body)
    if not ok: return "400 {\"error\":\"bad json\"}"
    match j["owner"]:
      Str(s) =>
        if s.is_empty(): return "400 {\"error\":\"owner required\"}"
        owners.push(s)
        bals.push(0)
        return "201 " + acct(owners.len())
      _ => return "400 {\"error\":\"owner required\"}"
  if path == "/transfer":
    ok, j = parse(body)
    if not ok: return "400 {\"error\":\"bad json\"}"
    a = idof(j["from"])
    b = idof(j["to"])
    if a < 1 or a > owners.len() or b < 1 or b > owners.len(): return "404 {\"error\":\"no such account\"}"
    if a == b: return "400 {\"error\":\"same account\"}"
    m = amt(j)
    if m < 0: return "400 {\"error\":\"bad amount\"}"
    if m > bals[a - 1]: return "409 {\"error\":\"insufficient funds\"}"
    bals[a - 1] -= m
    bals[b - 1] += m
    return "200 " + str({"from": bals[a - 1], "to": bals[b - 1]})
  if n == 4 and parts[1] == "accounts" and isid(parts[2]) and (parts[3] == "deposit" or parts[3] == "withdraw"):
    ok, j = parse(body)
    if not ok: return "400 {\"error\":\"bad json\"}"
    id = parts[2].int()
    if id < 1 or id > owners.len(): return "404 {\"error\":\"no such account\"}"
    m = amt(j)
    if m < 0: return "400 {\"error\":\"bad amount\"}"
    if parts[3] == "deposit":
      bals[id - 1] += m
    else:
      if m > bals[id - 1]: return "409 {\"error\":\"insufficient funds\"}"
      bals[id - 1] -= m
    return "200 " + acct(id)
  nf

for line in lines():
  if line.trim().is_empty(): continue
  print(handle(line.trim()))
