type Lot:
  qty: int
  cost: dec

lots = {}
seen = {}
cogs = {}
rev = {}
loss = {}
mprofit = {}
mloss = {}
mhas = {}
last = ""
okc = 0

fn okdate(s: str) -> bool:
  if s.re_full("\d\d\d\d-\d\d-\d\d").is_empty(): return false
  match date(s):
    Ok(_) => true
    Err(_) => false

fn okqty(s: str) -> bool = not s.re_full("\d+").is_empty() and s.int().or(0) >= 1

fn okprice(s: str) -> bool = not s.re_full("\d+(\.\d{1,2})?").is_empty()

fn take(sku: str, q: int) -> dec:
  ls = lots[sku]
  left = q
  c = 0.dec()
  while left > 0:
    t = min(left, ls[0].qty)
    c += ls[0].cost * t
    left -= t
    ls[0].qty -= t
    if ls[0].qty == 0: ls.remove(0)
  lots[sku] = ls
  c

fn have(sku: str) -> int:
  h = 0
  for l in lots[sku]: h += l.qty
  h

fn run(line: str):
  w = line.words()
  n = w.len()
  if n < 4: fail("bad line")
  d = w[0]
  op = w[1]
  sku = w[2]
  if not okdate(d): fail("bad line")
  if op == "RECEIVE" and n == 5:
    if not okqty(w[3]) or not okprice(w[4]): fail("bad line")
  elif op == "SHIP" and n == 5:
    if not okqty(w[3]) or not okprice(w[4]): fail("bad line")
  elif op == "LOSS" and n == 4:
    if not okqty(w[3]): fail("bad line")
  else: fail("bad line")
  if d < last: fail("date out of order")
  q = w[3].int()
  m = d.slice(0, 7)
  if op == "RECEIVE":
    if not lots.has(sku): lots[sku] = []
    lots[sku].push(Lot(q, w[4].dec()))
    seen[sku] = 1
  else:
    h = have(sku)
    if q > h: fail("short {sku} need {q} have {h}")
    c = take(sku, q)
    mhas[m] = 1
    if op == "SHIP":
      r = w[4].dec() * q
      cogs[sku] += c
      rev[sku] += r
      mprofit[m] += r - c
    else:
      loss[sku] += c
      mloss[m] += c
  last = d

ln = 0
for line in lines():
  ln += 1
  if line.trim().is_empty(): continue
  match run(line):
    Ok(_) => okc += 1
    Err(e) => print("line {ln}: {e}")

tp = 0.dec()
tl = 0.dec()
for sku in seen.keys():
  v = 0.dec()
  for l in lots[sku]: v += l.cost * l.qty
  p = rev[sku] - cogs[sku]
  tp += p
  tl += loss[sku]
  print("{sku} on_hand {have(sku)} value {v.fmt(2)} cogs {cogs[sku].fmt(2)} revenue {rev[sku].fmt(2)} profit {p.fmt(2)} loss {loss[sku].fmt(2)}")
print("months")
for m in mhas.keys():
  print("  {m} profit {mprofit[m].fmt(2)} loss {mloss[m].fmt(2)}")
print("total profit {tp.fmt(2)} loss {tl.fmt(2)} net {(tp - tl).fmt(2)}")
