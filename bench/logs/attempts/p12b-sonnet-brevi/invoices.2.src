data = json(stdin())
prods = data["products"]
custs = data["customers"]
outs = []
revenue = 0.dec()
for o in data["orders"]:
  oid = o["id"].text()
  cid = o["customer"].text()
  if not custs.has(cid):
    outs.push('{"id":{str(oid.json())},"error":{str("unknown customer {cid}".json())}}')
    continue
  bad = ""
  for l in o["lines"]:
    sku = l["sku"].text()
    if bad.is_empty() and not prods.has(sku):
      bad = sku
  if not bad.is_empty():
    outs.push('{"id":{str(oid.json())},"error":{str("unknown sku {bad}".json())}}')
    continue
  cust = custs[cid]
  sub = 0.dec()
  units = {}
  amts = {}
  for l in o["lines"]:
    p = prods[l["sku"].text()]
    q = l["qty"].int()
    a = p["price"].text().dec() * q
    sub += a
    cat = p["category"].text()
    units[cat] += q
    amts[cat] += a
  disc = 0.dec()
  for cat, u in units.pairs():
    if u >= 3:
      disc += (amts[cat] * "0.05".dec()).round(2)
  tier = cust["tier"].text()
  rate = if tier == "gold": "0.10".dec() elif tier == "silver": "0.05".dec() else: 0.dec()
  disc += ((sub - disc) * rate).round(2)
  net = sub - disc
  country = cust["country"].text()
  trate = if country == "UK": "0.20".dec() elif country == "US": "0.0825".dec() else: 0.dec()
  tax = (net * trate).round(2)
  total = net + tax
  revenue += total
  outs.push('{"id":{str(oid.json())},"customer":{str(cust["name"].text().json())},"subtotal":"{sub.fmt(2)}","discount":"{disc.fmt(2)}","tax":"{tax.fmt(2)}","total":"{total.fmt(2)}"}')
print("[" + ",".join(outs) + "]")
print("revenue {revenue.fmt(2)}")
