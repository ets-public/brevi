requests = 0
malformed = 0
total = 0
ips = {}
classes = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  m = line.re_full('(\S+) - - \[([^\]]*)\] "(\S+) (\S+) (\S+)" (\d+) (\d+|-) "([^"]*)" "([^"]*)"')
  if m.is_empty():
    malformed += 1
    continue
  requests += 1
  ip = m[1]
  ts = m[2]
  path = m[4].split("?")[0]
  status = m[6].int()
  size = if m[7] == "-": 0 else: m[7].int()
  total += size
  ips[ip] = 1
  classes[status // 100] += 1
  paths[path] += 1
  hours[ts.slice(12, 14)] += 1
  if "bot" in m[9].lower():
    bots += 1
  if status >= 400:
    errs[ip] += 1
print("requests {requests}")
print("malformed {malformed}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for c, n in classes.pairs():
  print("  {c}xx {n}")
print("top_paths")
tp = paths.pairs().sort_by(p => (-p.1, p.0)).take(3)
for p, n in tp:
  print("  {n} {p}")
print("hours")
mx = hours.values().max().or(1)
for h, n in hours.pairs():
  k = max(1, (n * 40 + mx) // (2 * mx))
  print("  {h} {n} {"#".repeat(k)}")
print("bots {bots}")
print("errors_by_ip")
ep = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for ip, n in ep:
  print("  {ip} {n}")
