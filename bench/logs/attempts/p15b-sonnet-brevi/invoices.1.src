data = json(stdin())
prods = data["products"]
custs = data["customers"]
revenue = 0.dec()
outs = []
for o in data["orders"]:
  oid = str(o["id"])
  cid = o["customer"].text()
  if not custs.has(cid):
    outs.push('{"id":' + oid + ',"error":"unknown customer ' + cid + '"}')
    continue
  bad = ""
  for l in o["lines"]:
    sku = l["sku"].text()
    if bad.is_empty() and not prods.has(sku):
      bad = sku
  if not bad.is_empty():
    outs.push('{"id":' + oid + ',"error":"unknown sku ' + bad + '"}')
    continue
  c = custs[cid]
  sub = 0.dec()
  units = {}
  amounts = {}
  for l in o["lines"]:
    p = prods[l["sku"].text()]
    q = l["qty"].int()
    a = p["price"].text().dec() * q
    sub += a
    cat = p["category"].text()
    units[cat] += q
    amounts[cat] += a
  disc = 0.dec()
  for cat, u in units.pairs():
    if u >= 3:
      disc += (amounts[cat] * "0.05".dec()).round(2)
  tier = c["tier"].text()
  rate = "0".dec()
  if tier == "gold":
    rate = "0.10".dec()
  elif tier == "silver":
    rate = "0.05".dec()
  disc += ((sub - disc) * rate).round(2)
  net = sub - disc
  country = c["country"].text()
  trate = "0".dec()
  if country == "UK":
    trate = "0.20".dec()
  elif country == "US":
    trate = "0.0825".dec()
  tax = (net * trate).round(2)
  total = net + tax
  revenue += total
  outs.push('{"id":' + oid + ',"customer":' + str(c["name"]) + ',"subtotal":"' + sub.fmt(2) + '","discount":"' + disc.fmt(2) + '","tax":"' + tax.fmt(2) + '","total":"' + total.fmt(2) + '"}')
print("[" + ",".join(outs) + "]")
print("revenue {revenue.fmt(2)}")
