requests = 0
malformed = 0
total = 0
ips = {}
classes = {}
paths = {}
hours = {}
bots = 0
errs = {}
for line in lines():
  if line.trim().is_empty():
    continue
  g = line.re_full('(\S+) - - \[([^\]]*)\] "(\S+) (\S+) (\S+)" (\d{3}) (\d+|-) "([^"]*)" "([^"]*)"')
  if g.is_empty():
    malformed += 1
    continue
  requests += 1
  ip = g[1]
  ips[ip] = 1
  path = g[4].split("?")[0]
  paths[path] += 1
  status = g[6].int()
  classes[status // 100] += 1
  if g[7] != "-":
    total += g[7].int()
  hh = g[2].split(":")[1]
  hours[hh] += 1
  if "bot" in g[9].lower():
    bots += 1
  if status >= 400:
    errs[ip] += 1
print("requests {requests}")
print("malformed {malformed}")
print("bytes {total}")
print("unique_ips {ips.len()}")
print("status")
for c in 2..6:
  if classes.has(c):
    print("  {c}xx {classes[c]}")
print("top_paths")
tp = paths.pairs().sort_by(p => (-p.1, p.0)).take(3)
for p in tp:
  print("  {p.1} {p.0}")
print("hours")
mx = 0
for h, n in hours.pairs():
  if n > mx:
    mx = n
for h, n in hours.pairs():
  bar = (n * 40 + mx) // (2 * mx)
  if bar < 1:
    bar = 1
  print("  {h} {n} {"#".repeat(bar)}")
print("bots {bots}")
print("errors_by_ip")
ep = errs.pairs().filter(p => p.1 >= 2).sort_by(p => (-p.1, p.0))
for p in ep:
  print("  {p.0} {p.1}")
