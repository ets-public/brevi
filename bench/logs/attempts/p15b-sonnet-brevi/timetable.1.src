fn tmin(s: str) -> int:
  p = s.split(":")
  p[0].int() * 60 + p[1].int()

fn hhmm(m: int) -> str:
  h = ("0" + str(m // 60)).slice(-2)
  mm = ("0" + str(m % 60)).slice(-2)
  h + ":" + mm

names = []
sts = []
tms = []
queries = []
second = false
for line in lines():
  w = line.words()
  if line.trim() == "---":
    second = true
    continue
  if w.is_empty():
    continue
  if second:
    queries.push(w)
  else:
    names.push(w[0])
    ss = []
    tt = []
    for x in 0..(w.len() - 1) // 2:
      ss.push(w[1 + 2 * x])
      tt.push(tmin(w[2 + 2 * x]))
    sts.push(ss)
    tms.push(tt)

for q in queries:
  src = q[0]
  dst = q[1]
  qt = tmin(q[2])
  if src == dst:
    print("{src} {dst} {q[2]} via -")
    continue
  best = {}
  changed = true
  while changed:
    changed = false
    for ti in 0..names.len():
      st = sts[ti]
      tm = tms[ti]
      nm = names[ti]
      for k in 0..st.len() - 1:
        s = st[k]
        d = tm[k]
        cands = []
        if s == src and qt <= d:
          cands.push((1, nm))
        if best.has(s) and best[s].0 + 5 <= d:
          b = best[s]
          cands.push((b.1 + 1, b.2 + ">" + nm))
        for c in cands:
          for j in k + 1..st.len():
            key = (tm[j], c.0, c.1)
            if not best.has(st[j]) or key < best[st[j]]:
              best[st[j]] = key
              changed = true
  if best.has(dst):
    b = best[dst]
    print("{src} {dst} {hhmm(b.0)} via {b.2}")
  else:
    print("{src} {dst} unreachable")
