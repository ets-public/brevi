rows = [l.words() for l in lines()]
rows = [r for r in rows if r.len() > 0]
q = rows[rows.len() - 1]
src = q[0]
dst = q[1]
adj = {}
for r in rows.slice(0, rows.len() - 1):
  a = r[0]
  b = r[1]
  w = r[2].int().or(0)
  adj[a].push((b, w))
  adj[b].push((a, w))

dist = {}
dist[dst] = 0
h = heap()
h.push((0, dst))
while not h.is_empty():
  it = h.pop()
  d = it.0
  u = it.1
  if d > dist[u]:
    continue
  for e in adj[u]:
    nd = d + e.1
    if not dist.has(e.0) or nd < dist[e.0]:
      dist[e.0] = nd
      h.push((nd, e.0))

if not dist.has(src):
  print("none")
else:
  path = [src]
  cur = src
  while cur != dst:
    best = ""
    for e in adj[cur]:
      v = e.0
      if dist.has(v) and e.1 + dist[v] == dist[cur]:
        if best == "" or v < best:
          best = v
    cur = best
    path.push(cur)
  print(str(dist[src]))
  print(path.join("->"))
