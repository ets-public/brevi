fn is_red(j: Json) -> bool = match j:
  Str(s) => s == "red"
  _ => false

fn total(j: Json) -> int = match j:
  Num(n) => n.int()
  Arr(xs) => xs.fold(0, (a, x) => a + total(x))
  Obj(m) =>
    if m.values().any(v => is_red(v)):
      0
    else:
      m.values().fold(0, (a, v) => a + total(v))
  _ => 0

print(str(total(json(stdin()))))
