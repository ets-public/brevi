## main.bv
use "graph.bv"
use "schedule.bv"

fn run(ls: [str]) -> [str]:
  (k, tasks) = parse_all(ls)
  g = build(tasks)
  out = ["unlimited"]
  (st, en) = unlimited(g)
  for u in 0..tasks.len():
    out.push("  {tasks[u].name} {st[u]}-{en[u]}")
  out.push("length {max_end(en)}")
  out.push("critical {critical(g, st, en)}")
  out.push("workers {k}")
  (s2, e2) = schedule(g, k)
  for u in 0..tasks.len():
    out.push("  {tasks[u].name} {s2[u]}-{e2[u]}")
  out.push("length {max_end(e2)}")
  return out

match run(lines()):
  Ok(v) =>
    for x in v: print(x)
  Err(m) => print(m)
## graph.bv
type Task:
  name: str
  days: int
  deps: [str]

type Graph:
  tasks: [Task]
  idx: {str: int}
  didx: [[int]]
  succ: [[int]]
  order: [int]

fn all_digits(s: str) -> bool:
  if s.is_empty(): return false
  for c in s.chars():
    if not c.is_digit(): return false
  return true

fn is_name(s: str) -> bool:
  if s.is_empty(): return false
  for c in s.chars():
    if not (c.is_alpha() or c.is_digit() or c == "_"): return false
  return true

# a task from the words of a line; the name is "" when the line is not a task
fn task_of(t: [str]) -> Task:
  bad = Task(name: "", days: 0, deps: [])
  if t.len() < 2: return bad
  if not is_name(t[0]) or not all_digits(t[1]): return bad
  days = t[1].int().or(0)
  if days < 1: return bad
  if t.len() == 2: return Task(name: t[0], days: days, deps: [])
  if t[2] != "after" or t.len() < 4: return bad
  deps = []
  for part in t[3:].join(" ").split(","):
    d = part.trim()
    if not is_name(d): return bad
    deps.push(d)
  return Task(name: t[0], days: days, deps: deps)

fn parse_all(ls: [str]) -> (int, [Task]):
  k = 0
  have_k = false
  tasks = []
  seen = {}
  for i in 0..ls.len():
    t = ls[i].words()
    if t.is_empty(): continue
    n = i + 1
    if not have_k:
      if t.len() != 2 or t[0] != "workers" or not all_digits(t[1]) or t[1].int().or(0) < 1:
        fail("line {n}: bad line")
      k = t[1].int().or(0)
      have_k = true
    else:
      tk = task_of(t)
      if tk.name == "": fail("line {n}: bad line")
      if seen.has(tk.name): fail("line {n}: duplicate {tk.name}")
      seen[tk.name] = true
      tasks.push(tk)
  if not have_k: fail("line 1: bad line")
  return (k, tasks)

fn build(tasks: [Task]) -> Graph:
  n = tasks.len()
  idx = {}
  for i in 0..n:
    idx[tasks[i].name] = i
  for i in 0..n:
    for d in tasks[i].deps:
      if not idx.has(d): fail("unknown {d}")
  didx = []
  succ = []
  indeg = []
  for i in 0..n:
    succ.push([])
    didx.push([])
    indeg.push(tasks[i].deps.len())
  for i in 0..n:
    for d in tasks[i].deps:
      didx[i].push(idx[d])
      succ[idx[d]].push(i)
  queue = []
  for i in 0..n:
    if indeg[i] == 0: queue.push(i)
  order = []
  h = 0
  while h < queue.len():
    u = queue[h]
    h += 1
    order.push(u)
    for v in succ[u]:
      indeg[v] -= 1
      if indeg[v] == 0: queue.push(v)
  if order.len() < n: fail("cycle")
  return Graph(tasks: tasks, idx: idx, didx: didx, succ: succ, order: order)

fn max_end(ends: [int]) -> int:
  m = 0
  for e in ends:
    if e > m: m = e
  return m

# earliest start and end of each task with no limit on workers
fn unlimited(g: Graph) -> ([int], [int]):
  n = g.tasks.len()
  starts = [0].repeat(n)
  ends = [0].repeat(n)
  for u in g.order:
    st = 0
    for d in g.didx[u]:
      if ends[d] > st: st = ends[d]
    starts[u] = st
    ends[u] = st + g.tasks[u].days
  return (starts, ends)

# a longest chain of tight dependencies from a task starting at 0 to one ending at the length
fn critical(g: Graph, starts: [int], ends: [int]) -> str:
  n = g.tasks.len()
  L = max_end(ends)
  on = [false].repeat(n)
  for j in 0..n:
    u = g.order[n - 1 - j]
    if ends[u] == L:
      on[u] = true
    else:
      for v in g.succ[u]:
        if on[v] and starts[v] == ends[u]: on[u] = true
  cur = -1
  for u in 0..n:
    if cur < 0 and starts[u] == 0 and on[u]: cur = u
  if cur < 0: return "-"
  names = [g.tasks[cur].name]
  while ends[cur] != L:
    nxt = -1
    for v in g.succ[cur]:
      if nxt < 0 and on[v] and starts[v] == ends[cur]: nxt = v
    cur = nxt
    names.push(g.tasks[cur].name)
  return names.join(" > ")
## schedule.bv
use "graph.bv"

# longest tail of each task: its days plus the largest tail among the tasks that depend on it
fn tails(g: Graph) -> [int]:
  n = g.tasks.len()
  tl = [0].repeat(n)
  for j in 0..n:
    u = g.order[n - 1 - j]
    best = 0
    for v in g.succ[u]:
      if tl[v] > best: best = tl[v]
    tl[u] = g.tasks[u].days + best
  return tl

fn ready_at(g: Graph, u: int, done: [bool]) -> bool:
  for d in g.didx[u]:
    if not done[d]: return false
  return true

fn schedule(g: Graph, k: int) -> ([int], [int]):
  n = g.tasks.len()
  tl = tails(g)
  starts = [-1].repeat(n)
  ends = [0].repeat(n)
  done = [false].repeat(n)
  running = []
  t = 0
  while True:
    nr = []
    for u in running:
      if ends[u] == t:
        done[u] = true
      else:
        nr.push(u)
    running = nr
    while running.len() < k:
      best = -1
      for u in 0..n:
        if starts[u] < 0 and ready_at(g, u, done):
          if best < 0 or tl[u] > tl[best]: best = u
      if best < 0: break
      starts[best] = t
      ends[best] = t + g.tasks[best].days
      running.push(best)
    if running.is_empty(): break
    nt = ends[running[0]]
    for u in running:
      if ends[u] < nt: nt = ends[u]
    t = nt
  return (starts, ends)
