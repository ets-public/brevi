adj = {}
ls = lines()
last = []
for l in ls:
  w = l.words()
  if w.len() == 3:
    adj[w[0]].push((w[1], w[2].int()))
    adj[w[1]].push((w[0], w[2].int()))
  elif w.len() == 2:
    last = w
src = last[0]
dst = last[1]
dist = {}
h = heap()
h.push((0, dst))
dist[dst] = 0
done = {}
while h:
  let (d, u) = h.pop()
  if done.has(u): continue
  done[u] = true
  for e in adj[u]:
    nd = d + e.1
    if not dist.has(e.0) or nd < dist[e.0]:
      dist[e.0] = nd
      h.push((nd, e.0))
if not dist.has(src):
  print("none")
else:
  print(dist[src])
  path = [src]
  cur = src
  while cur != dst:
    best = ""
    for e in adj[cur]:
      if dist.has(e.0) and e.1 + dist[e.0] == dist[cur]:
        if best == "" or e.0 < best: best = e.0
    path.push(best)
    cur = best
  print(path.join("->"))
