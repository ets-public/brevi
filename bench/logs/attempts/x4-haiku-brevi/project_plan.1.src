## main.bv
use "graph.bv"
use "schedule.bv"

fn header_k(line: str) -> int:
  tk = line.words()
  if tk.len() != 2 or tk[0] != "workers": return 0
  if not is_int(tk[1]): return 0
  tk[1].int().or(0)

fn main():
  seen = {}
  tasks = []
  k = 0
  have_header = False
  lineno = 0
  for raw in lines():
    lineno += 1
    line = raw.trim()
    if line.is_empty(): continue
    if not have_header:
      have_header = True
      k = header_k(line)
      if k < 1:
        print("line {lineno}: bad line")
        return
      continue
    t = parse_task(line)
    if t.name == "":
      print("line {lineno}: bad line")
      return
    if seen.has(t.name):
      print("line {lineno}: duplicate {t.name}")
      return
    seen[t.name] = 1
    tasks.push(t)
  if not have_header:
    print("line 1: bad line")
    return
  n = tasks.len()
  for t in tasks:
    for d in t.deps:
      if not seen.has(d):
        print("unknown {d}")
        return
  idx = {}
  names = []
  days = []
  for i in 0..n:
    idx[tasks[i].name] = i
    names.push(tasks[i].name)
    days.push(tasks[i].days)
  dep = []
  for t in tasks:
    dl = []
    for d in t.deps:
      dl.push(idx[d])
    dep.push(dl)
  st, en, ok = unlimited(dep, days)
  if not ok:
    print("cycle")
    return
  L = 0
  for i in 0..n:
    if en[i] > L: L = en[i]
  print("unlimited")
  for i in 0..n:
    print("  {names[i]} {st[i]}-{en[i]}")
  print("length {L}")
  chain = critical(dep, st, en, L)
  cn = []
  for i in chain:
    cn.push(names[i])
  print("critical " + " > ".join(cn))
  s2, e2 = plan(k, dep, days)
  L2 = 0
  for i in 0..n:
    if e2[i] > L2: L2 = e2[i]
  print("workers {k}")
  for i in 0..n:
    print("  {names[i]} {s2[i]}-{e2[i]}")
  print("length {L2}")

main()
## graph.bv
type Task:
  name: str
  days: int
  deps: [str]

fn is_int(s: str) -> bool:
  if s.is_empty(): return False
  for c in s.chars():
    if not c.is_digit(): return False
  True

fn is_name(s: str) -> bool:
  if s.is_empty(): return False
  for c in s.chars():
    if not (c.is_alpha() or c.is_digit() or c == "_"): return False
  True

fn parse_task(line: str) -> Task:
  tk = line.words()
  bad = Task(name: "", days: 0, deps: [])
  if tk.len() < 2: return bad
  if not is_name(tk[0]) or not is_int(tk[1]) or tk[1].int().or(0) < 1: return bad
  d = tk[1].int().or(0)
  if tk.len() == 2: return Task(name: tk[0], days: d, deps: [])
  if tk[2] != "after" or tk.len() < 4: return bad
  rest = " ".join(tk[3:])
  deps = []
  for p in rest.split(","):
    nm = p.trim()
    if not is_name(nm): return bad
    deps.push(nm)
  Task(name: tk[0], days: d, deps: deps)

fn unlimited(dep: [[int]], days: [int]) -> ([int], [int], bool):
  n = days.len()
  st = []
  en = []
  res = []
  for i in 0..n:
    st.push(0)
    en.push(0)
    res.push(False)
  for pass in 0..n:
    for i in 0..n:
      if not res[i]:
        ok = True
        best = 0
        for d in dep[i]:
          if not res[d]:
            ok = False
          elif en[d] > best:
            best = en[d]
        if ok:
          st[i] = best
          en[i] = best + days[i]
          res[i] = True
  allok = True
  for i in 0..n:
    if not res[i]: allok = False
  (st, en, allok)

fn critical(dep: [[int]], st: [int], en: [int], L: int) -> [int]:
  n = st.len()
  crit = []
  for i in 0..n:
    crit.push(en[i] == L)
  for pass in 0..n:
    for v in 0..n:
      if not crit[v]:
        for w in 0..n:
          if crit[w] and st[w] == en[v] and dep[w].contains(v):
            crit[v] = True
  chain = []
  cur = -1
  for i in 0..n:
    if cur < 0 and st[i] == 0 and crit[i]: cur = i
  if cur < 0: return chain
  chain.push(cur)
  while en[cur] != L:
    nxt = -1
    for w in 0..n:
      if nxt < 0 and crit[w] and st[w] == en[cur] and dep[w].contains(cur): nxt = w
    if nxt < 0: break
    cur = nxt
    chain.push(cur)
  chain
## schedule.bv
fn tails(dep: [[int]], days: [int]) -> [int]:
  n = days.len()
  tl = []
  for i in 0..n:
    tl.push(days[i])
  for pass in 0..n:
    for i in 0..n:
      best = 0
      for j in 0..n:
        if dep[j].contains(i) and tl[j] > best: best = tl[j]
      tl[i] = days[i] + best
  tl

fn ready(dep: [[int]], fin: [bool], i: int) -> bool:
  for d in dep[i]:
    if not fin[d]: return False
  True

fn plan(k: int, dep: [[int]], days: [int]) -> ([int], [int]):
  n = days.len()
  tl = tails(dep, days)
  st = []
  en = []
  fin = []
  for i in 0..n:
    st.push(-1)
    en.push(-1)
    fin.push(False)
  busy = 0
  remaining = n
  t = 0
  while remaining > 0:
    for i in 0..n:
      if st[i] >= 0 and not fin[i] and en[i] == t:
        fin[i] = True
        busy -= 1
        remaining -= 1
    more = True
    while more and busy < k:
      best = -1
      for i in 0..n:
        if st[i] < 0 and ready(dep, fin, i) and (best < 0 or tl[i] > tl[best]):
          best = i
      if best < 0:
        more = False
      else:
        st[best] = t
        en[best] = t + days[best]
        busy += 1
    t += 1
  (st, en)
