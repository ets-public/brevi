for line in lines():
  stack = []
  err = 0
  pos = 0
  for ch in line.chars():
    pos += 1
    if ch == "(" or ch == "[" or ch == "{":
      stack.push(ch)
    elif ch == ")" or ch == "]" or ch == "}":
      want = "("
      if ch == "]": want = "["
      if ch == "}": want = "{"
      if stack.is_empty() or stack.last() != want:
        err = pos
        break
      stack.pop()
  if err > 0:
    print("error at {err}")
  elif not stack.is_empty():
    print("error at {line.len() + 1}")
  else:
    print("ok")
