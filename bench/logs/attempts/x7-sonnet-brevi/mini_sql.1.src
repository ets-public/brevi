tcols = {}
ttypes = {}
trows = {}
tk = []
p = 0

fn tokenize(line: str) -> [str]:
  ts = line.re_list("'(?:[^']|'')*'|-?\d+|\w+|!=|<=|>=|[=<>(),*]")
  if ts.join("").replace(" ", "") != line.replace(" ", ""): return ["#bad"]
  ts

fn peek() -> str = if p < tk.len(): tk[p] else: ""
fn adv() -> str:
  t = peek()
  p += 1
  t
fn expect(s: str):
  if peek() != s: fail("error: syntax")
  p += 1
fn done():
  if p < tk.len(): fail("error: syntax")
fn ident() -> str:
  t = adv()
  if t.re_full("[A-Za-z]\w*").len() == 0: fail("error: syntax")
  t
fn is_text(t: str) -> bool = t.starts_with("'")
fn value() -> str:
  t = adv()
  if not (t.starts_with("'") or t.re_full("-?\d+").len() > 0): fail("error: syntax")
  t
fn decode(t: str) -> str = if is_text(t): t.slice(1, -1).replace("''", "'") else: t
fn conds() -> [(str, str, str)]:
  cs = []
  while true:
    c = ident()
    op = adv()
    if op not in ["=", "!=", "<", ">", "<=", ">="]: fail("error: syntax")
    v = value()
    cs.push((c, op, v))
    if peek() == "AND":
      p += 1
    else:
      break
  cs
fn opt_where() -> [(str, str, str)]:
  cs: [(str, str, str)] = []
  if peek() == "WHERE":
    p += 1
    cs = conds()
  cs

fn colidx(t: str, c: str) -> int = tcols[t].index_of(c)
fn need_table(t: str):
  if not tcols.has(t): fail("error: no table {t}")
fn need_col(t: str, c: str):
  if colidx(t, c) < 0: fail("error: no column {c}")
fn tycheck(t: str, c: str, tok: str):
  ty = ttypes[t][colidx(t, c)]
  if (ty == "TEXT") != is_text(tok): fail("error: type mismatch")
fn check_conds(t: str, cs: [(str, str, str)]):
  for c in cs: need_col(t, c.0)
  for c in cs: tycheck(t, c.0, c.2)

fn cmp(a: str, b: str, ty: str, op: str) -> bool:
  c = 0
  if ty == "INT":
    c = if a.int() < b.int(): -1 else: (if a.int() > b.int(): 1 else: 0)
  else:
    c = if a < b: -1 else: (if a > b: 1 else: 0)
  match op:
    "=" => c == 0
    "!=" => c != 0
    "<" => c < 0
    ">" => c > 0
    "<=" => c <= 0
    _ => c >= 0

fn matches(t: str, cs: [(str, str, str)], row: [str]) -> bool:
  for c in cs:
    i = colidx(t, c.0)
    if not cmp(row[i], decode(c.2), ttypes[t][i], c.1): return false
  true

fn run() -> int:
  w = adv()
  if w == "CREATE":
    expect("TABLE")
    t = ident()
    expect("(")
    names = []
    types = []
    while true:
      names.push(ident())
      ty = adv()
      if ty != "INT" and ty != "TEXT": fail("error: syntax")
      types.push(ty)
      if peek() == ",":
        p += 1
      else:
        break
    expect(")")
    done()
    if tcols.has(t): fail("error: table {t} exists")
    tcols[t] = names
    ttypes[t] = types
    trows[t] = []
    print("ok")
  elif w == "INSERT":
    expect("INTO")
    t = ident()
    expect("VALUES")
    expect("(")
    vals = []
    while true:
      vals.push(value())
      if peek() == ",":
        p += 1
      else:
        break
    expect(")")
    done()
    need_table(t)
    if vals.len() != tcols[t].len(): fail("error: type mismatch")
    for i in 0..vals.len(): tycheck(t, tcols[t][i], vals[i])
    trows[t].push(vals.map(decode))
    print("ok")
  elif w == "SELECT":
    cnt = false
    star = false
    cols = []
    if peek() == "COUNT":
      p += 1
      expect("(")
      expect("*")
      expect(")")
      cnt = true
    elif peek() == "*":
      p += 1
      star = true
    else:
      while true:
        cols.push(ident())
        if peek() == ",":
          p += 1
        else:
          break
    expect("FROM")
    t = ident()
    cs = opt_where()
    ob = ""
    desc = false
    lim = -1
    if not cnt:
      if peek() == "ORDER":
        p += 1
        expect("BY")
        ob = ident()
        if peek() == "DESC":
          p += 1
          desc = true
      if peek() == "LIMIT":
        p += 1
        l = adv()
        if l.re_full("\d+").len() == 0: fail("error: syntax")
        lim = l.int()
    done()
    need_table(t)
    for c in cols: need_col(t, c)
    for c in cs: need_col(t, c.0)
    if ob != "": need_col(t, ob)
    check_conds(t, cs)
    rows = [r for r in trows[t] if matches(t, cs, r)]
    if cnt:
      print("{rows.len()}")
    else:
      if star: cols = tcols[t]
      if ob != "":
        oi = colidx(t, ob)
        if ttypes[t][oi] == "INT":
          rows = rows.sort_by(r => r[oi].int(), desc)
        else:
          rows = rows.sort_by(r => r[oi], desc)
      if lim >= 0: rows = rows.take(lim)
      print(cols.join(" | "))
      idxs = [colidx(t, c) for c in cols]
      for r in rows: print(idxs.map(i => r[i]).join(" | "))
      print("({rows.len()} rows)")
  elif w == "UPDATE":
    t = ident()
    expect("SET")
    c = ident()
    expect("=")
    v = value()
    cs = opt_where()
    done()
    need_table(t)
    need_col(t, c)
    for x in cs: need_col(t, x.0)
    tycheck(t, c, v)
    check_conds(t, cs)
    ci = colidx(t, c)
    n = 0
    out = []
    for r in trows[t]:
      if matches(t, cs, r):
        r2 = r
        r2[ci] = decode(v)
        out.push(r2)
        n += 1
      else:
        out.push(r)
    trows[t] = out
    print("updated {n}")
  elif w == "DELETE":
    expect("FROM")
    t = ident()
    cs = opt_where()
    done()
    need_table(t)
    check_conds(t, cs)
    keep = [r for r in trows[t] if not matches(t, cs, r)]
    print("deleted {trows[t].len() - keep.len()}")
    trows[t] = keep
  else:
    fail("error: syntax")
  0

for line in lines():
  if line.trim().is_empty(): continue
  tk = tokenize(line)
  p = 0
  match run():
    Ok(v) => p = 0
    Err(m) => print(m)
