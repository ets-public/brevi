## main.bv
use "catalog.bv"
use "rules.bv"

lib = new_lib()
for line in lines():
  w = line.words()
  if w.is_empty(): continue
  if w.len() < 3: continue
  today = date(w[0]).days
  expire(lib, today)
  cmd = w[1]
  if cmd == "BOOK" and w.len() >= 5:
    if add_book(lib, w[2], w[3].int(), w.skip(4).join(" ")):
      print("added {w[2]}")
    else:
      print("duplicate ID")
  elif cmd == "MEMBER" and w.len() >= 5:
    if add_member(lib, w[2], w[3], w.skip(4).join(" ")):
      print("welcome {w.skip(4).join(" ")}")
    else:
      print("duplicate ID")
  elif cmd == "LOAN" and w.len() == 4: loan(lib, today, w[2], w[3])
  elif cmd == "RETURN" and w.len() == 4: giveback(lib, today, w[2], w[3])
  elif cmd == "RESERVE" and w.len() == 4: reserve(lib, w[2], w[3])
  elif cmd == "PAY" and w.len() == 4: pay(lib, w[2], w[3].dec())
  elif cmd == "STATUS" and w.len() == 3: status(lib, w[2])
## catalog.bv
type Book:
  title: str
  shelf: int
  waiting: [str]

type Member:
  name: str
  tier: str
  owes: dec
  loans: [str]
  dues: [int]

type Hold:
  member: str
  book: str
  last: int

type Lib:
  books: {str: Book}
  members: {str: Member}
  holds: [Hold]

fn new_lib() -> Lib = Lib(books: {}, members: {}, holds: [])

fn add_book(mut lib: Lib, id: str, copies: int, title: str) -> bool:
  if lib.books.has(id): return false
  lib.books[id] = Book(title, copies, [])
  true

fn add_member(mut lib: Lib, id: str, tier: str, name: str) -> bool:
  if lib.members.has(id): return false
  lib.members[id] = Member(name, tier, 0.dec(), [], [])
  true

fn tier_limit(t: str) -> int = if t == "plus": 5 else: 2
fn tier_days(t: str) -> int = if t == "plus": 28 else: 14
fn tier_rate(t: str) -> dec = if t == "plus": "0.10".dec() else: "0.25".dec()
## rules.bv
use "catalog.bv"

fn dstr(days: int) -> str = str(date("1970-01-01").add_days(days))

fn release(mut lib: Lib, book: str, start: int):
  bk = lib.books[book]
  if bk.waiting.is_empty():
    bk.shelf += 1
    lib.books[book] = bk
  else:
    m = bk.waiting.remove(0)
    lib.books[book] = bk
    lib.holds.push(Hold(m, book, start + 3))

fn expire(mut lib: Lib, today: int):
  while true:
    best = -1
    for i in 0..lib.holds.len():
      h = lib.holds[i]
      if h.last < today:
        if best < 0:
          best = i
        else:
          b = lib.holds[best]
          if h.last < b.last or (h.last == b.last and h.book < b.book): best = i
    if best < 0: break
    h2 = lib.holds[best]
    lib.holds.remove(best)
    print("hold expired {h2.member} {h2.book}")
    release(lib, h2.book, h2.last)

fn hold_index(lib: Lib, m: str, b: str) -> int:
  r = -1
  for i in 0..lib.holds.len():
    if lib.holds[i].member == m and lib.holds[i].book == b: r = i
  r

fn loan(mut lib: Lib, today: int, m: str, b: str):
  if not lib.members.has(m):
    print("refused {m} {b}: unknown member")
    return
  if not lib.books.has(b):
    print("refused {m} {b}: unknown book")
    return
  mem = lib.members[m]
  if mem.owes > 2:
    print("refused {m} {b}: owes {mem.owes.fmt(2)}")
    return
  if mem.loans.len() >= tier_limit(mem.tier):
    print("refused {m} {b}: limit")
    return
  if b in mem.loans:
    print("refused {m} {b}: already has it")
    return
  hi = hold_index(lib, m, b)
  bk = lib.books[b]
  if hi >= 0:
    lib.holds.remove(hi)
  elif bk.shelf > 0:
    bk.shelf -= 1
    lib.books[b] = bk
  else:
    print("refused {m} {b}: none available")
    return
  due = today + tier_days(mem.tier)
  mem.loans.push(b)
  mem.dues.push(due)
  lib.members[m] = mem
  print("loan {m} {b} due {dstr(due)}")

fn giveback(mut lib: Lib, today: int, m: str, b: str):
  if not lib.members.has(m):
    print("refused {m} {b}: not on loan")
    return
  mem = lib.members[m]
  i = mem.loans.index_of(b)
  if i < 0:
    print("refused {m} {b}: not on loan")
    return
  due = mem.dues[i]
  mem.loans.remove(i)
  mem.dues.remove(i)
  fee = 0.dec()
  if today > due:
    fee = tier_rate(mem.tier) * (today - due)
    if fee > 5: fee = 5.dec()
  mem.owes += fee
  lib.members[m] = mem
  if fee > 0:
    print("returned {m} {b} fee {fee.fmt(2)}")
  else:
    print("returned {m} {b}")
  release(lib, b, today)

fn reserve(mut lib: Lib, m: str, b: str):
  if not lib.members.has(m):
    print("refused {m} {b}: unknown member")
    return
  if not lib.books.has(b):
    print("refused {m} {b}: unknown book")
    return
  mem = lib.members[m]
  bk = lib.books[b]
  if b in mem.loans:
    print("refused {m} {b}: already has it")
    return
  if m in bk.waiting:
    print("refused {m} {b}: already reserved")
    return
  if bk.shelf > 0:
    print("refused {m} {b}: copy available")
    return
  bk.waiting.push(m)
  lib.books[b] = bk
  print("reserved {m} {b} position {bk.waiting.len()}")

fn pay(mut lib: Lib, m: str, amt: dec):
  if not lib.members.has(m):
    print("refused {m}: unknown member")
    return
  mem = lib.members[m]
  mem.owes -= amt
  lib.members[m] = mem
  print("paid {m} owes {mem.owes.fmt(2)}")

fn status(lib: Lib, m: str):
  if not lib.members.has(m):
    print("refused {m}: unknown member")
    return
  mem = lib.members[m]
  ls = if mem.loans.is_empty(): "-" else: mem.loans.join(" ")
  print("{m} {mem.name} owes {mem.owes.fmt(2)} loans: {ls}")
