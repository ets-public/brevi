## main.bv
use "graph.bv"
use "schedule.bv"

fn solve(text: str) -> [str]:
  g = load(text)
  out = unlimited_lines(g)
  out = out + schedule_lines(g)
  return out

match solve(stdin()):
  Ok(out) => print(out.join("\n"))
  Err(m) => print(m)
## graph.bv
type Graph:
  k: int
  names: [str]
  days: [int]
  deps: [[int]]
  dependents: [[int]]
  order: [int]
  st: [int]
  en: [int]
  total: int

fn load(text: str) -> Graph:
  k = 0
  header = false
  names = []
  days = []
  depnames = []
  ln = 0
  for raw in text.lines():
    ln += 1
    line = raw.trim()
    if line.is_empty(): continue
    if not header:
      m = line.re_full("workers (\d+)")
      if m.len() == 0 or m[1].int() < 1: fail("line {ln}: bad line")
      k = m[1].int()
      header = true
    else:
      m = line.re_full("(\w+) (\d+)(?: after (\w+(?:, \w+)*))?")
      if m.len() == 0 or m[2].int() < 1: fail("line {ln}: bad line")
      nm = m[1]
      if names.contains(nm): fail("line {ln}: duplicate {nm}")
      names.push(nm)
      days.push(m[2].int())
      ds = []
      if m.len() > 3 and m[3] != "": ds = m[3].split(", ")
      depnames.push(ds)
  if not header: fail("line 1: bad line")
  n = names.len()
  for i in 0..n:
    for d in depnames[i]:
      if not names.contains(d): fail("unknown {d}")
  deps = []
  for i in 0..n:
    row = []
    for d in depnames[i]: row.push(names.index_of(d))
    deps.push(row)
  dependents = []
  for i in 0..n: dependents.push([])
  for i in 0..n:
    for d in deps[i]:
      dependents[d].push(i)
  indeg = []
  for i in 0..n: indeg.push(deps[i].len())
  q = []
  for i in 0..n:
    if indeg[i] == 0: q.push(i)
  order = []
  head = 0
  while head < q.len():
    u = q[head]
    head += 1
    order.push(u)
    for v in dependents[u]:
      indeg[v] -= 1
      if indeg[v] == 0: q.push(v)
  if order.len() < n: fail("cycle")
  st = [0].repeat(n)
  en = [0].repeat(n)
  for u in order:
    s = 0
    for d in deps[u]: s = max(s, en[d])
    st[u] = s
    en[u] = s + days[u]
  total = 0
  for i in 0..n: total = max(total, en[i])
  return Graph(k: k, names: names, days: days, deps: deps, dependents: dependents, order: order, st: st, en: en, total: total)

fn critical(g: Graph) -> [str]:
  n = g.names.len()
  if n == 0: return []
  crit = [false].repeat(n)
  for u in g.order.rev():
    c = g.en[u] == g.total
    for v in g.dependents[u]:
      if g.st[v] == g.en[u] and crit[v]: c = true
    crit[u] = c
  start = -1
  for i in 0..n:
    if start < 0 and g.st[i] == 0 and crit[i]: start = i
  chain = [start]
  cur = start
  while g.en[cur] != g.total:
    nxt = -1
    for v in g.dependents[cur]:
      if g.st[v] == g.en[cur] and crit[v]:
        if nxt < 0 or v < nxt: nxt = v
    chain.push(nxt)
    cur = nxt
  return [g.names[i] for i in chain]

fn unlimited_lines(g: Graph) -> [str]:
  out = ["unlimited"]
  for i in 0..g.names.len():
    out.push("  {g.names[i]} {g.st[i]}-{g.en[i]}")
  out.push("length {g.total}")
  out.push("critical " + critical(g).join(" > "))
  return out
## schedule.bv
use "graph.bv"

fn tails(g: Graph) -> [int]:
  n = g.names.len()
  tail = [0].repeat(n)
  for u in g.order.rev():
    m = 0
    for v in g.dependents[u]: m = max(m, tail[v])
    tail[u] = g.days[u] + m
  return tail

fn ready(i: int, t: int, deps: [[int]], en: [int]) -> bool:
  for d in deps[i]:
    if en[d] < 0 or en[d] > t: return false
  return true

fn schedule_lines(g: Graph) -> [str]:
  n = g.names.len()
  tail = tails(g)
  st = [-1].repeat(n)
  en = [-1].repeat(n)
  running = []
  t = 0
  started = 0
  while started < n:
    running = [i for i in running if en[i] > t]
    free = g.k - running.len()
    while free > 0:
      best = -1
      for i in 0..n:
        if st[i] < 0 and ready(i, t, g.deps, en):
          if best < 0 or tail[i] > tail[best]: best = i
      if best < 0: break
      st[best] = t
      en[best] = t + g.days[best]
      running.push(best)
      started += 1
      free -= 1
    if started < n:
      nt = en[running[0]]
      for i in running: nt = min(nt, en[i])
      t = nt
  out = ["workers {g.k}"]
  for i in 0..n:
    out.push("  {g.names[i]} {st[i]}-{en[i]}")
  total = 0
  for i in 0..n: total = max(total, en[i])
  out.push("length {total}")
  return out
