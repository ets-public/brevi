window "Tic-tac-toe"
  Label "Draw! New game in 3"
  Canvas 300x300
    line 100 0 100 300 width=2
    line 0 100 300 100 width=2
    line 200 0 200 300 width=2
    line 0 200 300 200 width=2
    text 150 150 fill=blue text=X
    text 50 50 fill=red text=O
    text 250 50 fill=blue text=X
    text 50 250 fill=red text=O
    text 50 150 fill=blue text=X
    text 250 150 fill=red text=O
    text 150 50 fill=blue text=X
    text 150 250 fill=red text=O
    text 250 250 fill=blue text=X
  Frame
    Button "New game"
    Label "X 0 - O 0 - draws 1"
window "Tic-tac-toe"
  Label "O to move"
  Canvas 300x300
    line 100 0 100 300 width=2
    line 0 100 300 100 width=2
    line 200 0 200 300 width=2
    line 0 200 300 200 width=2
  Frame
    Button "New game"
    Label "X 0 - O 0 - draws 1"
window "Tic-tac-toe"
  Label "O to move"
  Canvas 300x300
    line 100 0 100 300 width=2
    line 0 100 300 100 width=2
    line 200 0 200 300 width=2
    line 0 200 300 200 width=2
  Frame
    Button "New game"
    Label "X 0 - O 0 - draws 1"
