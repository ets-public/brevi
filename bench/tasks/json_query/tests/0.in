      {"title": "Emma", "author": "Austen", "price": 4, "tags": ["classic"], "stock": 0},
      {"title": "Neuromancer", "author": "Gibson", "price": 12.25, "tags": ["sf"], "stock": 7},
      {"title": "Odd", "author": null, "price": "n/a", "tags": [], "stock": 1}
