%%
.store.name
.store.books[0].title
.store.books[*].title
.store.books[?price < 10].title
.store.books[-1]
.visits[*] | sum
.visits | count
.store.books[*].tags | length
.store.staff | keys
.store.staff[*]
.store.books[?author == null].title
