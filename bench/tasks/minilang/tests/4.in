func sort(xs)
  n = len(xs)
  i = 1
  while i < n
    j = i
    while j > 0 and xs[j - 1] > xs[j]
      t = xs[j]
      xs[j] = xs[j - 1]
      xs[j - 1] = t
      j = j - 1
    end
    i = i + 1
  end
  return xs
end
data = [5, 3, 9, 1, 5, 0, -2]
sort(data)
print data
words = ["pear", "apple", "fig"]
print sort(words)
print not (1 < 2) or 3 >= 3
