window "Todo"
  Entry "buy milk"
  Button "Add"
  Checkbutton "Hide done" [ ]
  Listbox [[x] buy milk | [ ] walk dog]
  Button "Done"
  Button "Clear done"
  Label "1 open, 1 done"
