window "Todo"
  Entry ""
  Button "Add"
  Checkbutton "Hide done" [ ]
  Listbox []
  Button "Done"
  Button "Clear done"
  Label "0 open, 0 done"
[showwarning] Todo: Nothing to add
[showwarning] Todo: Already on the list
