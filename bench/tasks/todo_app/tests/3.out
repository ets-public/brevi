window "Todo"
  Entry ""
  Button "Add"
  Checkbutton "Hide done" [x]
  Listbox [[ ] two]
  Button "Done"
  Button "Clear done"
  Label "1 open, 1 done"
window "Todo"
  Entry ""
  Button "Add"
  Checkbutton "Hide done" [x]
