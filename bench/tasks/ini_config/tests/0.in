; global
name = demo
root = /srv/${name}

[paths]
logs = ${root}/logs
cache = ${default.root}/cache
tmp = ${missing}/tmp
 [ db ]
host = localhost
url = postgres://${host}:${port}/${name}
port = 5432
port = 6543
# loop
a = ${b}
b = ${a}
c = x${d}
d = ok
---
paths.logs
paths.cache
paths.tmp
db.url
db.a
db.c
db.zz
db.*
nope.*
sections
default.root
